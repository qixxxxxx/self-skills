{
  "schema_version": "2.0",
  "catalog_type": "metric_package",
  "package_id": "atomic.trigger",
  "type": "atomic",
  "category": "trigger",
  "version": "2.3.0",
  "applies_when": {
    "mechanic_id_any": [
      "trigger.symbol-count",
      "trigger.random-event",
      "trigger.state-threshold",
      "feature.free-spin",
      "feature.respin",
      "feature.hold-and-spin",
      "feature.award-draw",
      "feature.bonus-sequence"
    ]
  },
  "metrics": [
    {
      "metric_id": "trigger.rule_consistency.audit",
      "name_zh": "触发规则一致性审计",
      "owner": "atomic.trigger",
      "category": "trigger",
      "display_order": 5,
      "kind": "audit",
      "unit": "status_object",
      "scope_template": "trigger:*×component×state",
      "measurement": "field consistency statuses for eligibility contract, evaluation timing, trigger decision rule, target node reference, position-pattern contract, persistent-state reference, and consumption/reset rule",
      "sample_unit": "trigger_rule_field",
      "condition_on": "每个活动trigger.symbol-count、trigger.random-event或trigger.state-threshold节点；仅适用于特定触发类型的字段必须逐项给出符合状态或有权威证据的不适用状态",
      "normalization": "不归一；全部必需字段和适用的可选规则字段逐项输出符合、不符合、无法证明或有证据不适用，门禁要求全部适用字段为符合",
      "applicability_rule": "每个活动Trigger节点必需，符号计数、独立随机事件和状态阈值触发统一审计各自规则合同。",
      "missing_policy": "合格条件、判定时点、触发决策规则、target_node_id、target_kind，以及适用的位置模式、state_node_id、state_id或触发后消耗/重置规则任一缺证、无法证明或与规格、Runtime、模拟脚本、服务端不一致时阻塞FORMAL。",
      "capability_ids": [
        "trigger.symbol-count",
        "trigger.random-event",
        "trigger.state-threshold"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "trigger.symbol-count",
          "trigger.random-event",
          "trigger.state-threshold"
        ],
        "required_attributes": [
          "evaluation_timing",
          "target_node_id",
          "target_kind"
        ]
      },
      "semantic_variable_id": "trigger.rule_consistency",
      "semantic_group": "trigger_structure",
      "semantic_role": "audit",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "trigger.symbol_count_distribution",
          "trigger.position_pattern_given_count_distribution",
          "trigger.random_event_rate_given_eligibility",
          "trigger.entry_source_distribution",
          "core.feature.natural_trigger_rate"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "本项只核对每个Trigger节点的规则、引用、配置与实现一致性，权重固定为0；触发数量、位置、随机判定成功率、Feature入口来源和自然总触发率仍由各自主指标评价。"
      },
      "display": {
        "description_zh": "逐项核对触发何时有资格、按什么规则判定、何时执行、指向哪个目标节点，以及适用的位置、状态引用和触发后处理规则。",
        "usage_scene_zh": "用于阻止触发率暂时接近但阈值、随机来源、状态绑定、目标引用或重置规则错误的实现进入FORMAL。",
        "target_meaning_zh": "目标对象要求全部适用触发规则字段与权威规格、Runtime、模拟脚本和服务端实现一致。",
        "display_unit": "状态（符合/不符合/无法证明/有证据不适用）",
        "object_labels": {
          "eligibility_contract_status": "合格条件与作用域",
          "evaluation_timing_status": "触发判定时点",
          "trigger_decision_rule_status": "触发决策规则",
          "target_node_reference_status": "目标节点引用",
          "position_pattern_contract_status": "位置模式合同",
          "persistent_state_reference_status": "持久状态节点引用",
          "consumption_or_reset_rule_status": "触发后消耗或重置规则"
        },
        "object_units": {
          "eligibility_contract_status": "状态",
          "evaluation_timing_status": "状态",
          "trigger_decision_rule_status": "状态",
          "target_node_reference_status": "状态",
          "position_pattern_contract_status": "状态",
          "persistent_state_reference_status": "状态",
          "consumption_or_reset_rule_status": "状态"
        }
      },
      "score_weight": 0,
      "audit_profile": {
        "method": "field_consistency_gate",
        "blocking_on_missing": true,
        "blocking_on_mismatch": true,
        "required_result_status": "符合"
      }
    },
    {
      "metric_id": "trigger.symbol_count_distribution",
      "name_zh": "触发符号数量分布",
      "owner": "atomic.trigger",
      "category": "trigger",
      "display_order": 10,
      "kind": "score",
      "unit": "distribution",
      "scope_template": "trigger:*×component×state×board_phase",
      "measurement": "distribution of actual trigger-symbol count on each eligible evaluation board",
      "sample_unit": "trigger_evaluation_board",
      "condition_on": "指定触发规则的每个合格判定盘面，包含未达到阈值的实际数量",
      "normalization": "触发符号数量有序桶概率合计为1",
      "applicability_rule": "存在按符号数量判定的触发规则且触发符号可识别时必需。",
      "missing_policy": "触发符号、计数范围或判定盘面边界缺失时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support", "deterministically_derived_from_primary"],
      "capability_ids": [
        "trigger.symbol-count"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "trigger.symbol-count"
        ],
        "required_attributes": [
          "eligible_symbol_domain",
          "count_scope",
          "threshold_rule"
        ]
      },
      "semantic_variable_id": "trigger.symbol_count_on_evaluation_board",
      "semantic_group": "trigger_configuration",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "conditional_derivation_sources": [
          "board.symbol_count_per_board_distribution"
        ],
        "cross_checks_with": [
          "board.symbol_count_per_board_distribution",
          "settlement.winning_symbol_distribution",
          "settlement.scale_given_symbol_distribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "当触发计数来自同一可见完整盘面、同一symbol_id与count_scope时，数量边际由board.symbol_count_per_board_distribution拥有，本实例只能派生展示或标记不适用；跨步骤、隐藏状态或不同计数范围且不可由盘面数量推出时才独立评分。Count Pay同源中奖符号边际和实际计数尾部同理不得再次计分。"
      },
      "display": {
        "description_zh": "衡量触发判定盘面通常出现几个触发符号。",
        "usage_scene_zh": "用于对齐未触发、差一个触发和正式触发的数量结构。",
        "target_meaning_zh": "每个目标值统计合格判定盘面的实际触发符号数量落入对应档位的比例。",
        "display_unit": "%（触发判定盘面占比）"
      },
      "score_group": "trigger_structure",
      "score_budget_key": "trigger.symbol_count_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "wasserstein_1d",
        "bin_positions_source": "task_contract",
        "distance_normalization": "sealed_support_span",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.02,
            95
          ],
          [
            0.05,
            85
          ],
          [
            0.1,
            70
          ],
          [
            0.2,
            50
          ],
          [
            0.5,
            0
          ]
        ]
      }
    },
    {
      "metric_id": "trigger.position_pattern_given_count_distribution",
      "name_zh": "指定数量下的触发位置组合分布",
      "owner": "atomic.trigger",
      "category": "trigger",
      "display_order": 20,
      "kind": "score",
      "unit": "probability",
      "scope_template": "trigger:*×component×state×board_phase",
      "measurement": "P(sealed position_pattern | trigger_symbol_count), fields count::position_pattern",
      "sample_unit": "trigger_evaluation_board",
      "condition_on": "指定实际触发符号数量的合格判定盘面",
      "normalization": "每个count组分别归一化为1",
      "applicability_rule": "position_pattern_representation不是none，且触发位置可观测并对体验或规则有意义时必需。局部退化的count组移除并按原版活动组权重重新归一；全部位置条件组退化时整项按退化支持标记不适用。",
      "missing_policy": "位置表示类型、坐标域、数量到位置的绑定或模式标签缺失时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": [
        "trigger.symbol-count"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "trigger.symbol-count"
        ],
        "required_attributes": [
          "count_scope",
          "position_pattern_representation",
          "position_pattern_coordinate_domain"
        ],
        "attribute_conditions": [
          {
            "mechanic_id": "trigger.symbol-count",
            "attribute": "position_pattern_representation",
            "operator": "not_equals",
            "value": "none"
          }
        ]
      },
      "semantic_variable_id": "trigger.position_pattern_given_symbol_count",
      "semantic_group": "trigger_configuration",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "board.symbol_partition_count_vector_given_total_distribution",
          "board.max_symbol_stack_length_given_count_distribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [
          "trigger.symbol_count_distribution"
        ],
        "overlap_reason_zh": "以数量为条件，只评价同一数量下的位置结构，不重复触发符号数量边际。若模式保存无损实际坐标，则同符号同作用域的盘面分区向量与最大连续长度可由本指标推出，后两项实例必须标记不适用；模式有损时必须密封不可推出证据。"
      },
      "display": {
        "description_zh": "衡量出现同样数量触发符号时，它们通常落在哪些实际位置组合。",
        "usage_scene_zh": "用于发现触发数量正确但位置长期固定或过度集中的问题。",
        "target_meaning_zh": "每组目标值统计指定触发符号数量条件下，各真实位置组合所占比例。",
        "display_unit": "%（指定数量条件盘面占比）"
      },
      "score_group": "trigger_structure",
      "score_budget_key": "trigger.position_pattern_given_count_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "grouped_total_variation",
        "group_separator": "::",
        "normalization_tolerance": 0.000001,
        "group_weight_source": "task_contract",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.02,
            95
          ],
          [
            0.05,
            85
          ],
          [
            0.1,
            70
          ],
          [
            0.2,
            50
          ],
          [
            0.5,
            0
          ]
        ]
      }
    },
    {
      "metric_id": "trigger.random_event_rate_given_eligibility",
      "name_zh": "随机事件合格机会触发率",
      "owner": "atomic.trigger",
      "category": "trigger",
      "display_order": 30,
      "kind": "score",
      "unit": "ratio",
      "scope_template": "trigger:*×component×state",
      "measurement": "successful_random_trigger_count / eligible_random_trigger_opportunity_count",
      "sample_unit": "eligible_random_trigger_opportunity",
      "condition_on": "满足该trigger.random-event节点eligibility_scope、mode_restrictions和state_condition，并到达evaluation_timing的每次独立随机判定机会；成功与失败均计入，其他触发来源、Feature Buy和测试注入不改变本节点判定结果",
      "normalization": "每个随机触发节点的成功判定次数除以全部合格随机判定机会，结果为[0,1]",
      "applicability_rule": "存在trigger.random-event时必需；每个活动随机触发节点独立实例化。",
      "missing_policy": "合格机会边界、随机判定事件、成功结果、判定时点或触发节点身份任一缺失时阻塞FORMAL；不得用目标Feature总入口数反推本条件触发率。",
      "capability_ids": [
        "trigger.random-event"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "trigger.random-event"
        ],
        "required_attributes": [
          "eligibility_scope",
          "evaluation_timing",
          "random_source",
          "target_node_id",
          "target_kind"
        ]
      },
      "semantic_variable_id": "trigger.random_event_success_rate_given_eligibility",
      "semantic_group": "trigger_configuration",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "trigger.rule_consistency.audit",
          "trigger.entry_source_distribution",
          "core.feature.natural_trigger_rate"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "本指标只评价指定随机触发节点在自身合格机会分母内的成功概率；Core负责目标Feature全部游戏内生入口相对付费入口的总频率，入口来源指标负责已进入Feature后的来源构成，三者分母不同且不得互相替代。"
      },
      "display": {
        "description_zh": "衡量一个独立随机触发规则在真正有资格判定时成功得多频繁。",
        "usage_scene_zh": "用于发现Feature自然总触发率看似正常，但随机触发节点本身的判定概率被其他入口来源掩盖。",
        "target_meaning_zh": "目标值统计该随机触发节点全部合格判定机会中，实际判定成功并执行目标转移的比例。",
        "display_unit": "%（合格随机判定机会占比）"
      },
      "score_group": "trigger_structure",
      "score_budget_key": "trigger.random_event_rate_given_eligibility",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "absolute_error",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.005,
            95
          ],
          [
            0.015,
            85
          ],
          [
            0.04,
            70
          ],
          [
            0.08,
            50
          ],
          [
            0.25,
            0
          ]
        ]
      }
    },
    {
      "metric_id": "trigger.entry_source_distribution",
      "name_zh": "游戏内生Feature入口来源构成",
      "owner": "atomic.trigger",
      "category": "trigger",
      "display_order": 40,
      "kind": "score",
      "unit": "distribution",
      "scope_template": "feature:*×entry_source_domain",
      "measurement": "P(entry_source_id | target_feature_node_id, entry_source_domain=endogenous)",
      "sample_unit": "feature_entry_event",
      "condition_on": "已实际进入指定Feature、且由游戏内部规则自然产生的完整入口事件；Feature Buy、强制测试、测试注入、运营覆盖及其他外生选择全部排除",
      "normalization": "该Feature全部已声明endogenous来源概率合计为1；目标键必须与画像entry_source_semantics中的内生来源ID完全一致",
      "applicability_rule": "同一Feature存在两个及以上游戏内生入口来源时必需评分；只有一个内生来源时按退化支持标记不适用；没有内生来源时不实例化。外生来源数量不参与适用性判断。",
      "missing_policy": "入口来源ID、内生/外生分类、目标Feature绑定、入口事件边界或专属内生事件集任一缺失时阻塞FORMAL；密封评分事件集中出现Feature Buy、强制测试、测试注入、运营覆盖或任何未声明内生来源时直接阻塞。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": [
        "trigger.symbol-count",
        "trigger.random-event",
        "trigger.state-threshold",
        "feature.free-spin",
        "feature.respin",
        "feature.hold-and-spin",
        "feature.award-draw",
        "feature.bonus-sequence"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "feature.free-spin",
          "feature.respin",
          "feature.hold-and-spin",
          "feature.award-draw",
          "feature.bonus-sequence"
        ],
        "required_attributes": [
          "entry_sources",
          "entry_source_semantics"
        ]
      },
      "semantic_variable_id": "trigger.endogenous_feature_entry_source",
      "semantic_group": "trigger_source",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "core.feature.natural_trigger_rate"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "Core负责各Feature游戏内生入口的总频率，本指标只在已进入Feature的内生事件域内评价不同游戏规则来源的条件构成。Feature Buy和测试注入等外生来源不属于随机模型目标，不能进入本评分分布。"
      },
      "display": {
        "description_zh": "衡量一个Feature在游戏自然运行时，分别由Scatter、内部随机事件、状态阈值或其他游戏规则来源进入的比例。",
        "usage_scene_zh": "用于防止自然总触发率正确，但不同游戏内生入口路径的体验比例错误；购买和测试流量不会污染评分。",
        "target_meaning_zh": "每个值统计已进入对应Feature的游戏内生入口事件中，指定内生来源ID所占比例；不统计Feature Buy、强制测试、测试注入或运营覆盖。",
        "display_unit": "%（游戏内生Feature入口事件占比）"
      },
      "score_group": "trigger_structure",
      "score_budget_key": "trigger.entry_source_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "total_variation",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.02,
            95
          ],
          [
            0.05,
            85
          ],
          [
            0.1,
            70
          ],
          [
            0.2,
            50
          ],
          [
            0.5,
            0
          ]
        ]
      }
    }
  ]
}
