{
  "schema_version": "2.0",
  "catalog_type": "metric_package",
  "package_id": "atomic.wild-effect",
  "type": "atomic",
  "category": "modifier",
  "version": "2.5.0",
  "applies_when": {
    "mechanic_id_any": [
      "modifier.wild-substitute",
      "modifier.expanding-wild"
    ]
  },
  "metrics": [
    {
      "metric_id": "wild.assistance_rate_given_opportunity",
      "name_zh": "Wild合格机会实际辅助率",
      "owner": "atomic.wild-effect",
      "category": "modifier",
      "display_order": 10,
      "kind": "score",
      "unit": "ratio",
      "scope_template": "modifier.wild×wild_effect_id×component×state×settlement_type",
      "measurement": "settlement_steps_with_actual_wild_assistance/eligible_wild_settlement_opportunities",
      "sample_unit": "eligible_wild_settlement_opportunity",
      "condition_on": "画像声明Wild可能参与的全部合格结算机会，未中奖或Wild未实际参与的机会也进入分母",
      "normalization": "实际Wild参与并改变结算的机会数除以全部合格Wild结算机会数",
      "applicability_rule": "Wild能够实际替代或影响结算且参与事实可证明时必需；同一wild_effect_id只在node_id=effect_owner_node_id的节点实例化。",
      "missing_policy": "只知道Wild出现而无法证明实际参与时阻塞FORMAL。",
      "capability_ids": [
        "modifier.wild-substitute",
        "modifier.expanding-wild"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "modifier.wild-substitute",
          "modifier.expanding-wild"
        ],
        "required_attributes": ["wild_effect_id", "effect_owner_node_id"]
      },
      "semantic_variable_id": "wild.actual_assistance_rate_given_opportunity",
      "semantic_group": "wild_effect",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "board.symbol_count_per_board_distribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "盘面包负责Wild出现和数量，本指标只评价在画像声明的合格Wild结算机会内，Wild真正改变结算的条件命中率。"
      },
      "display": {
        "description_zh": "衡量全部合格结算机会中，Wild真正替代、扩展或附带倍率并改变结算的频率。",
        "usage_scene_zh": "用于防止Wild看起来常见但很少产生数学作用，或在全部机会中过度介入。",
        "target_meaning_zh": "目标值统计全部合格Wild结算机会中，Wild实际改变结算结果的比例；未中奖和未参与机会都保留在分母。",
        "display_unit": "%（合格Wild结算机会占比）"
      },
      "score_group": "modifier",
      "score_budget_key": "wild.assistance_rate_given_opportunity",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "absolute_error",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.005,
            95
          ],
          [
            0.015,
            85
          ],
          [
            0.04,
            70
          ],
          [
            0.08,
            50
          ],
          [
            0.25,
            0
          ]
        ]
      }
    },
    {
      "metric_id": "wild.assisting_cell_count_given_assistance_distribution",
      "name_zh": "Wild实际辅助格数分布",
      "owner": "atomic.wild-effect",
      "category": "modifier",
      "display_order": 20,
      "kind": "score",
      "unit": "probability",
      "scope_template": "modifier.wild×wild_effect_id×component×state×settlement_type",
      "measurement": "P(exact distinct assisting_wild_resolved_cell_count | actual_assistance_type), fields assistance_type::assisting_cell_count",
      "sample_unit": "wild_assisted_settlement_step",
      "condition_on": "已证明Wild实际改变同一步骤结算；按assisting_cell_identity_rule对实际参与的来源Wild格或扩展后有效Wild格去重，同一格参与多个派奖块只计1，未改变结算的可见Wild不计",
      "normalization": "每个assistance_type活动组内从1格到可达最大实际辅助格数的完整精确整数概率合计为1；组权重由候选出现前密封的原版辅助类型暴露确定。只有单一可达正整数的组移除并重新归一，全部组退化时整项不适用",
      "applicability_rule": "Wild结算事实可稳定识别实际参与的来源格或扩展后有效格，且至少一个原版正概率辅助类型存在两个及以上结构可达参与格数时必需；同一wild_effect_id只在effect_owner_node_id实例化。",
      "missing_policy": "assisting_cell_identity_rule、同一步骤边界、实际辅助类型、参与格身份、去重规则、精确整数支持或原版组权重任一缺失时阻塞FORMAL；不得用盘面Wild总数、理论可替代格数、中奖Ways数或增量派奖大小反推参与格数。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": [
        "modifier.wild-substitute",
        "modifier.expanding-wild"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "modifier.wild-substitute",
          "modifier.expanding-wild"
        ],
        "required_attributes": [
          "wild_effect_id",
          "effect_owner_node_id",
          "assistance_resolution_rule",
          "assisting_cell_identity_rule"
        ]
      },
      "semantic_variable_id": "wild.assisting_cell_count_given_actual_assistance",
      "semantic_group": "wild_effect",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "board.symbol_count_per_board_distribution",
          "wild.assistance_rate_given_opportunity",
          "wild.expanded_cell_count_distribution",
          "wild.incremental_return_given_assistance_distribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [
          "wild.assistance_rate_given_opportunity"
        ],
        "overlap_reason_zh": "盘面指标拥有可见Wild数量，辅助率拥有是否发生实际数学作用的机会边际，扩展格数拥有扩展机会新增覆盖量，增量回报拥有经济强度；本指标只评价辅助已经发生时真正参与结算的去重Wild格数量。"
      },
      "display": {
        "description_zh": "衡量Wild真正帮助中奖时，实际有多少个去重Wild格参与了该步骤结算。",
        "usage_scene_zh": "用于区分同样的Wild辅助频率下，通常只有单格Wild介入还是经常由多个Wild格共同参与；不会把盘面上未起作用的Wild计入。",
        "target_meaning_zh": "每组目标值统计指定实际辅助类型条件下，参与结算的去重Wild格数恰好等于对应整数的步骤比例。",
        "display_unit": "%（指定Wild辅助类型事件占比）"
      },
      "score_group": "modifier",
      "score_budget_key": "wild.assisting_cell_count_given_assistance_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 0.5,
      "score_profile": {
        "method": "grouped_wasserstein_1d",
        "bin_positions_source": "task_contract",
        "axis_semantics": "natural_linear",
        "position_transform": "identity",
        "distance_normalization": "sealed_support_span",
        "group_separator": "::",
        "normalization_tolerance": 0.000001,
        "group_weight_source": "task_contract",
        "anchors": [
          [0, 100],
          [0.02, 95],
          [0.05, 85],
          [0.1, 70],
          [0.2, 50],
          [0.5, 0]
        ]
      }
    },
    {
      "metric_id": "wild.expanded_cell_count_distribution",
      "name_zh": "Wild扩展格数分布",
      "owner": "atomic.wild-effect",
      "category": "modifier",
      "display_order": 30,
      "kind": "score",
      "unit": "distribution",
      "scope_template": "modifier.expanding-wild×wild_effect_id×node_id×component×state",
      "measurement": "distribution of newly covered valid-cell count per eligible wild-expansion opportunity, including 0",
      "sample_unit": "eligible_wild_expansion_opportunity",
      "condition_on": "画像激活规则定义的每个合格扩展机会；未触发扩展或没有新增覆盖格时记0",
      "normalization": "从0格到可达最大新增覆盖格数的完整有序概率合计为1",
      "applicability_rule": "存在扩展Wild且扩展前后格身份可观测时必需。",
      "missing_policy": "扩展事件、原始Wild格或新增覆盖格缺失时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": [
        "modifier.expanding-wild"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "modifier.expanding-wild"
        ],
        "required_attributes": [
          "source_wild_domain",
          "expansion_geometry",
          "wild_effect_id",
          "effect_owner_node_id"
        ]
      },
      "semantic_variable_id": "wild.newly_expanded_cell_count",
      "semantic_group": "wild_effect",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "每个扩展节点独立拥有新增格数，不因共享经济效果Owner而合并。"
      },
      "display": {
        "description_zh": "衡量每个合格Wild扩展机会实际新增覆盖0格、1格或更多格的概率。",
        "usage_scene_zh": "用于对齐单格扩展、整轴扩展和大范围扩展的频率。",
        "target_meaning_zh": "每个值统计全部合格Wild扩展机会的新增覆盖格数落入对应档位的比例，0格机会不得丢弃。",
        "display_unit": "%（合格Wild扩展机会占比）"
      },
      "score_group": "modifier",
      "score_budget_key": "wild.expanded_cell_count_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "wasserstein_1d",
        "bin_positions_source": "task_contract",
        "distance_normalization": "sealed_support_span",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.02,
            95
          ],
          [
            0.05,
            85
          ],
          [
            0.1,
            70
          ],
          [
            0.2,
            50
          ],
          [
            0.5,
            0
          ]
        ]
      }
    },
    {
      "metric_id": "wild.incremental_return_given_assistance_distribution",
      "name_zh": "Wild实际辅助后的增量回报分布",
      "owner": "atomic.wild-effect",
      "category": "modifier",
      "display_order": 40,
      "kind": "score",
      "unit": "probability",
      "scope_template": "modifier.wild×wild_effect_id×component×state×settlement_type",
      "measurement": "P((payout_with_wild_effect - payout_without_wild_effect)_bucket | actual_assistance_type), fields assistance_type::incremental_return_bucket",
      "sample_unit": "wild_assisted_settlement_step",
      "condition_on": "已证明Wild实际参与同一步骤结算；去除Wild作用后的派奖必须用同一盘面和同一结算规则确定性复算，不得重新抽RNG",
      "normalization": "每个assistance_type组分别归一化为1；必须保留精确0x增量桶",
      "applicability_rule": "Wild能够实际替代、扩展或附带倍率并影响结算，且同一结算事实可复算Wild增量派奖时必需；同一wild_effect_id只在effect_owner_node_id实例化。局部退化的assistance_type组移除并按原版活动组权重重新归一；全部辅助类型组退化时整项按退化支持标记不适用。",
      "missing_policy": "Wild作用事实、同盘确定性复算规则、增量回报桶或实际辅助类型缺失时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": ["modifier.wild-substitute", "modifier.expanding-wild"],
      "profile_match": {
        "mechanic_id_any": ["modifier.wild-substitute", "modifier.expanding-wild"],
        "required_attributes": ["assistance_resolution_rule", "incremental_payout_rule", "wild_effect_scope", "wild_effect_id", "effect_owner_node_id"]
      },
      "semantic_variable_id": "wild.incremental_return_given_assistance",
      "semantic_group": "wild_effect",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": ["settlement.step_return_distribution", "core.rtp.component_contribution"],
        "marginal_of": [],
        "conditional_on_metric": ["wild.assistance_rate_given_opportunity"],
        "overlap_reason_zh": "Wild机会内实际辅助率负责条件命中频率，本指标只评价实际辅助发生后的增量经济作用；普通步骤总回报仍由结算包拥有。"
      },
      "display": {
        "description_zh": "衡量Wild真正参与中奖时，通常额外增加了多少派奖。",
        "usage_scene_zh": "用于发现Wild参与频率接近，但实际经济作用过弱或过强的问题。",
        "target_meaning_zh": "每组目标值统计指定Wild辅助类型条件下，使用同一盘面确定性去除Wild作用后得到的增量派奖落入各倍率档位的比例。",
        "display_unit": "%（指定Wild辅助类型事件占比）"
      },
      "score_group": "modifier",
      "score_budget_key": "wild.incremental_return_given_assistance_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "grouped_wasserstein_1d",
        "bin_positions_source": "task_contract",
        "axis_semantics": "nonnegative_multiplicative",
        "position_transform": "log10_1p",
        "distance_normalization": "fixed_transform_unit",
        "distance_scale": 1,
        "distance_unit": "log10_decade",
        "group_separator": "::",
        "normalization_tolerance": 0.000001,
        "group_weight_source": "task_contract",
        "anchors": [[0, 100], [0.02, 95], [0.05, 85], [0.1, 70], [0.2, 50], [0.5, 0]]
      }
    },
    {
      "metric_id": "wild.rtp_contribution.audit",
      "name_zh": "Wild增量RTP贡献审计",
      "owner": "atomic.wild-effect",
      "category": "modifier",
      "display_order": 50,
      "kind": "audit",
      "unit": "ratio",
      "scope_template": "modifier.wild×wild_effect_id×component×state×settlement_type",
      "measurement": "sum(payout_with_wild_effect - payout_without_wild_effect) / sum(actual_economic_wager) over the sealed paid-entry ledger",
      "sample_unit": "eligible_paid_entry",
      "condition_on": "全部合格付费入口及其归属的全部Wild结算机会；没有Wild机会或没有实际辅助的入口增量为0，去除Wild作用必须使用同一盘面、同一规则且不得重新抽RNG",
      "normalization": "同一密封事件账本内全部Wild反事实增量派奖之和除以实际经济投注额之和，机会暴露次数自然包含在逐入口账本中，不由机会内命中率外推",
      "applicability_rule": "Wild作用可在全部合格付费入口上使用同盘反事实确定性重算，且实际经济投注额可核对时必需；同一wild_effect_id只在effect_owner_node_id实例化。",
      "missing_policy": "付费入口归属、实际经济投注额、完整Wild机会账本、同盘反事实或增量派奖任一缺失时阻塞FORMAL；不得由机会内命中率乘条件均值近似。",
      "capability_ids": ["modifier.wild-substitute", "modifier.expanding-wild"],
      "profile_match": {
        "mechanic_id_any": ["modifier.wild-substitute", "modifier.expanding-wild"],
        "required_attributes": ["assistance_resolution_rule", "incremental_payout_rule", "wild_effect_scope", "wild_effect_id", "effect_owner_node_id"]
      },
      "semantic_variable_id": "wild.incremental_rtp_contribution",
      "semantic_group": "wild_effect",
      "semantic_role": "audit",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": ["wild.assistance_rate_given_opportunity", "wild.incremental_return_given_assistance_distribution", "core.rtp.component_contribution"],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "本项从同一逐入口账本直接重算投注口径RTP，补足机会暴露到实际投注的换算；两项Wild主指标仍各自拥有机会内命中率和辅助后增量形状，本审计权重为0。"
      },
      "display": {
        "description_zh": "汇总展示Wild规则为总体RTP贡献了多少增量派奖。",
        "usage_scene_zh": "用于和组件RTP交叉核对，不作为新的评分预算。",
        "target_meaning_zh": "目标值统计同一密封付费入口账本中，全部Wild反事实增量派奖总额占实际经济投注总额的比例；零机会和零辅助入口也在投注分母内。",
        "display_unit": "%（投注额占比）"
      },
      "score_weight": 0,
      "audit_profile": {"method": "sealed_event_recomputation", "blocking_on_missing": true}
    }
  ]
}
