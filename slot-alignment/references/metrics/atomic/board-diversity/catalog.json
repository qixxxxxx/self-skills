      },
      "display": {
        "description_zh": "衡量同一种符号在一个盘面里通常出现几个。",
        "usage_scene_zh": "用于发现符号数量过度固定或经常整片出现。",
        "target_meaning_zh": "每个目标值统计指定符号在单盘恰好出现对应整数个的盘面比例。",
        "display_unit": "%（指定符号条件盘面占比）"
      },
