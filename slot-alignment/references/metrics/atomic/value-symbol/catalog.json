    {
      "metric_id": "value_symbol.realization_status_given_assignment_distribution",
      "name_zh": "指定赋值下的兑现状态分布",
      "owner": "atomic.value-symbol",
      "category": "award",
      "display_order": 20,
      "kind": "score",
      "unit": "probability",
      "scope_template": "award.value-symbol×component×state×assignment_context",
      "measurement": "P(realized_flag | assigned_value_bucket), fields assigned_value_bucket::realized_flag",
      "sample_unit": "value_symbol_assignment_event",
      "condition_on": "指定实际赋值奖值档位的全部价值符号赋值事件；realized_flag固定为已兑现或未兑现",
      "normalization": "每个assigned_value_bucket组内已兑现与未兑现概率合计为1；条件组权重由任务合同密封",
      "applicability_rule": "价值符号赋值后可能因收集、锁定、变形、终局或其他明确条件决定是否兑现，且最终状态可追踪时必需。每个赋值档只剩一个结构可达兑现状态时移除该退化组，并按原版活动组权重重新归一；全部赋值档均退化时整项不适用。",
      "missing_policy": "任一赋值事件到最终兑现状态的绑定缺失时阻塞FORMAL；不得只保留已兑现样本。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": [
        "award.value-symbol",
        "award.jackpot",
        "feature.hold-and-spin",
        "modifier.collect",
        "modifier.symbol-transform"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "award.value-symbol"
        ],
        "required_attributes": [
