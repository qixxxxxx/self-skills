        "marginal_of": [],
        "conditional_on_metric": [
          "value_symbol.assignment_value_distribution"
        ],
        "overlap_reason_zh": "与赋值奖值边际组成“奖值边际＋给定奖值后的兑现状态”条件分解，完整表达联合语义但不重复评分赋值边际。"
      },
      "display": {
        "description_zh": "衡量被赋予某个奖值后，该价值符号最终真正计奖还是未兑现。",
        "usage_scene_zh": "用于发现总体奖值结构正常，但高值更容易丢失、低值更容易兑现等关系偏差。",
        "target_meaning_zh": "每组目标值统计指定实际赋值档位条件下，已兑现与未兑现事件各占多少。",
        "display_unit": "%（指定赋值档位条件事件占比）"
      },
      "score_group": "award",
      "score_budget_key": "value_symbol.realization_status_given_assignment_distribution",
      "scope_aggregation": "weighted_mean",
