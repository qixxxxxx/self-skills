          "assignment_timing",
          "realization_condition"
        ]
      },
      "semantic_variable_id": "value_symbol.realization_status_given_assigned_value",
      "semantic_group": "value_assignment",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
