  "metrics": [
    {
      "metric_id": "value_symbol.assignment_value_distribution",
      "name_zh": "价值符号赋值奖值分布",
      "owner": "atomic.value-symbol",
      "category": "award",
      "display_order": 10,
      "kind": "score",
      "unit": "probability",
      "scope_template": "award.value-symbol×component×state×assignment_context",
      "measurement": "P(assigned_value_bucket | value_symbol_assignment_event)",
      "sample_unit": "value_symbol_assignment_event",
      "condition_on": "全部价值符号赋值事件；按实际金额、投注倍数或可证明的等价奖值位置密封有序支持集，不按最终是否兑现筛样本",
      "normalization": "全部实际赋值奖值档位概率合计为1；有序桶位置在候选出现前密封，距离固定按log10(1+x)后的1个十倍数量级计量",
      "applicability_rule": "符号携带可按金额、投注倍数或权威等价价值排序的动态奖值时必需；单一可达奖值按退化支持不适用。仅当value_symbol_effective_multiplier_binding完整证明赋值实例与倍率应用事件同域一一对应、全部恰好兑现、无额外倍率源、值映射双向确定，且primary_owner_metric_id选择倍率指标时，才由倍率值分布派生。",
      "missing_policy": "任一赋值事件、原始赋值值或可证明的有序奖值位置缺失时阻塞FORMAL；不能排序的纯类别奖项不得猜测距离。声称由倍率派生时，绑定、逐事件配对、完整支持映射或证据hash任一缺失即阻塞。",
      "inapplicability_reason_codes": ["degenerate_reachable_support", "deterministically_derived_from_primary"],
      "capability_ids": [
        "award.value-symbol",
        "award.jackpot",
        "feature.hold-and-spin",
        "modifier.collect",
        "modifier.symbol-transform"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "award.value-symbol"
        ],
        "required_attributes": [
          "value_domain",
          "assignment_timing"
        ]
      },
      "semantic_variable_id": "value_symbol.assigned_value",
      "semantic_group": "value_assignment",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "conditional_derivation_sources": ["multiplier.effective_value_distribution"],
        "cross_checks_with": ["multiplier.effective_value_distribution"],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "本指标只负责赋值奖值边际；最终是否兑现由条件兑现指标负责，不保存原始联合分布重复计分。与生效倍率默认不同域，仅在完整一一Owner绑定指定倍率为主Owner时派生。"
      },
      "conditional_derivation_requirements": [
        {
          "source_metric_id": "multiplier.effective_value_distribution",
          "profile_binding_attribute": "value_symbol_effective_multiplier_binding",
          "required_binding_fields": ["value_symbol_node_id", "multiplier_node_id", "shared_semantic_event_set_id", "value_symbol_instance_id_field", "multiplier_application_event_id_field", "event_pairing_bijective", "all_assignments_realized_exactly_once", "same_event_universe", "no_additional_multiplier_source", "value_to_effective_multiplier_mapping", "mapping_total_and_bijective", "primary_owner_metric_id", "rule_evidence_sha256"],
          "required_primary_owner_metric_id": "multiplier.effective_value_distribution"
        }
      ],
      "display": {
        "description_zh": "衡量价值符号生成时通常被赋予多大的实际奖值。",
        "usage_scene_zh": "用于识别小奖值过多、高奖值过少或奖值跨度失真；相邻奖值偏差应小于跨越多个档位的偏差。",
        "target_meaning_zh": "每个目标值统计对应实际奖值档位占全部赋值事件的比例，无论后续是否兑现都必须计入。",
        "display_unit": "%（价值符号赋值事件占比）"
      },
      "score_group": "award",
      "score_budget_key": "value_symbol.assignment_value_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "wasserstein_1d",
        "bin_positions_source": "task_contract",
        "axis_semantics": "nonnegative_multiplicative",
        "position_transform": "log10_1p",
        "distance_normalization": "fixed_transform_unit",
        "distance_scale": 1,
        "distance_unit": "log10_decade",
        "anchors": [
