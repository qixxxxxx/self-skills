{
  "schema_version": "2.0",
  "catalog_type": "metric_package",
  "package_id": "interaction.wild-multiplier",
  "type": "interaction",
  "category": "interaction",
  "version": "2.1.0",
  "applies_when": {
    "mechanic_id_any": [
      "modifier.wild-substitute",
      "modifier.expanding-wild"
    ],
    "required_attributes": [
      "linked_multiplier_id",
      "wild_multiplier_dependency_evidence",
      "linked_symbol_domain"
    ],
    "attribute_conditions": [
      {
        "mechanic_id": "modifier.win-multiplier",
        "attribute": "linked_symbol_domain",
        "operator": "exists"
      }
    ]
  },
  "metrics": [
    {
      "metric_id": "wild_multiplier.dependence_residual",
      "name_zh": "Wild辅助状态与倍率依赖残差",
      "owner": "interaction.wild-multiplier",
      "category": "interaction",
      "display_order": 10,
      "kind": "score",
      "unit": "probability_difference",
      "scope_template": "modifier.wild×modifier.win-multiplier×component×state×settlement_type",
      "measurement": "residual(wild_assistance_state,multiplier_state) = P(multiplier_state | wild_assistance_state, eligible_joint_settlement_step) - P(multiplier_state | eligible_joint_settlement_step)",
      "sample_unit": "eligible_joint_wild_multiplier_settlement_step",
      "condition_on": "Wild与其linked_multiplier_id指向的倍率在同一步联合可观测；Wild状态域必须包含none及全部实际辅助或驱动状态，倍率状态域必须包含not_occurred、not_applied、1x及全部实际有效倍率值",
      "normalization": "字段使用wild_assistance_state::multiplier_state；每个Wild状态组的倍率残差向量合计为0，组内先平均字段绝对误差，再按group_weights[Wild辅助状态]=原版合格Wild×倍率联合结算步骤中该状态占比汇总；状态域和字段顺序同样预先密封，残差不是概率分布",
      "applicability_rule": "Wild节点通过linked_multiplier_id绑定活动倍率节点，存在结构化wild_multiplier_dependency_evidence并共享语义事件集，且Wild状态与倍率状态均有两个及以上可达值时加载；任一状态域退化时标记不适用。",
      "missing_policy": "倍率节点引用、专属依赖证据、共享事件集、联合步骤、完整Wild状态域、完整倍率状态域或原版字段权重任一缺失时阻塞该Interaction实例；禁止只保留实际辅助或高倍率正样本。",
      "inapplicability_reason_codes": [
        "degenerate_reachable_support"
      ],
      "capability_ids": [
        "modifier.wild-substitute",
        "modifier.expanding-wild",
        "modifier.win-multiplier"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "modifier.wild-substitute",
          "modifier.expanding-wild"
        ],
        "required_attributes": [
          "linked_multiplier_id",
          "wild_multiplier_dependency_evidence",
          "linked_symbol_domain"
        ],
        "attribute_conditions": [
          {
            "mechanic_id": "modifier.win-multiplier",
            "attribute": "linked_symbol_domain",
            "operator": "exists"
          }
        ]
      },
      "semantic_variable_id": "interaction.wild_assistance_multiplier_dependence_residual",
      "semantic_group": "interaction_dependency",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "wild.assistance_rate_given_opportunity",
          "multiplier.occurrence_rate",
          "multiplier.application_rate_given_occurrence",
          "multiplier.effective_value_distribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "Atomic Wild与倍率指标分别拥有机会内辅助率以及倍率出现、应用、有效值边际；本指标从给定Wild状态的倍率概率中减去倍率总体边际，只评价不能由两边边际推出的纯依赖残差。"
      },
      "display": {
        "description_zh": "衡量Wild没有辅助、以不同方式辅助或由不同Wild状态驱动时，倍率状态是否按原版规律变化。",
        "usage_scene_zh": "用于Multiplier Wild、Wild数量决定倍率或扩展Wild联动倍率等主流组合；普通Wild与倍率只是同时存在时不加载。",
        "target_meaning_zh": "每个目标值表示某个Wild辅助状态下，一种倍率状态的出现概率比全部联合合格步骤中的该倍率总体概率高或低多少。",
        "display_unit": "百分点差（概率差）"
      },
      "score_group": "interaction",
      "score_budget_key": "wild_multiplier.dependence_residual",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "grouped_mean_absolute_error",
        "group_separator": "::",
        "group_weight_source": "task_contract",
        "normalization_tolerance": 0.000001,
        "anchors": [
          [0, 100],
          [0.005, 95],
          [0.015, 85],
          [0.04, 70],
          [0.08, 50],
          [0.25, 0]
        ]
      }
    }
  ]
}
