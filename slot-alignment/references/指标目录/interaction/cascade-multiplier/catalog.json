{
  "schema_version": "2.0",
  "catalog_type": "metric_package",
  "package_id": "interaction.cascade-multiplier",
  "type": "interaction",
  "category": "interaction",
  "version": "2.2.0",
  "applies_when": {
    "mechanic_id_all": [
      "evolution.cascade",
      "modifier.win-multiplier"
    ],
    "required_attributes": [
      "same_depth_multiplier_randomness"
    ]
  },
  "metrics": [
    {
      "metric_id": "cascade_multiplier.dependence_by_depth",
      "name_zh": "Cascade层级与倍率依赖残差",
      "owner": "interaction.cascade-multiplier",
      "category": "interaction",
      "display_order": 10,
      "kind": "score",
      "unit": "probability_difference",
      "scope_template": "evolution.cascade×modifier.win-multiplier×component×state",
      "measurement": "residual(depth,multiplier_bucket)=P(multiplier_bucket|depth)-P(multiplier_bucket)",
      "sample_unit": "eligible_cascade_settlement_step",
      "condition_on": "层级和倍率状态（含未应用状态）均可观测的合格Cascade结算步骤",
      "normalization": "字段使用depth::multiplier_state；每个depth组的残差向量合计为0，组内先平均字段绝对误差，再按group_weights[depth]=原版合格Cascade结算步骤中该层级占比汇总，不把残差当概率分布",
      "applicability_rule": "同时存在Cascade和倍率时保留实例。same_depth_multiplier_randomness=true且有dependency_evidence时评分；false且depth到完整倍率状态唯一时，残差由深度边际与映射派生。",
      "missing_policy": "same_depth_multiplier_randomness、层级绑定或边际分母缺失时阻塞；true时还必须提供dependency_evidence，false时必须提供完整唯一映射。",
      "inapplicability_reason_codes": ["deterministically_derived_from_primary"],
      "capability_ids": [
        "evolution.cascade",
        "modifier.win-multiplier"
      ],
      "profile_match": {
        "mechanic_id_all": [
          "evolution.cascade",
          "modifier.win-multiplier"
        ],
        "required_attributes": [
          "same_depth_multiplier_randomness"
        ]
      },
      "semantic_variable_id": "interaction.cascade_multiplier_dependence_residual",
      "semantic_group": "interaction_dependency",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "conditional_derivation_sources": [
          "cascade.depth_distribution"
        ],
        "cross_checks_with": [
          "cascade.depth_distribution",
          "multiplier.occurrence_rate",
          "multiplier.effective_value_distribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "Atomic指标负责深度与倍率边际；本指标只在同深度仍随机时评价纯依赖残差。depth确定倍率时残差派生。"
      },
      "display": {
        "description_zh": "衡量越深的Cascade是否真的更容易伴随某些倍率，而不重复计算各自总体频率。",
        "usage_scene_zh": "只在原版证据证明层级与倍率存在重要关联时使用。",
        "target_meaning_zh": "每个目标值是指定层级下某倍率状态概率减去该倍率总体概率的差值。",
        "display_unit": "百分点差（概率差）"
      },
      "score_group": "interaction",
      "score_budget_key": "cascade_multiplier.dependence_by_depth",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "grouped_mean_absolute_error",
        "group_separator": "::",
        "group_weight_source": "task_contract",
        "normalization_tolerance": 0.000001,
        "anchors": [
          [
            0,
            100
          ],
          [
            0.005,
            95
          ],
          [
            0.015,
            85
          ],
          [
            0.04,
            70
          ],
          [
            0.08,
            50
          ],
          [
            0.25,
            0
          ]
        ]
      }
    }
  ]
}
