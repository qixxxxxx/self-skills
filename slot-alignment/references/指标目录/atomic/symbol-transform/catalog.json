      },
      "semantic_variable_id": "transform.changed_position_pattern_given_count",
      "semantic_group": "transform_process",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": ["board.symbol_partition_count_vector_given_total_distribution"],
