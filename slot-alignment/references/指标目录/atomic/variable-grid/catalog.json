  "metrics": [
    {
      "metric_id": "variable_grid.reel_height_layout_distribution",
      "name_zh": "完整轴高布局模式分布",
      "owner": "atomic.variable-grid",
      "category": "board",
      "display_order": 10,
      "kind": "score",
      "unit": "distribution",
      "scope_template": "component×state×board_phase",
      "measurement": "P(complete ordered reel-height vector or sealed equivalent layout_id | eligible board)",
      "sample_unit": "board_snapshot",
      "condition_on": "可变网格的合格完整盘面；布局身份是按轴顺序排列的完整高度向量或与其一一对应的密封layout_id",
      "normalization": "全部有限可枚举布局模式概率合计为1",
      "applicability_rule": "轴高会变化且完整轴高向量属于有限可枚举支持集时必需；无法可靠密封布局集合时阻塞并提出指标扩展，不改用完整可见盘面签名。",
      "missing_policy": "任一轴高度、轴顺序或完整布局支持集缺失时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": [
        "board.variable-grid"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "board.variable-grid"
        ],
        "required_attributes": [
          "reels",
          "height_domain_by_reel",
          "reel_height_variation"
        ],
        "attribute_conditions": [
          {
            "mechanic_id": "board.variable-grid",
            "attribute": "reel_height_variation",
            "operator": "truthy"
          }
        ]
      },
      "semantic_variable_id": "variable_grid.complete_height_layout",
      "semantic_group": "variable_grid_geometry",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "cascade.effective_capacity_distribution_by_depth"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "无；本指标为该语义变量的唯一Owner。"
      },
      "display": {
        "description_zh": "衡量整组轴高按实际轴顺序组合成哪些完整布局模式。",
        "usage_scene_zh": "用于捕捉逐轴边际看似正常但轴与轴之间组合关系失真的问题。",
        "target_meaning_zh": "每个值统计一个真实完整轴高向量或等价布局ID占全部合格可变网格盘面的比例。",
        "display_unit": "%（可变网格盘面占比）"
      },
      "score_group": "variable_grid",
      "score_budget_key": "variable_grid.reel_height_layout_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "total_variation",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.02,
            95
          ],
          [
            0.05,
            85
          ],
          [
            0.1,
            70
          ],
          [
            0.2,
            50
          ],
          [
            0.5,
            0
          ]
        ]
      }
    },
    {
      "metric_id": "variable_grid.valid_cell_layout_distribution",
      "name_zh": "有效格布局模式分布",
      "owner": "atomic.variable-grid",
      "category": "board",
      "display_order": 20,
      "kind": "score",
      "unit": "distribution",
      "scope_template": "component×state×board_phase",
      "measurement": "P(sealed complete valid-cell coordinate layout or layout_id | eligible board)",
      "sample_unit": "board_snapshot",
      "condition_on": "轴高不变化但实际有效格坐标集合或参与结算几何布局会变化的每个合格完整盘面；布局身份使用完整坐标表示或与其一一对应的密封layout_id",
      "normalization": "全部有限可枚举有效格布局模式概率合计为1",
      "applicability_rule": "reel_height_variation=false，且完整有效格布局存在两个及以上结构可达模式并属于有限可枚举支持集时必需；轴高实际变化时由完整轴高布局指标承接。",
      "missing_policy": "有效格坐标域、完整布局表示、layout_id到坐标的无损映射或结构可达支持集任一缺失时阻塞FORMAL；布局集合无法可靠有限枚举时提出指标扩展，不能改用容量数字替代几何布局。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": [
        "board.variable-grid"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "board.variable-grid"
        ],
        "required_attributes": [
          "reel_height_variation",
          "valid_cell_layout_domain",
          "valid_cell_layout_representation"
        ],
        "attribute_conditions": [
          {
            "mechanic_id": "board.variable-grid",
            "attribute": "reel_height_variation",
            "operator": "falsy"
          }
        ]
      },
      "semantic_variable_id": "variable_grid.complete_valid_cell_layout",
      "semantic_group": "variable_grid_geometry",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "仅承接轴高固定但实际有效格坐标或几何布局变化的实例；轴高实际变化的实例由variable_grid.reel_height_layout_distribution评分，固定布局下的动态Ways容量由atomic.effective-ways-capacity承接。"
      },
      "display": {
        "description_zh": "衡量轴高固定时，实际参与结算的完整有效格坐标布局通常是哪一种。",
        "usage_scene_zh": "用于发现非矩形、开孔、遮罩或模板型盘面的几何布局比例失真，同时避免用容量数字代替真实布局。",
        "target_meaning_zh": "每个值统计一个真实完整有效格坐标布局或等价layout_id占全部合格盘面的比例。",
        "display_unit": "%（非轴高可变布局盘面占比）"
      },
      "score_group": "variable_grid",
      "score_budget_key": "variable_grid.valid_cell_layout_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "total_variation",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.02,
            95
          ],
          [
            0.05,
