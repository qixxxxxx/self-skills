{
  "schema_version": "2.0",
  "catalog_type": "metric_package",
  "package_id": "atomic.award-draw",
  "type": "atomic",
  "category": "feature",
  "version": "2.2.0",
  "applies_when": {
    "mechanic_id": "feature.award-draw"
  },
  "metrics": [
    {
      "metric_id": "award_draw.outcome_distribution_given_draw_state",
      "name_zh": "给定抽取状态的奖励结果分布",
      "owner": "atomic.award-draw",
      "category": "feature",
      "display_order": 10,
      "kind": "score",
      "unit": "probability",
      "scope_template": "feature.award-draw×stage×entry_source",
      "measurement": "P(outcome_id | draw_index, sealed_prior_draw_state_id), fields draw_index|prior_state_id::outcome_id",
      "sample_unit": "eligible_award_draw_event",
      "condition_on": "每次实际抽取前的抽取序号与最小充分前序状态；状态必须按draw_state_definition包含会改变本次概率的剩余奖池、放回结果、保证奖进度或前序结果摘要，首次抽取使用密封初始状态",
      "normalization": "每个draw_index|prior_state_id组内全部可达outcome_id概率合计为1；条件组权重由任务合同密封，退化组不进入评分",
      "applicability_rule": "存在Pick、Wheel或其他离散奖励抽取时必需。若最小充分状态、确定转移/停止/聚合/终局投影及无链外随机、无未承接玩家决策的七项证明满足，本条件链为Feature路径和主回报的唯一随机Owner，不限单抽、有放回或无放回。局部退化的draw_index|prior_state_id组移除并按原版活动组权重重新归一；全部抽取状态组退化时整项按退化支持标记不适用。",
      "missing_policy": "抽取边界、序号、前序状态、放回/剩余奖池、保证奖进度或实际结果任一无法按同一事件链绑定时阻塞FORMAL；不得用只按抽取序号的边际替代条件链。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": [
        "feature.award-draw"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "feature.award-draw"
        ],
        "required_attributes": [
          "outcome_pool",
          "draw_count_rule",
          "replacement_rule",
          "draw_dependency_rule",
          "guarantee_rule",
          "draw_state_definition",
          "stage_graph",
          "path_signature_definition",
          "outcome_return_equivalence"
        ]
      },
      "semantic_variable_id": "award_draw.outcome_given_draw_state",
      "semantic_group": "award_selection",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "feature_cycle.stage_path_distribution",
          "feature_cycle.return_distribution_by_stage_path"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "本指标以抽取序号和最小充分状态承接完整随机链。七项证明满足时Feature路径/回报由该链派生；存在链外随机、非确定聚合或未承接玩家决策时分别保留Owner。"
      },
      "display": {
        "description_zh": "衡量处于同一抽取序号和同一规则状态时，下一次实际会得到哪些奖励。",
        "usage_scene_zh": "用于区分有放回与无放回抽取，并发现剩余奖池、保证奖进度或前序结果改变下一次概率时的实现偏差。",
        "target_meaning_zh": "每组目标值统计指定抽取序号与前序状态条件下，各真实奖励结果占本组抽取机会的比例。",
        "display_unit": "%（指定抽取状态条件事件占比）"
      },
      "score_group": "feature_process",
      "score_budget_key": "award_draw.outcome_distribution_given_draw_state",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "grouped_total_variation",
        "group_separator": "::",
        "normalization_tolerance": 0.000001,
        "group_weight_source": "task_contract",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.02,
            95
          ],
          [
            0.05,
            85
          ],
          [
            0.1,
            70
          ],
          [
            0.2,
            50
          ],
          [
            0.5,
            0
          ]
        ]
      }
    }
  ]
}
