    {
      "metric_id": "persistent_state.position_share_given_occupied_count_distribution",
      "name_zh": "指定占用数量下的位置份额分布",
      "owner": "atomic.persistent-state",
      "category": "state",
      "display_order": 60,
      "kind": "score",
      "unit": "probability",
      "scope_template": "state.persistent-state×state_id×observation_point×actual_capacity_if_variable",
      "measurement": "Q(position_id | exact_occupied_count, occupied_position_token), fields occupied_count::position_id",
      "sample_unit": "persistent_occupied_position_token",
