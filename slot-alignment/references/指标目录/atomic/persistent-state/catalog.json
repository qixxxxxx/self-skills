      "metric_id": "persistent_state.ordered_value_distribution",
      "name_zh": "有序标量持久状态值分布",
      "owner": "atomic.persistent-state",
      "category": "state",
      "display_order": 10,
      "kind": "score",
      "unit": "probability",
      "scope_template": "state.persistent-state×state_id×observation_point",
      "measurement": "P(ordered_state_value | eligible observation point)",
      "sample_unit": "persistent_state_observation",
      "condition_on": "画像密封的指定观测点，状态形态为ordered_scalar；保留全部可达数值，包含初始、上限和重置值",
      "normalization": "每个state_id×observation_point作用域内有序状态值概率合计为1；实际数值位置由任务合同密封，轴语义由state.persistent-state.ordered_axis_semantics在候选出现前解析",
      "applicability_rule": "持久状态是可比较大小的等级、计量值、累计倍率或进度标量时必需。即使状态随后映射为生效倍率，本指标仍拥有指定观测点的状态边际；倍率应用事件上的最终生效值由倍率指标独立拥有。",
      "missing_policy": "状态身份、观测点、完整数值域、数值顺序或实际值缺失时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support"],
      "capability_ids": [
        "state.persistent-state",
        "modifier.collect",
        "modifier.expanding-wild",
        "modifier.symbol-transform",
        "modifier.win-multiplier"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "state.persistent-state"
        ],
        "required_attributes": [
          "state_id",
          "state_shape",
          "value_domain",
          "value_order",
          "observation_points",
          "ordered_axis_semantics"
        ],
        "attribute_conditions": [
          {
            "mechanic_id": "state.persistent-state",
            "attribute": "state_shape",
            "operator": "equals",
            "value": "ordered_scalar"
          }
        ]
      },
      "semantic_variable_id": "persistent_state.ordered_value_at_observation",
      "semantic_group": "persistent_state_ordered_scalar",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "conditional_derivation_sources": [],
        "cross_checks_with": ["multiplier.effective_value_distribution"],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "只负责有序标量在固定观测点的边际；倍率指标负责已应用事件上的最终生效倍率。两者样本单位和观察边界不同，保持独立Owner，并仅通过规则一致性审计交叉核对映射。"
      },
      "display": {
        "description_zh": "衡量固定观测点上的持久等级、计量值或累计倍率通常处于多大数值。",
        "usage_scene_zh": "用于对齐跨局或跨阶段进度长期停留在哪些数值，并让相邻等级偏差小于跨越多个等级的偏差。",
        "target_meaning_zh": "每个目标值统计指定观测点上对应实际有序状态值所占比例。",
        "display_unit": "%（指定观测点状态观测占比）"
      },
      "score_group": "state",
      "score_budget_key": "persistent_state.ordered_value_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "wasserstein_1d",
        "bin_positions_source": "task_contract",
        "axis_semantics_source": "state.persistent-state.ordered_axis_semantics",
        "anchors": [
