      "scope_template": "component×state×board_phase×settlement_type",
      "measurement": "P(sealed actual winning_scale_bucket | winning_symbol_id), fields symbol_id::scale_bucket",
      "sample_unit": "independent_paid_result_block",
      "condition_on": "指定实际中奖符号的独立派奖块；固定线per_line使用该线实际连中轴数，per_step_symbol使用同一步骤同一符号聚合线组的实际中奖线数；Ways用实际中奖Ways，Count Pay用实际计数，Cluster用实际中奖连片大小",
      "normalization": "每个symbol_id组分别归一化为1；中奖规模轴语义由settlement mechanic winning_scale_axis_semantics在候选出现前解析",
      "applicability_rule": "固定线、Ways、Count Pay或Cluster必需；画像必须先密封实际中奖规模维度，固定线还必须使用合法aggregation_unit组合。局部退化的symbol_id组移除并按原版活动组权重重新归一；全部条件组只有一个可达规模时整项按退化支持标记不适用而不能漏载。",
      "missing_policy": "画像未密封规模维度、固定线aggregation_unit组合非法，或分桶、符号到结算映射缺失时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support", "deterministically_derived_from_primary"],
      "capability_ids": [
        "settlement.payline",
        "settlement.ways",
        "settlement.count-pay",
        "settlement.cluster-pay"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "settlement.payline",
          "settlement.ways",
          "settlement.count-pay",
          "settlement.cluster-pay"
        ],
        "required_attributes": [
          "winning_scale_dimension",
          "winning_scale_axis_semantics"
        ]
      },
      "semantic_variable_id": "settlement.scale_given_winning_symbol",
      "semantic_group": "settlement_scale",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "conditional_derivation_sources": [
          "board.symbol_count_per_board_distribution"
        ],
        "cross_checks_with": [
          "board.symbol_count_per_board_distribution",
          "trigger.symbol_count_distribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [
          "settlement.winning_symbol_distribution"
        ],
        "overlap_reason_zh": "与中奖符号边际构成联合体验的条件分解，不再重复评分原始联合分布。Count Pay若按同一完整盘面、同一symbol_id的可见精确数量直接派奖，则实际计数尾部可由board数量边际确定性推出，对应规模实例必须派生展示或标记不适用；固定线、Ways、Cluster及不可由盘面数量推出的计数范围仍独立评分。"
      },
      "display": {
        "description_zh": "衡量某个符号中奖时通常形成多大规模。",
        "usage_scene_zh": "用于区分谁在中奖与该独立派奖块以多少Ways、线数、计数或连片格数中奖。",
        "target_meaning_zh": "每组目标值统计指定中奖符号条件下，各实际中奖规模档位的比例。",
        "display_unit": "%（指定中奖符号条件占比）"
      },
      "score_group": "settlement_diversity",
      "score_budget_key": "settlement.scale_given_symbol_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "grouped_wasserstein_1d",
        "bin_positions_source": "task_contract",
        "axis_semantics_source": "settlement mechanic winning_scale_axis_semantics",
