    {
      "metric_id": "settlement.scale_given_symbol_distribution",
      "name_zh": "指定中奖符号下的中奖规模分布",
      "owner": "atomic.settlement-diversity",
      "category": "settlement",
      "display_order": 20,
      "kind": "score",
