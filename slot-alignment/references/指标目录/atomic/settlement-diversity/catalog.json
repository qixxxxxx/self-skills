    {
      "metric_id": "settlement.step_return_distribution",
      "name_zh": "完整非Cascade结算步骤总回报分布",
      "owner": "atomic.settlement-diversity",
      "category": "settlement",
      "display_order": 40,
      "kind": "score",
      "unit": "probability",
      "scope_template": "component×state×board_phase",
      "measurement": "P(complete_step_total_return_bucket | unique eligible non-cascade settlement step), including 0x and summing every settlement type resolved in that step exactly once",
      "sample_unit": "complete_non_cascade_settlement_step",
      "condition_on": "指定组件、状态和盘面阶段下的每个唯一完整非Cascade结算步骤；同一步骤混合Payline、Ways、Count Pay、Cluster或其他已登记结算时，先汇总该步骤全部实际派奖再计一次，无任何正派奖时记0x。已由更窄条件回报Owner覆盖的完整步骤整体排除",
      "normalization": "每个component×state×board_phase作用域内，从0x起的密封有序完整步骤总回报桶概率合计为1；禁止按settlement_type复制同一步骤",
      "applicability_rule": "非Cascade且完整步骤未由其他更窄条件回报主Owner承接时必需；同一步骤存在一个或多个结算类型都只保留一个总回报实例。Cascade层级回报由cascade.step_return_distribution_by_depth负责，可变网格容量回报由variable_grid.return_distribution_by_capacity负责，固定布局动态有效Ways容量回报由effective_ways.return_distribution_by_capacity负责。",
      "missing_policy": "唯一完整结算步骤边界、步骤内全部结算类型的实际派奖、跨类型去重键、0派奖步骤、投注分母或与更窄条件回报Owner的完整步骤互斥边界任一无法证明时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support", "semantic_owner_exclusive"],
      "capability_ids": [
        "settlement.payline",
        "settlement.ways",
        "settlement.count-pay",
        "settlement.cluster-pay"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "settlement.payline",
          "settlement.ways",
          "settlement.count-pay",
          "settlement.cluster-pay"
        ]
      },
      "semantic_variable_id": "settlement.non_cascade_step_return",
      "semantic_group": "settlement_outcome",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "core.return_distribution.lt200"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "exclusive_with": [
          "cascade.step_return_distribution_by_depth",
          "variable_grid.return_distribution_by_capacity",
          "effective_ways.return_distribution_by_capacity"
        ],
        "overlap_reason_zh": "本指标是每个普通非Cascade完整结算步骤总回报的唯一Owner：同一步骤即使混合Payline、Ways、Count Pay或Cluster也只汇总并统计一次。中奖符号、中奖规模、并发派奖块和线路几何仍可按settlement_type拆分，但不得复制完整步骤总回报。Cascade、可变网格容量Ways和固定布局动态有效Ways已有更窄条件回报Owner时按完整步骤互斥。"
      },
      "display": {
        "description_zh": "衡量每个完整非Cascade结算步骤汇总全部结算类型后，通常是0x、小奖、中等奖还是较高总回报。",
        "usage_scene_zh": "用于发现总体RTP、中奖符号和中奖规模接近，但完整摇奖步骤的总中奖金额档位仍然单一或偏移；混合结算不会重复加权。",
        "target_meaning_zh": "每个目标值统计指定组件、状态和盘面阶段下，唯一完整结算步骤的全部实际派奖总和落入对应倍率桶的比例，0x步骤必须计入且同一步骤只能出现一次。",
        "display_unit": "%（完整非Cascade结算步骤占比）"
      },
      "score_group": "settlement_diversity",
      "score_budget_key": "settlement.step_return_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "wasserstein_1d",
        "bin_positions_source": "task_contract",
        "axis_semantics": "nonnegative_multiplicative",
        "position_transform": "log10_1p",
