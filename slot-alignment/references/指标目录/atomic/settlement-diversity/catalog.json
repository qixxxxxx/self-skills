      "metric_id": "settlement.winning_symbol_distribution",
      "name_zh": "中奖符号构成",
      "owner": "atomic.settlement-diversity",
      "category": "settlement",
      "display_order": 10,
      "kind": "score",
      "unit": "distribution",
      "scope_template": "component×state×board_phase×settlement_type",
      "measurement": "P(winning_symbol_id | independent_paid_result_block)",
      "sample_unit": "independent_paid_result_block",
      "condition_on": "实际产生正派奖的独立结算块：固定线按aggregation_unit取逐线派奖块或同一步骤同一中奖符号聚合线组，Ways按实际符号结算块，Count Pay按符号计数派奖块，Cluster按实际中奖连片",
      "normalization": "全部合格独立派奖块上的中奖符号概率合计为1",
      "applicability_rule": "能够从结算事实识别实际中奖符号时必需。",
      "missing_policy": "中奖组合、实际中奖符号或固定线aggregation_unit与winning_scale_dimension合法组合缺失时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support", "deterministically_derived_from_primary"],
      "capability_ids": [
        "settlement.payline",
        "settlement.ways",
        "settlement.count-pay",
        "settlement.cluster-pay"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "settlement.payline",
          "settlement.ways",
          "settlement.count-pay",
          "settlement.cluster-pay"
        ]
      },
      "semantic_variable_id": "settlement.winning_symbol",
      "semantic_group": "settlement_source",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "conditional_derivation_sources": [
          "board.symbol_count_per_board_distribution"
        ],
        "cross_checks_with": [
          "board.symbol_count_per_board_distribution",
          "trigger.symbol_count_distribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "本指标拥有固定线、Ways和Cluster实际独立派奖块的中奖符号边际。Count Pay若由同一完整盘面的可见精确符号数量与确定性派奖聚合规则直接产生，则中奖符号边际可由board数量目标复算，对应实例必须派生展示或标记不适用。"
      },
      "display": {
        "description_zh": "衡量实际中奖主要由哪些符号产生。",
        "usage_scene_zh": "用于发现总体中奖率正常但中奖长期集中在少数符号。",
        "target_meaning_zh": "每个值统计对应符号的独立正派奖块占全部合格独立派奖块的比例。",
        "display_unit": "%（独立派奖块占比）"
      },
      "score_group": "settlement_diversity",
      "score_budget_key": "settlement.winning_symbol_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
