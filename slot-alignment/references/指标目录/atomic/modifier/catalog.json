    {
      "metric_id": "multiplier.effective_value_distribution",
      "name_zh": "实际生效倍率值分布",
      "owner": "atomic.modifier",
      "category": "modifier",
      "display_order": 30,
      "kind": "score",
      "unit": "distribution",
      "scope_template": "modifier.win-multiplier×component×state",
      "measurement": "distribution of final effective multiplier value per applied multiplier event",
      "sample_unit": "applied_multiplier_event",
      "condition_on": "倍率已实际参与结算；按画像密封组合规则得到最终生效值",
      "normalization": "生效倍率有序值桶概率合计为1，不包含未出现或未应用事件",
      "applicability_rule": "存在中奖倍率修饰时必需；单一可达值按退化支持不适用。持久状态观测值与倍率应用事件的样本边界不同，保持独立Owner。动态奖值符号也默认独立；只有value_symbol_effective_multiplier_binding证明全部赋值实例恰好兑现一次、与应用事件同域一一对应、无额外倍率源、值映射双向确定，且primary_owner_metric_id选择价值符号指标时才由其派生。Cascade深度对最终倍率完全确定时也由深度分布派生。",
      "missing_policy": "倍率值域、组合规则、应用事实或最终倍率值缺失时阻塞FORMAL；声称派生时必须提供完整一一映射、同一事件域、无额外来源、完整值映射及证据hash。",
      "inapplicability_reason_codes": ["degenerate_reachable_support", "deterministically_derived_from_primary"],
      "capability_ids": [
        "modifier.win-multiplier"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "modifier.win-multiplier"
        ],
        "required_attributes": [
          "combine_rule",
          "value_domain"
        ]
