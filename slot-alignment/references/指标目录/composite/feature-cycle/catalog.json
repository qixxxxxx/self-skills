    {
      "metric_id": "feature_cycle.base_bet_equivalent_return_distribution",
      "name_zh": "Feature Buy按正常基础投注折算回报审计",
      "owner": "composite.feature-cycle",
      "category": "feature",
      "display_order": 40,
      "kind": "audit",
      "unit": "distribution",
      "scope_template": "feature:*×entry_source:feature_buy",
      "measurement": "directly recompute feature_total_win/normal_base_bet for every event in the same sealed completed Feature Buy event set used by the primary return source",
      "sample_unit": "completed_feature_cycle",
      "condition_on": "Feature Buy完整周期；必须密封并逐事件绑定event_id、feature_total_win、actual_purchase_cost、normal_base_bet、entry_source、主回报事件集hash及基础投注折算桶边界",
      "normalization": "直接按逐事件feature_total_win/normal_base_bet落入密封有序桶并归一化为1；0x独立成桶，仅作非评分阅读审计，不从购买成本回报桶重分配概率",
      "applicability_rule": "存在Feature Buy时必需审计；无购买入口时不适用。",
      "missing_policy": "任一密封事件标识、事件集hash、feature_total_win、actual_purchase_cost、normal_base_bet、entry_source或折算桶边界缺失时形成审计警告；不得猜测比例、重分配粗桶或拿折算口径替代购买成本主评分。",
      "inapplicability_reason_codes": ["feature_buy_unavailable"],
      "capability_ids": [
        "feature.free-spin",
        "feature.respin",
        "feature.hold-and-spin",
        "feature.award-draw",
        "feature.bonus-sequence"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "feature.free-spin",
          "feature.respin",
          "feature.hold-and-spin",
          "feature.award-draw",
          "feature.bonus-sequence"
        ],
        "required_attributes": [
          "entry_sources"
        ]
      },
      "semantic_variable_id": "feature_cycle.base_bet_equivalent_return_for_buy",
      "semantic_group": "feature_outcome",
      "semantic_role": "audit",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "feature_cycle.return_distribution",
          "feature_cycle.return_distribution_by_stage_path"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "本项只对主回报使用的同一批密封Feature Buy原始周期按正常基础投注额重新计算；它不是从购买成本回报分桶派生，权重固定为0，主评分仍只使用购买成本口径。"
      },
      "display": {
        "description_zh": "把Feature Buy派奖换算成正常基础投注额的倍数，仅供玩家常用倍数口径阅读。",
        "usage_scene_zh": "用于同时说明“相对购买成本的投资回报”和“相对正常单次投注的奖金规模”，但只计前者一次分。",
        "target_meaning_zh": "每个值统计同一批密封Feature Buy周期逐事件按正常基础投注额重算后，完整回报落入对应倍率桶的比例。",
        "display_unit": "%（Feature Buy完整周期占比）"
      },
      "score_weight": 0,
      "audit_profile": {
        "method": "sealed_event_recomputation",
        "blocking_on_missing": false
      }
    },
    {
      "metric_id": "feature_cycle.duration_distribution",
      "name_zh": "完整Feature主要动作次数分布",
      "owner": "composite.feature-cycle",
      "category": "feature",
      "display_order": 50,
      "kind": "score",
      "unit": "distribution",
      "scope_template": "feature:*×entry_source",
      "measurement": "end-to-end distribution of sealed final primary-action count per completed feature cycle after initial grant, retrigger/extension/reset, stop rules, and cross-step dependencies",
      "sample_unit": "completed_feature_cycle",
      "condition_on": "全部完成的Feature周期；主要动作单位由画像密封为免费旋转、重转、选择、抽奖或已类型化阶段动作次数，并统计完整状态链结束后的最终总数",
      "normalization": "主要动作次数有序桶概率合计为1",
      "applicability_rule": "Feature存在可数的玩家主要动作，且最终动作总数不能由另一个已评分局部主指标按密封规则确定性一一推出时必需；若可精确推出，本实例必须标记不适用并只展示来源派生结果。",
      "missing_policy": "主要动作单位、周期边界、初始资源、续命或重置规则、停止规则、最终动作总数或确定性可推出判定证据任一缺失时阻塞FORMAL。",
      "inapplicability_reason_codes": ["degenerate_reachable_support", "deterministically_derived_from_primary"],
      "capability_ids": [
        "feature.free-spin",
        "feature.respin",
        "feature.hold-and-spin",
        "feature.award-draw",
        "feature.bonus-sequence"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "feature.free-spin",
          "feature.respin",
          "feature.hold-and-spin",
          "feature.award-draw",
          "feature.bonus-sequence"
        ],
        "required_attributes": [
          "entry_sources"
        ]
      },
      "semantic_variable_id": "feature_cycle.primary_action_count",
      "semantic_group": "feature_duration",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
      "conditional_derivation_sources": [
        "free_spin.initial_grant_distribution",
        "respin.initial_grant_distribution",
        "award_draw.outcome_distribution_given_draw_state"
        ],
        "cross_checks_with": [
          "free_spin.initial_grant_distribution",
          "free_spin.retrigger_grant_distribution",
          "respin.initial_grant_distribution",
          "respin.extension_grant_distribution",
          "hold_spin.initial_occupancy_distribution",
          "hold_spin.current_occupancy_distribution",
          "hold_spin.occupancy_transition_distribution",
          "award_draw.outcome_distribution_given_draw_state"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
      "overlap_reason_zh": "只有画像以结构化布尔合同证明初始赠送与最终执行次数一一对应，且无提前停止、可变消耗、计数重置和跨步依赖时，本实例才可标记不适用并由同一Feature的初始赠送Owner直接推出。完整Award Draw有限随机链只有在逐个终局结果都能确定映射到实际主要动作总数、支持全集完整覆盖且无链外动作随机性时，也可直接投影时长。盘面或触发数量只是初始赠送的上游来源，不能跳过初始赠送Owner；未密封动作总数投影的Award Draw也不能替代时长Owner。逐次重触发或延长赠送数量的边际分布不能恢复完整周期总次数。Hold & Spin步骤当前占用只说明全部步骤时间花在哪些填充阶段，不能恢复每个周期一共执行多少步。否则本指标独立评分，并以0.5权重限制重复放大。"
      },
      "display": {
        "description_zh": "衡量存在非确定性续命、重置、停止、跨步依赖或阶段循环时，一次完整Feature最终包含多少次画像密封的主要动作。",
        "usage_scene_zh": "用于发现局部发放、转移或阶段动作看似正常但完整周期仍过短或过长；若最终次数可由已评分局部Owner确定性推出，则不重复评分。",
        "target_meaning_zh": "每个值统计全部完成周期的最终主要动作总数落入对应实际次数档位的比例；复合Feature序列以已类型化阶段动作的实际完成次数计数，纯路由不计数。",
        "display_unit": "%（完整Feature周期占比）"
      },
      "score_group": "feature_experience",
      "score_budget_key": "feature_cycle.duration_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 0.5,
      "score_profile": {
        "method": "wasserstein_1d",
        "bin_positions_source": "task_contract",
        "distance_normalization": "sealed_support_span",
        "anchors": [
          [
