  "metrics": [
    {
      "metric_id": "feature_cycle.stage_path_distribution",
      "name_zh": "Feature阶段路径分布",
      "owner": "composite.feature-cycle",
      "category": "feature",
      "display_order": 10,
      "kind": "score",
      "unit": "distribution",
      "scope_template": "feature:*×entry_source",
      "measurement": "P(canonical control-flow stage_path_id | completed feature cycle)",
      "sample_unit": "completed_feature_cycle",
      "condition_on": "每个完整Feature周期；路径只由control_stage_id和branch_id组成，排除奖项值、状态值、时长和回报桶",
      "normalization": "全部密封阶段路径概率合计为1",
      "applicability_rule": "所有完整Feature都必须密封真实控制流路径；两条及以上可达路径时评分。单路径按退化支持不适用；若完整Atomic事件链可结合stage_graph确定性生成每个路径签名，本项作确定性派生。",
      "missing_policy": "阶段身份、顺序或完整路径缺失时阻塞FORMAL；单一可达路径也必须密封唯一真实路径标签并按退化支持集标记不适用，不得得到常量100分。",
      "inapplicability_reason_codes": ["degenerate_reachable_support", "deterministically_derived_from_primary"],
      "capability_ids": [
        "feature.free-spin",
        "feature.respin",
        "feature.hold-and-spin",
        "feature.award-draw",
        "feature.bonus-sequence"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "feature.free-spin",
          "feature.respin",
          "feature.hold-and-spin",
          "feature.award-draw",
          "feature.bonus-sequence"
        ],
        "required_attributes": [
          "entry_sources",
          "stage_graph",
          "path_signature_definition"
        ]
      },
      "semantic_variable_id": "feature_cycle.stage_path",
      "semantic_group": "feature_path",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "conditional_derivation_sources": [
          "award_draw.outcome_distribution_given_draw_state"
        ],
        "cross_checks_with": [],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "无；本指标为该语义变量的唯一Owner。"
      },
      "display": {
        "description_zh": "衡量完整Feature会经过哪些真实阶段和分支路径。",
        "usage_scene_zh": "用于发现最终回报接近但升级、分支或阶段体验不同。",
        "target_meaning_zh": "每个值统计完成的Feature周期采用对应阶段路径的比例。",
        "display_unit": "%（完整Feature周期占比）"
      },
      "score_group": "feature_experience",
      "score_budget_key": "feature_cycle.stage_path_distribution",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "total_variation",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.02,
            95
          ],
          [
            0.05,
            85
          ],
          [
            0.1,
            70
          ],
          [
            0.2,
            50
          ],
          [
            0.5,
            0
          ]
        ]
      }
    },
    {
      "metric_id": "feature_cycle.return_distribution_by_stage_path",
      "name_zh": "指定阶段路径下的Feature回报分布",
      "owner": "composite.feature-cycle",
      "category": "feature",
      "display_order": 20,
      "kind": "score",
      "unit": "probability",
      "scope_template": "feature:*×entry_source",
      "measurement": "P(primary_return_bucket | sealed stage_path_id), fields stage_path_id::return_bucket",
      "sample_unit": "completed_feature_cycle",
      "condition_on": "指定完整阶段路径；自然入口回报除以触发付费投注，Feature Buy回报除以实际购买成本",
      "normalization": "每个stage_path_id组分别归一化为1；必须单独保留精确0x桶，其他正回报桶按实际边界有序密封；单阶段Feature使用唯一固定路径组",
      "applicability_rule": "所有可界定完整周期的Feature必需。若完整Atomic随机链能确定性复算控制路径和终局主回报，本项派生；Award Draw不限单抽或放回规则，以七项链完整性证明为准。局部退化的stage_path_id组移除并按原版活动路径权重重新归一；全部路径回报组退化时整项按退化支持标记不适用。",
      "missing_policy": "路径到完整派奖绑定、主回报分母、有序回报桶或独立精确0x桶任一缺失时阻塞FORMAL；声称由奖励结果确定性派生时，还必须密封覆盖全部outcome_id且值域唯一的outcome到回报桶映射，映射或来源目标证据缺失时不得省略本指标评分。",
      "inapplicability_reason_codes": [
        "degenerate_reachable_support",
        "deterministically_derived_from_primary"
      ],
      "capability_ids": [
        "feature.free-spin",
        "feature.respin",
        "feature.hold-and-spin",
        "feature.award-draw",
        "feature.bonus-sequence"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "feature.free-spin",
          "feature.respin",
          "feature.hold-and-spin",
          "feature.award-draw",
          "feature.bonus-sequence"
        ],
        "required_attributes": [
          "entry_sources",
          "stage_graph",
          "path_signature_definition"
        ]
      },
      "semantic_variable_id": "feature_cycle.primary_return_given_stage_path",
      "semantic_group": "feature_outcome",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "conditional_derivation_sources": [
          "award_draw.outcome_distribution_given_draw_state"
        ],
        "cross_checks_with": [],
        "marginal_of": [],
        "conditional_on_metric": [
          "feature_cycle.stage_path_distribution"
        ],
        "overlap_reason_zh": "通常与路径边际构成非重叠条件分解。完整Atomic链可复算路径与终局回报时派生；链外随机、非确定聚合或未承接玩家决策时独立评分。"
      },
      "display": {
        "description_zh": "衡量经过同一条Feature阶段路径后通常获得多少回报；与单次抽奖结果完全同构时不重复计分。",
        "usage_scene_zh": "用于区分路径频率正确但各路径奖励强度错误的问题；单阶段玩法也使用唯一固定路径。完整奖励抽取随机链可复算路径与终局回报时改为派生展示。",
        "target_meaning_zh": "每组目标值统计指定真实阶段路径条件下，按主回报口径计算的完整回报落入各倍率桶的比例。",
        "display_unit": "%（指定阶段路径条件周期占比）"
      },
      "score_group": "feature_experience",
      "score_budget_key": "feature_cycle.return_distribution_by_stage_path",
      "scope_aggregation": "weighted_mean",
      "default_weight": 1,
      "score_profile": {
        "method": "grouped_wasserstein_1d",
        "bin_positions_source": "task_contract",
        "axis_semantics": "nonnegative_multiplicative",
        "position_transform": "log10_1p",
        "distance_normalization": "fixed_transform_unit",
        "distance_scale": 1,
        "distance_unit": "log10_decade",
        "group_separator": "::",
        "normalization_tolerance": 0.000001,
        "group_weight_source": "task_contract",
        "anchors": [
          [
            0,
            100
          ],
          [
            0.02,
            95
          ],
          [
            0.05,
            85
          ],
          [
            0.1,
            70
          ],
          [
            0.2,
            50
          ],
          [
            0.5,
            0
          ]
        ]
      }
    },
    {
      "metric_id": "feature_cycle.return_distribution",
      "name_zh": "完整Feature回报边际分布",
      "owner": "composite.feature-cycle",
      "category": "feature",
      "display_order": 30,
      "kind": "audit",
      "unit": "distribution",
      "scope_template": "feature:*×entry_source",
      "measurement": "sum_path P(stage_path) * P(primary_return_bucket | stage_path)",
      "sample_unit": "completed_feature_cycle",
      "condition_on": "完整Feature周期；自然入口以触发付费投注为分母，Feature Buy以实际购买成本为主评分分母",
      "normalization": "由路径边际与各路径条件分布确定性聚合为1；各路径精确0x桶必须无损聚合为总体精确0x桶",
      "applicability_rule": "存在可界定开始与结束的完整Feature时必需。",
      "missing_policy": "阶段路径边际或路径条件回报缺失时由上游主指标阻塞FORMAL；本项不要求独立测量，必须由两项上游结果确定性派生。",
      "capability_ids": [
        "feature.free-spin",
        "feature.respin",
        "feature.hold-and-spin",
        "feature.award-draw",
        "feature.bonus-sequence"
      ],
      "profile_match": {
        "mechanic_id_any": [
          "feature.free-spin",
          "feature.respin",
          "feature.hold-and-spin",
          "feature.award-draw",
          "feature.bonus-sequence"
        ],
        "required_attributes": [
          "entry_sources"
        ]
      },
      "semantic_variable_id": "feature_cycle.primary_return_marginal",
      "semantic_group": "feature_outcome",
      "semantic_role": "derived_diagnostic",
      "relationships": {
        "derived_from": [
          "feature_cycle.stage_path_distribution",
          "feature_cycle.return_distribution_by_stage_path"
        ],
        "cross_checks_with": [],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "由阶段路径边际P(path)与路径条件回报P(return|path)确定性加权得到，不作为第三个回报评分。"
      },
      "display": {
        "description_zh": "汇总展示一次完整Feature按主回报口径最终落入哪些倍率区间。",
        "usage_scene_zh": "用于阅读总体回报；正式评分拆为阶段路径边际与路径条件回报，避免重复计分。",
        "target_meaning_zh": "每个值由阶段路径概率乘以该路径条件回报概率后对全部路径求和。",
        "display_unit": "%（完整Feature周期占比）"
      },
      "score_weight": 0,
      "audit_profile": {
        "method": "deterministic_derivation",
        "blocking_on_missing": false
      }
