      "facets": [
        {
          "facet_id": "total_rtp",
          "name_zh": "用户确认总RTP",
          "sample_unit": "paid_entry",
          "measurement": "sum(paid_entry_total_win)/sum(actual_economic_bet)",
          "target_source": "user_confirmed_exact_rtp",
          "distance_method": "absolute_probability_error",
          "subitem_source": "single"
        }
      ]
    },
    {
