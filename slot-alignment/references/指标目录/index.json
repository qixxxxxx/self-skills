{
  "schema_version": "slot-alignment.metric-library.v5",
  "library_id": "slot-alignment-player-experience-metrics",
  "version": "5.0.0",
  "status": "active",
  "principles": {
    "top_level_categories_are_mutually_exclusive": true,
    "all_profile_matched_formal_subitems_required": true,
    "formal_metric_waiver_allowed": false,
    "weights_allowed": false,
    "composite_score_allowed": false,
    "card_status_aggregation": "worst_subitem",
    "derived_values_are_audit_only": true
  },
  "categories": [
    {
      "category_id": "N",
      "name_zh": "数值指标",
      "display_order": 10,
      "owner_boundary_zh": "跨完整付费入口或组件的全局数值红线。"
    },
    {
      "category_id": "J",
      "name_zh": "中奖结算",
      "display_order": 20,
      "owner_boundary_zh": "完整结算链中的实际派奖结果；Cascade连续消除属于本类。"
    },
    {
      "category_id": "P",
      "name_zh": "玩法过程",
      "display_order": 30,
      "owner_boundary_zh": "跨结算步骤的Feature周期和特色机制结果状态。"
    },
    {
      "category_id": "B",
      "name_zh": "盘面呈现",
      "display_order": 40,
      "owner_boundary_zh": "稳定可见盘面的符号数量、位置和空间形态。"
    }
  ],
  "cards": [
    {
      "card_id": "N1",
      "name_zh": "总RTP",
      "category_id": "N",
      "display_order": 10,
      "kind": "hard_gate",
      "player_question_zh": "玩家长期每投注1单位平均返还多少？",
      "applies_when": {"always": true},
      "facets": [
        {
          "facet_id": "total_rtp",
          "name_zh": "用户确认总RTP",
          "sample_unit": "paid_entry",
          "measurement": "sum(paid_entry_total_win)/sum(actual_economic_bet)",
          "target_source": "user_confirmed_exact_rtp",
          "distance_method": "absolute_probability_error",
          "subitem_source": "single"
        }
      ]
    },
    {
      "card_id": "N2",
      "name_zh": "完整付费入口中奖率",
      "category_id": "N",
      "display_order": 20,
      "kind": "hard_gate",
      "player_question_zh": "一次实际付费入口最终获得任意正回报的概率是多少？",
      "applies_when": {"always": true},
      "facets": [
        {
          "facet_id": "positive_return_rate",
          "name_zh": "回报大于0概率",
          "sample_unit": "paid_entry",
          "measurement": "P(paid_entry_return > 0)",
          "target_source": "sealed_original_evidence",
          "distance_method": "absolute_probability_error",
          "subitem_source": "single"
        }
      ]
    },
    {
      "card_id": "N3",
      "name_zh": "Feature自然触发率",
      "category_id": "N",
      "display_order": 30,
      "kind": "hard_gate",
      "player_question_zh": "各Feature通过游戏内生规则自然进入的概率是多少？",
      "applies_when": {"profile_has_any": ["feature"]},
      "facets": [
        {
          "facet_id": "natural_trigger_rate",
          "name_zh": "逐Feature自然触发率",
          "sample_unit": "paid_entry",
          "measurement": "P(natural_entry_into_feature)",
          "target_source": "sealed_original_evidence",
          "distance_method": "absolute_probability_error",
          "subitem_source": "features_with_endogenous_entry"
        }
      ]
    },
    {
      "card_id": "N4",
      "name_zh": "完整付费入口回报大于等于1x概率",
      "category_id": "N",
      "display_order": 40,
      "kind": "hard_gate",
      "player_question_zh": "一次完整付费入口至少收回实际成本的概率是多少？",
      "applies_when": {"always": true},
      "facets": [
        {
          "facet_id": "return_ge_cost_rate",
          "name_zh": "回报大于等于实际成本概率",
          "sample_unit": "paid_entry",
          "measurement": "P(paid_entry_return >= actual_entry_cost)",
          "target_source": "sealed_original_evidence",
          "distance_method": "absolute_probability_error",
          "subitem_source": "single",
          "boundary": "inclusive",
          "feature_buy_cost_rule": "use_actual_purchase_cost"
        }
      ]
    },
    {
      "card_id": "N5",
      "name_zh": "Sigma",
      "category_id": "N",
      "display_order": 50,
      "kind": "hard_gate",
      "player_question_zh": "总体及主要作用域的回报波动有多大？",
      "applies_when": {"always": true},
      "facets": [
        {
          "facet_id": "return_sigma",
          "name_zh": "总体及适用作用域Sigma",
          "sample_unit": "paid_entry_or_component_entry",
          "measurement": "population_std(return_multiple)",
          "target_source": "sealed_original_evidence",
          "distance_method": "relative_error",
          "subitem_source": "overall_and_profile_scopes"
        }
      ]
    },
    {
      "card_id": "N6",
      "name_zh": "组件RTP贡献",
      "category_id": "N",
      "display_order": 60,
      "kind": "hard_gate",
      "player_question_zh": "总体返还由Base、各Feature和其他组件分别贡献多少？",
      "applies_when": {"always": true},
      "facets": [
        {
          "facet_id": "component_rtp",
          "name_zh": "逐组件RTP贡献",
          "sample_unit": "paid_entry",
          "measurement": "sum(component_win)/sum(actual_economic_bet)",
          "target_source": "original_component_share_mapped_to_user_confirmed_total_rtp",
          "distance_method": "absolute_probability_error",
          "subitem_source": "base_features_and_other_components"
        }
      ]
    },
    {
      "card_id": "J1",
      "name_zh": "中奖构成",
      "category_id": "J",
      "display_order": 10,
      "kind": "alignment",
      "player_question_zh": "正派奖时通常由哪些元素或线路参与？",
      "applies_when": {"profile_has_any": ["settlement"]},
      "facets": [
        {
          "facet_id": "element_win_participation_rate",
          "name_zh": "逐结算元素中奖参与率",
          "sample_unit": "positive_settlement_step",
          "measurement": "P(element_participates | positive_settlement_step)",
          "target_source": "sealed_original_evidence",
          "distance_method": "absolute_probability_error",
          "subitem_source": "settlement_elements"
        },
        {
          "facet_id": "payline_win_participation_rate",
          "name_zh": "逐规范线路中奖参与率",
          "sample_unit": "positive_settlement_step",
          "measurement": "P(payline_participates | positive_settlement_step)",
          "target_source": "sealed_original_evidence",
          "distance_method": "absolute_probability_error",
          "subitem_source": "canonical_paylines",
          "applies_when": {"settlement_type": "payline"}
        }
      ]
    },
    {
      "card_id": "J2",
      "name_zh": "中奖规模",
      "category_id": "J",
      "display_order": 20,
      "kind": "alignment",
      "player_question_zh": "单次中奖由多少符号、轴、Ways或结果构成，实际奖励有多大？",
      "applies_when": {"profile_has_any": ["settlement"]},
      "facets": [
        {
          "facet_id": "single_win_structure_size",
          "name_zh": "单个中奖结果结构规模",
          "sample_unit": "win_result",
          "measurement": "settlement_specific_structure_size",
          "target_source": "sealed_original_evidence",
          "distance_method": "wasserstein_1d",
          "axis_semantics": "natural_linear",
          "subitem_source": "settlement_elements_and_size_axes"
        },
        {
          "facet_id": "simultaneous_win_count",
          "name_zh": "同步中奖结果数量",
          "sample_unit": "positive_settlement_step",
          "measurement": "count(win_results_in_step)",
          "target_source": "sealed_original_evidence",
          "distance_method": "wasserstein_1d",
          "axis_semantics": "natural_linear",
          "subitem_source": "settlement_scopes"
        },
        {
          "facet_id": "actual_reward_size",
          "name_zh": "实际奖励大小",
          "sample_unit": "win_result",
          "measurement": "win_amount/actual_economic_bet",
          "target_source": "sealed_original_evidence",
          "distance_method": "wasserstein_1d",
          "axis_semantics": "nonnegative_multiplicative",
          "position_transform": "log10_1p",
          "subitem_source": "non_deterministic_payout_mappings",
          "deterministic_mapping_policy": "audit_only"
        }
      ]
    },
    {
      "card_id": "J3",
      "name_zh": "连续结算",
      "category_id": "J",
      "display_order": 30,
      "kind": "alignment",
      "player_question_zh": "一次动作会连续结算多少层，各层中奖规模如何？",
      "applies_when": {"profile_has_any": ["cascade", "continuous_settlement"]},
      "facets": [
        {
          "facet_id": "total_depth",
          "name_zh": "连续结算总深度",
          "sample_unit": "eligible_primary_action",
          "measurement": "count(positive_continuous_settlement_steps); no_chain=0",
          "target_source": "sealed_original_evidence",
          "distance_method": "wasserstein_1d",
          "axis_semantics": "natural_linear",
          "subitem_source": "continuous_settlement_scopes"
        },
        {
          "facet_id": "win_scale_by_depth",
          "name_zh": "指定层级中奖规模",
          "sample_unit": "positive_continuous_settlement_step",
          "measurement": "J2_size_conditioned_on_depth",
          "target_source": "sealed_original_evidence",
          "distance_method": "wasserstein_1d",
          "axis_semantics": "from_J2",
          "subitem_source": "active_depth_and_J2_axes"
        }
      ]
    },
    {
      "card_id": "P1",
      "name_zh": "周期节奏",
      "category_id": "P",
      "display_order": 10,
      "kind": "alignment",
      "player_question_zh": "Feature开始时给多少免费旋转，完整Feature会持续多久？",
      "applies_when": {"profile_has_any": ["feature"]},
      "facets": [
        {
          "facet_id": "initial_free_spin_count",
          "name_zh": "初始免费旋转次数",
          "sample_unit": "free_spin_feature_start",
          "measurement": "initial_awarded_free_spins",
          "target_source": "sealed_original_evidence",
          "distance_method": "wasserstein_1d",
          "axis_semantics": "natural_linear",
          "subitem_source": "free_spin_features",
          "applies_when": {"feature_type": "free_spin"}
        },
        {
          "facet_id": "feature_duration",
          "name_zh": "完整Feature持续长度",
          "sample_unit": "feature_cycle",
          "measurement": "count(primary_actions_in_complete_feature)",
          "target_source": "sealed_original_evidence",
          "distance_method": "wasserstein_1d",
          "axis_semantics": "natural_linear",
          "subitem_source": "feature_cycles"
        }
      ]
    },
    {
      "card_id": "P2",
      "name_zh": "机制结果状态",
      "category_id": "P",
      "display_order": 20,
      "kind": "alignment",
      "player_question_zh": "每次特色机制机会最终落入什么可感知结果状态？",
      "applies_when": {"profile_has_any": ["mechanic"]},
      "facets": [
        {
          "facet_id": "mechanic_result_state",
          "name_zh": "逐机制结果状态分布",
          "sample_unit": "eligible_mechanic_opportunity",
          "measurement": "exclusive_complete_result_state",
          "target_source": "sealed_original_evidence",
          "distance_method": "total_variation",
          "subitem_source": "active_special_mechanics",
          "required_states": ["not_occurred_or_not_effective"]
        }
      ]
    },
    {
      "card_id": "B1",
      "name_zh": "符号呈现",
      "category_id": "B",
      "display_order": 10,
      "kind": "alignment",
      "player_question_zh": "每个稳定可见盘面中，各符号通常出现多少个？",
      "applies_when": {"profile_has_any": ["board"]},
      "facets": [
        {
          "facet_id": "symbol_count_per_board",
          "name_zh": "逐符号单盘数量分布",
          "sample_unit": "stable_visible_board",
          "measurement": "count(symbol_on_board), including_zero",
          "target_source": "sealed_original_evidence",
          "distance_method": "wasserstein_1d",
          "axis_semantics": "natural_linear",
          "subitem_source": "visible_symbols_and_board_scopes",
          "zero_bucket_required": true
        }
      ]
    },
    {
      "card_id": "B2",
      "name_zh": "盘面空间结构",
      "category_id": "B",
      "display_order": 20,
      "kind": "alignment",
      "player_question_zh": "盘面形状如何变化，玩家关注的关键符号通常出现在哪里？",
      "applies_when": {"profile_has_any": ["board"]},
      "facets": [
        {
          "facet_id": "board_shape",
          "name_zh": "可变盘面形态",
          "sample_unit": "stable_visible_board",
          "measurement": "active_cell_mask_or_equivalent_visible_shape",
          "target_source": "sealed_original_evidence",
          "distance_method": "structural_wasserstein",
          "subitem_source": "variable_board_scopes",
          "fixed_board_policy": "audit_only"
        },
        {
          "facet_id": "key_symbol_position_density",
          "name_zh": "关键符号空间位置密度",
          "sample_unit": "stable_visible_board_with_symbol",
          "measurement": "board_equalized_symbol_cell_density_conditioned_on_presence",
          "target_source": "sealed_original_evidence",
          "distance_method": "structural_wasserstein",
          "subitem_source": "profile_selected_spatial_symbols_and_board_scopes"
        }
      ]
    }
  ],
  "audits": [
    {
      "audit_id": "A1",
      "name_zh": "完整付费入口倍率分布与长尾",
      "source_cards": ["N2", "N4"],
      "includes": ["full_return_distribution", "below_200x", "above_or_equal_200x", "observed_max", "theoretical_max", "cap"]
    },
    {
      "audit_id": "A2",
      "name_zh": "结算元素与线路RTP守恒",
      "source_cards": ["J1", "N6"],
      "includes": ["absolute_rtp_contribution", "share_of_settlement_rtp", "component_sum_check"]
    },
    {
      "audit_id": "A3",
      "name_zh": "连续结算派生统计",
      "source_cards": ["J3"],
      "includes": ["continuation_probability", "rtp_by_depth"]
    },
    {
      "audit_id": "A4",
      "name_zh": "玩法过程派生统计",
      "source_cards": ["P1", "P2"],
      "includes": ["retrigger_count", "extension_events", "mechanic_occurrence_rate", "mechanic_effective_rate", "incremental_rtp"]
    },
    {
      "audit_id": "A5",
      "name_zh": "盘面派生统计",
      "source_cards": ["B1", "B2"],
      "includes": ["symbol_presence_rate", "fixed_board_rule_consistency"]
    }
  ]
}
