  "summary_path": "指标汇总.md",
  "categories": [
    {
      "category_id": "core",
      "name_zh": "通用结果与风险",
      "display_order": 10,
      "source_categories": [
        "core"
      ],
      "description_zh": "所有游戏共用的RTP、中奖率、触发率、波动、组件贡献、长尾及封顶门禁。"
    },
    {
      "category_id": "board",
      "name_zh": "盘面生成与符号结构",
      "display_order": 20,
      "source_categories": [
        "board"
      ],
      "description_zh": "可见符号组成、空间结构、生成集中度、可变轴高和组合容量。"
    },
    {
      "category_id": "settlement",
      "name_zh": "中奖结算与构成",
      "display_order": 30,
      "source_categories": [
        "settlement"
      ],
      "description_zh": "实际中奖符号、条件中奖规模、并发结果、赔付线和Cluster结算结构。"
    },
    {
      "category_id": "trigger",
      "name_zh": "玩法触发与入口",
      "display_order": 40,
      "source_categories": [
        "trigger"
      ],
      "description_zh": "触发符号数量、位置配置及已进入Feature后的游戏内生入口来源构成；外生选择不进入评分。"
    },
    {
      "category_id": "evolution",
      "name_zh": "盘面演化与连续过程",
      "display_order": 50,
      "source_categories": [
        "evolution"
      ],
      "description_zh": "Cascade等一次入口内的连续盘面演化、补充和分层回报。"
    },
    {
      "category_id": "feature",
      "name_zh": "特色玩法、奖励与状态",
      "display_order": 60,
      "source_categories": [
        "feature",
        "award",
        "state"
      ],
      "description_zh": "免费旋转、重转、Hold & Spin、奖励抽取、动态奖值、Jackpot、持久状态及完整Feature周期。"
    },
    {
      "category_id": "modifier",
      "name_zh": "修饰器与跨玩法联合",
      "display_order": 70,
      "source_categories": [
        "modifier",
        "interaction"
      ],
      "description_zh": "Collect、符号变形、Wild、倍率及有原版依赖证据的跨玩法联合体验。"
    }
  ],
  "coverage_policy": {
    "policy_id": "metric-coverage.v2",
    "unique_owner_required": true,
    "profile_match_uses_mechanic_id_and_standard_attributes": true,
    "primary_and_guard_metrics_required_when_applicable": true,
    "derived_metrics_must_be_audit": true,
    "audit_score_weight_must_be_zero": true,
    "score_budget_key_unique_within_semantic_scope": true,
    "scope_instances_do_not_increase_score_budget": true,
    "raw_joint_and_scored_marginals_forbidden": true,
    "interaction_dependency_evidence_required": true,
    "summary_must_cover_every_metric_id": true,
    "summary_update_required_on_catalog_change": true
  },
