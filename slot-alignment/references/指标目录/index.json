{
  "schema_version": "slot-alignment.metric-library.v7",
  "library_id": "slot-alignment-player-experience-metrics",
  "version": "7.0.0",
  "status": "active",
  "principles": {
    "top_level_categories_are_mutually_exclusive": true,
    "all_profile_matched_instances_receive_pre_candidate_evidence_decision": true,
    "all_active_formal_subitems_required": true,
    "formal_metric_waiver_allowed": false,
    "weights_allowed": true,
    "composite_score_allowed": true,
    "card_status_aggregation": "worst_subitem",
    "derived_values_are_audit_only": true
