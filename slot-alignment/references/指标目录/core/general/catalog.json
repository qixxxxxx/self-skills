  "metrics": [
    {
      "metric_id": "core.rtp.total",
      "name_zh": "总RTP",
      "owner": "core.general",
      "category": "core",
      "display_order": 10,
      "kind": "hard",
      "unit": "ratio",
      "scope_template": "mode×rtp_group",
      "measurement": "sum(paid_entry_total_win)/sum(real_bet)",
      "sample_unit": "paid_entry",
      "condition_on": "全部合格付费入口；投注与派奖使用同一货币和封顶口径",
      "normalization": "总派奖除以总真实投注",
      "applicability_rule": "全部游戏必需。",
      "missing_policy": "权威总RTP目标、投注或完整派奖任一缺失时阻塞FORMAL。",
      "capability_ids": [],
      "profile_match": {
        "always": true
      },
      "semantic_variable_id": "paid_entry.return_mean",
      "semantic_group": "core_return",
      "semantic_role": "guard_cross_check",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "core.rtp.component_contribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "与组件RTP贡献之和交叉校验；硬门禁不进入综合分。"
      },
      "display": {
        "description_zh": "衡量玩家长期每投注1单位平均返还多少。",
        "usage_scene_zh": "用于确认游戏总体返还水平符合权威RTP。",
        "target_meaning_zh": "目标值来自外部权威RTP，不从原版样本反推。",
        "display_unit": "%（返还率）"
      },
      "hard_gate_profile": {
        "method": "range_error",
        "tolerance_source": "task_contract",
        "confidence_required": true
      }
    },
    {
      "metric_id": "core.hit_rate.paid_entry",
      "name_zh": "完整付费入口中奖率",
      "owner": "core.general",
      "category": "core",
      "display_order": 20,
      "kind": "hard",
      "unit": "ratio",
      "scope_template": "mode×rtp_group",
      "measurement": "count(paid_entry_total_win>0)/paid_entry_count",
      "sample_unit": "paid_entry",
      "condition_on": "一次真实扣款入口及其完整后续状态链",
      "normalization": "有正回报入口数除以合格付费入口数",
      "applicability_rule": "全部存在付费入口的游戏必需。",
      "missing_policy": "无法把完整状态链归并到付费入口时阻塞FORMAL。",
      "capability_ids": [],
      "profile_match": {
        "always": true
      },
      "semantic_variable_id": "paid_entry.positive_return_rate",
      "semantic_group": "core_return",
      "semantic_role": "guard_cross_check",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "core.return_distribution.lt200"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "与完整回报中的0x概率交叉校验；作为业务硬门禁保留且不计分。"
      },
      "display": {
        "description_zh": "衡量一次付费入口最终获得任意正回报的概率。",
        "usage_scene_zh": "用于区分高频小奖和低频中奖体验。",
        "target_meaning_zh": "目标值统计完整付费入口总回报大于0的入口占比。",
        "display_unit": "%（付费入口占比）"
      },
      "hard_gate_profile": {
        "method": "absolute_error",
        "tolerance_source": "task_contract",
        "confidence_required": true
      }
    },
    {
      "metric_id": "core.feature.natural_trigger_rate",
      "name_zh": "Feature自然触发率",
      "owner": "core.general",
      "category": "core",
      "display_order": 30,
      "kind": "hard",
      "unit": "ratio",
      "scope_template": "feature:*×entry_source_domain",
      "measurement": "count(distinct eligible_paid_entry_id with at least one endogenous game-rule entry into specified_feature)/eligible_paid_entry_count",
      "sample_unit": "paid_entry",
      "condition_on": "全部合格付费入口；每个入口按是否至少通过画像声明的任一endogenous来源进入指定Feature记为1或0；购买、强制测试、测试注入、运营覆盖和其他外生入口排除",
      "normalization": "至少通过任一游戏内生来源进入指定Feature的合格付费入口数除以全部合格付费入口数；同一入口通过同一或多个内生来源进入多次仍只计1",
      "applicability_rule": "Feature画像至少声明一个endogenous入口来源时每个Feature实例必需。",
      "missing_policy": "入口来源内生/外生分类、Feature边界或多个Feature事件无法归并到唯一付费入口时阻塞FORMAL。",
      "capability_ids": [],
      "profile_match": {
        "always": true
      },
      "semantic_variable_id": "feature.natural_entry_rate",
      "semantic_group": "core_trigger",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "trigger.entry_source_distribution"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "无；本指标为该语义变量的唯一Owner。"
      },
      "display": {
        "description_zh": "衡量每个合格付费入口是否至少通过一种游戏内生规则进入指定Feature的概率。",
        "usage_scene_zh": "用于控制免费旋转、重转等奖励玩法的自然稀有程度。",
        "target_meaning_zh": "目标值统计全部合格付费入口中至少通过任一内生来源进入对应Feature的入口比例；同一入口由一个或多个内生来源进入多次仍只计1，外生入口不计。",
        "display_unit": "%（付费入口占比）"
      },
      "hard_gate_profile": {
        "method": "absolute_error",
        "tolerance_source": "task_contract",
        "confidence_required": true
      }
    },
    {
      "metric_id": "core.return_distribution.lt200",
      "name_zh": "200x以下付费入口回报分布",
      "owner": "core.general",
      "category": "core",
      "display_order": 40,
      "kind": "hard",
      "unit": "distribution",
      "scope_template": "mode×rtp_group",
      "measurement": "P(sealed return bucket | paid_entry_return_multiple < 200x)",
      "sample_unit": "paid_entry_below_200x",
      "condition_on": "完整付费入口回报倍数小于200x的子样本，含0x",
      "normalization": "在<200x子样本内归一化为1；使用密封的实际回报倍率桶位置，并按log10(1+x)固定尺度计算有序距离",
      "applicability_rule": "全部游戏必需；固定桶边界在候选出现前密封。",
      "missing_policy": "任一固定桶、子样本分母或完整入口回报缺失时阻塞FORMAL。",
      "capability_ids": [],
      "profile_match": {
        "always": true
      },
      "semantic_variable_id": "paid_entry.return_distribution_below_200x",
      "semantic_group": "core_return",
      "semantic_role": "primary",
      "relationships": {
        "derived_from": [],
        "cross_checks_with": [
          "core.hit_rate.paid_entry",
          "core.long_tail.audit"
        ],
        "marginal_of": [],
        "conditional_on_metric": [],
        "overlap_reason_zh": "与入口中奖率交叉检查0x结构，但本指标按<200x子样本条件归一，二者不能互相替代。"
      },
      "display": {
        "description_zh": "衡量200倍投注额以下的完整入口回报落在哪些倍率区间。",
        "usage_scene_zh": "用于控制零回报、小奖、中等奖的主体分布形状，并让相邻倍率桶偏差小于跨越多个数量级的偏差。",
        "target_meaning_zh": "每个目标值统计在回报低于200x的入口中，落入对应倍率桶的比例。",
        "display_unit": "%（<200x入口条件占比）",
        "axis_unit": "倍投注额（x）"
      },
      "hard_gate_profile": {
        "method": "wasserstein_1d",
        "bin_positions_source": "task_contract",
        "axis_semantics": "nonnegative_multiplicative",
        "position_transform": "log10_1p",
        "distance_normalization": "fixed_transform_unit",
        "distance_scale": 1,
        "distance_unit": "log10_decade",
        "tolerance_source": "task_contract",
        "confidence_required": true
      }
    },
