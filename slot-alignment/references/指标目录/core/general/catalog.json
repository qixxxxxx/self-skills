      },
      "display": {
        "description_zh": "衡量回报围绕平均值波动有多大。",
        "usage_scene_zh": "用于识别RTP相同但风险和波动体验明显不同的游戏。",
        "target_meaning_zh": "目标值是对应作用域回报倍数的总体标准差。",
        "display_unit": "倍投注额（x）"
      },
      "hard_gate_profile": {
