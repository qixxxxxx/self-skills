{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v7 Alignment Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "mode",
    "status",
    "metric_contract_sha256",
    "certified_script_sha256",
    "baseline_runtime_bundle_sha256",
    "candidate_ledger",
    "search",
    "selected_candidate",
    "formal_plan",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "slot-alignment.alignment-manifest.v7"},
    "task_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "status": {"enum": ["READY_FOR_FORMAL", "EXHAUSTED_NOT_PASS", "COMPLETED"]},
    "metric_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "certified_script_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "adapter_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "baseline_runtime_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "candidate_ledger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "candidate_count"],
      "properties": {
        "path": {"const": "work/candidate_ledger.jsonl"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "candidate_count": {"type": "integer", "minimum": 1}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stages_used", "authorized_parameter_ids", "attempted_parameter_ids", "ranking_rule", "termination_reason_zh"],
      "properties": {
        "stages_used": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["PROBE", "SCREEN", "REFINE", "FINAL"]}
        },
        "authorized_parameter_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "attempted_parameter_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "ranking_rule": {"const": "failures_then_unknown_then_deviation_then_candidate_id"},
        "termination_reason_zh": {"type": "string", "minLength": 1}
      }
    },
    "selected_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "parameter_sha256", "runtime_bundle_sha256", "runtime_path", "runtime_files"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "parameter_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "runtime_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "runtime_path": {"const": "work/selected/runtime"},
        "runtime_files": {"$ref": "#/$defs/runtime_files"}
      }
    },
    "formal_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paid_entry_count", "seed_plan_sha256", "independent_seed", "uses_candidate_measurements"],
      "properties": {
        "paid_entry_count": {"type": "integer", "minimum": 1},
        "seed_plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "independent_seed": {"const": true},
        "uses_candidate_measurements": {"const": false}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "runtime_files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256"],
        "properties": {
          "name": {"enum": ["game_core.json", "payout_config.json", "reel_config.json", "symbol_catalog.json"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    }
  }
}
