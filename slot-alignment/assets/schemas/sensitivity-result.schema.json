{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Sensitivity Result v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "sensitivity_plan_sha256", "metric_contract_sha256", "runtime_bundle_sha256", "status", "observations", "completed_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.sensitivity-result.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "sensitivity_plan_sha256": {"$ref": "#/$defs/sha256"},
    "metric_contract_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["completed", "invalidated"]},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "direction_zh", "impact_by_metric", "risk_zh", "recommended_search_layer"],
      "properties": {
        "parameter_id": {"type": "string", "minLength": 1},
        "direction_zh": {"type": "string", "minLength": 1},
        "impact_by_metric": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number"}},
        "risk_zh": {"type": "string", "minLength": 1},
        "recommended_search_layer": {"type": "string", "minLength": 1}
      }
    }
  }
}
