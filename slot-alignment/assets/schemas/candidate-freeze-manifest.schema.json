{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Candidate Freeze Manifest v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "candidate_id", "status", "parameter_record", "parameter_sha256", "runtime_bundle_sha256", "runtime_files", "metric_contract_sha256", "script_bundle_sha256", "runtime_capability_matrix_sha256", "independent_recheck", "frozen_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.candidate-freeze-manifest.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "status": {"const": "READY_FOR_FORMAL"},
    "parameter_record": {"$ref": "#/$defs/record"},
    "parameter_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_files": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/runtime_file"}},
    "metric_contract_sha256": {"$ref": "#/$defs/sha256"},
    "script_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_capability_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "independent_recheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paid_entries", "seed_independent", "measurements", "alignment_result", "status"],
      "properties": {
        "paid_entries": {"const": 2000000},
        "seed_independent": {"const": true},
        "measurements": {"$ref": "#/$defs/record"},
        "alignment_result": {"$ref": "#/$defs/record"},
        "status": {"enum": ["通过", "不通过", "无法完整判定"]}
      }
    },
    "frozen_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "runtime_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"enum": ["game_core.json", "payout_config.json", "reel_config.json", "symbol_catalog.json"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
