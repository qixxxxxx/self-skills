{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preflight Metric Extension Proposal",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "status", "decision_window", "blocks_stage_execution", "blocks_formal_execution", "gaps", "required_deliverables", "approval"],
  "properties": {
    "schema_version": {"const": "slot-alignment.metric-extension-proposal.v1"},
    "task_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["待用户决定", "已批准", "已拒绝", "已完成", "无需扩展"]},
    "decision_window": {"const": "preflight"},
    "blocks_stage_execution": {"type": "boolean"},
    "blocks_formal_execution": {"type": "boolean"},
    "gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["gap_id", "gap_type", "package_id", "mechanic_ids", "source_node_ids", "reason", "proposed_action", "extension_targets", "decision_status"],
        "properties": {
          "gap_id": {"type": "string", "pattern": "^metric-gap-[0-9]{3}$"},
          "gap_type": {"enum": ["unknown_mechanic_profile", "unknown_required_package", "no_effective_metric_owner"]},
          "package_id": {"type": ["string", "null"]},
          "mechanic_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "source_node_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1},
          "proposed_action": {"type": "string", "minLength": 1},
          "extension_targets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["mechanic_catalog", "metric_library", "measurement_contract", "report_display"]}},
          "decision_status": {"const": "待用户决定"}
        }
      }
    },
    "required_deliverables": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "user_decision", "decided_at"],
      "properties": {
        "status": {"enum": ["待确认", "已批准", "已拒绝", "不适用"]},
        "user_decision": {"type": "string"},
        "decided_at": {"type": "string"}
      }
    }
  }
}
