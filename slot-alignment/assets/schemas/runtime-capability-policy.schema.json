{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v7 Script Runtime Capability Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "status", "authority", "authorized_at", "source_path", "implementation_sources", "rules", "required_bindings"],
  "properties": {
    "schema_version": {"const": "slot-alignment.runtime-capability-policy.v7"},
    "policy_id": {"const": "slot-alignment-script-runtime-capability-v7"},
    "version": {"const": "7.0.0"},
    "status": {"const": "已授权"},
    "authority": {"const": "用户"},
    "authorized_at": {"type": "string", "format": "date"},
    "source_path": {"const": "assets/policies/runtime_capability_policy.json"},
    "implementation_sources": {"const": ["sealed_runtime", "user_certified_python_script"]},
    "rules": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "boolean"}},
    "required_bindings": {"const": ["runtime_bundle_sha256", "certified_script_sha256", "parameter_authority_sha256"]}
  }
}
