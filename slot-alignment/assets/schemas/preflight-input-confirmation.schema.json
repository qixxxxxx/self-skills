{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Preflight Input Confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status",
    "decision_window",
    "confirmed_by",
    "confirmed_at",
    "confirmation_evidence_path",
    "confirmation_evidence_sha256",
    "sample_count",
    "python_script"
  ],
  "properties": {
    "status": {"enum": ["未开始", "待用户确认", "通过", "阻塞"]},
    "decision_window": {"const": "preflight"},
    "confirmed_by": {"type": "string"},
    "confirmed_at": {"type": "string"},
    "confirmation_evidence_path": {"type": "string"},
    "confirmation_evidence_sha256": {"type": "string"},
    "sample_count": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discovered_source_count",
        "discovered_entry_count",
        "source_samples_sha256",
        "recount_requested",
        "recount_scope",
        "recount_status",
        "all_discovered_sources_processed",
        "processed_source_count",
        "recounted_entry_count",
        "recount_result_path",
        "recount_result_sha256",
        "effective_entry_count",
        "user_confirmed_entry_count"
      ],
      "properties": {
        "discovered_source_count": {"type": "integer", "minimum": 0},
        "discovered_entry_count": {"type": "integer", "minimum": 0},
        "source_samples_sha256": {"type": "string"},
        "recount_requested": {"type": "boolean"},
        "recount_scope": {"const": "all_discovered_sources"},
        "recount_status": {"enum": ["不要求", "待执行", "进行中", "已完成", "失败"]},
        "all_discovered_sources_processed": {"type": "boolean"},
        "processed_source_count": {"type": "integer", "minimum": 0},
        "recounted_entry_count": {"type": ["integer", "null"], "minimum": 0},
        "recount_result_path": {"type": "string"},
        "recount_result_sha256": {"type": "string"},
        "effective_entry_count": {"type": "integer", "minimum": 0},
        "user_confirmed_entry_count": {"type": "integer", "minimum": 0}
      }
    },
    "python_script": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "confirmed_name", "confirmed_path", "confirmed_sha256"],
      "properties": {
        "status": {"enum": ["未开始", "待用户确认", "通过", "阻塞"]},
        "confirmed_name": {"type": "string"},
        "confirmed_path": {"type": "string"},
        "confirmed_sha256": {"type": "string"}
      }
    }
  }
}
