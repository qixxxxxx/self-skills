{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Metric Contract External Data",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "slot-alignment.contract-data.v1"},
    "keysets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["keyset_id", "keys"],
        "properties": {
          "keyset_id": {"type": "string", "pattern": "^ks_[0-9a-f]{24}$"},
          "keys": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["ref_id", "instance_id", "value"],
        "properties": {
          "ref_id": {"type": "string", "minLength": 1},
          "instance_id": {"type": "string", "pattern": "^mi_[0-9a-f]{24}$"},
          "value": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["$encoding", "keyset_id", "values"],
                "properties": {
                  "$encoding": {"const": "object_values.v1"},
                  "keyset_id": {"type": "string", "pattern": "^ks_[0-9a-f]{24}$"},
                  "values": {"type": "array"}
                }
              },
              {
                "not": {
                  "type": "object",
                  "required": ["$encoding"],
                  "properties": {"$encoding": {"const": "object_values.v1"}}
                }
              }
            ]
          }
        }
      }
    }
  }
}
