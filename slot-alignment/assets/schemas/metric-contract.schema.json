{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v5 Metric Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_version", "report_contract_version", "task_id", "mode", "rtp_group", "frozen_before_candidate", "metric_library", "policies", "cards", "audits", "hashes"],
  "properties": {
    "schema_version": {"const": "slot-alignment.metric-contract.v5"},
    "contract_version": {"type": "string", "minLength": 1},
    "report_contract_version": {"const": "slot-alignment.report.v5"},
    "task_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "rtp_group": {"const": 1},
    "frozen_before_candidate": {"const": true},
    "metric_library": {"$ref": "#/$defs/binding"},
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hard_gate_tolerance", "alignment_evaluation", "sample_execution", "runtime_capability"],
      "properties": {
        "hard_gate_tolerance": {"$ref": "#/$defs/binding"},
        "alignment_evaluation": {"$ref": "#/$defs/binding"},
        "sample_execution": {"$ref": "#/$defs/binding"},
        "runtime_capability": {"$ref": "#/$defs/binding"}
      }
    },
    "cards": {"type": "array", "minItems": 13, "maxItems": 13, "items": {"$ref": "#/$defs/card"}},
    "audits": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"$ref": "#/$defs/audit"}},
    "hashes": {
      "type": "object",
      "required": ["runtime_bundle_sha256", "original_evidence_sha256", "script_sha256", "game_profile_sha256", "parameter_authority_sha256", "sample_execution_plan_sha256", "runtime_capability_matrix_sha256", "contract_sha256"],
      "additionalProperties": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "distance": {
      "type": "object",
      "required": ["method"],
      "properties": {
        "method": {"enum": ["range_error", "relative_error", "absolute_probability_error", "absolute_error", "total_variation", "wasserstein_1d", "structural_wasserstein"]},
        "bin_positions": {"type": "array", "minItems": 2, "items": {"type": "number"}},
        "axis_semantics": {"enum": ["natural_linear", "nonnegative_multiplicative"]},
        "position_transform": {"enum": ["identity", "log10_1p"]},
        "support_span": {"type": "number", "exclusiveMinimum": 0},
        "ground_cost": {"type": "string", "minLength": 1},
        "state_kind": {"enum": ["symbol_position_density", "board_shape"]},
        "board_shape": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "self_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["quantile", "joint", "replicates", "seed", "evidence_sha256"],
      "properties": {
        "quantile": {"const": 0.99},
        "joint": {"const": true},
        "replicates": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "tolerance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "base", "factor", "effective"],
      "properties": {
        "source": {"enum": ["hard_gate_player_budget", "j_player_visible_budget", "sealed_original_joint_self_comparison", "deterministic_exact"]},
        "base": {"type": "number", "minimum": 0},
        "factor": {"type": "number", "exclusiveMinimum": 0},
        "effective": {"type": "number", "minimum": 0},
        "self_comparison": {"$ref": "#/$defs/self_comparison"}
      }
    },
    "instance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance_id", "facet_id", "subitem_id", "scope", "sample_unit", "measurement", "target_source", "target", "distance", "tolerance", "status"],
      "properties": {
        "instance_id": {"type": "string", "pattern": "^[NJPB][1-9][0-9]*\\.[a-z0-9_.:-]+$"},
        "facet_id": {"type": "string", "minLength": 1},
        "subitem_id": {"type": "string", "minLength": 1},
        "scope": {"type": "object"},
        "sample_unit": {"type": "string", "minLength": 1},
        "measurement": {"type": "string", "minLength": 1},
        "target_source": {"type": "object", "minProperties": 1},
        "target": {},
        "distance": {"$ref": "#/$defs/distance"},
        "tolerance": {"$ref": "#/$defs/tolerance"},
        "aggregation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dimension_id", "group_id", "mode", "role"],
          "properties": {
            "dimension_id": {"type": "string", "minLength": 1},
            "group_id": {"type": "string", "minLength": 1},
            "mode": {"enum": ["mean_items", "half_overall_half_items"]},
            "role": {"enum": ["item", "bin", "overall"]}
          }
        },
        "status": {"enum": ["active", "不适用"]},
        "inapplicability_reason": {"type": "string", "minLength": 1}
      }
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["card_id", "name_zh", "category_id", "kind", "status", "instances"],
      "properties": {
        "card_id": {"pattern": "^[NJPB][1-9][0-9]*$"},
        "name_zh": {"type": "string", "minLength": 1},
        "category_id": {"enum": ["N", "J", "P", "B"]},
        "kind": {"enum": ["hard_gate", "alignment"]},
        "status": {"enum": ["active", "不适用"]},
        "instances": {"type": "array", "items": {"$ref": "#/$defs/instance"}}
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["audit_id", "name_zh", "source_cards", "measurement", "required"],
      "properties": {
        "audit_id": {"pattern": "^A[1-9][0-9]*$"},
        "name_zh": {"type": "string", "minLength": 1},
        "source_cards": {"type": "array", "minItems": 1, "items": {"pattern": "^[NJPB][1-9][0-9]*$"}},
        "measurement": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"}
      }
    }
  }
}
