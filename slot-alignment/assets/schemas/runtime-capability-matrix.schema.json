{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Runtime Capability Matrix v6",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_id",
    "mode",
    "rtp_group",
    "frozen_before_candidate",
    "policy",
    "runtime_bundle_sha256",
    "certified_script_sha256",
    "parameter_authority_sha256",
    "capabilities",
    "summary"
  ],
  "properties": {
    "schema_version": {"const": "slot-alignment.runtime-capability-matrix.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "rtp_group": {"const": 1},
    "frozen_before_candidate": {"const": true},
    "policy": {"$ref": "#/$defs/policy_binding"},
    "runtime_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "certified_script_sha256": {"$ref": "#/$defs/sha256"},
    "parameter_authority_sha256": {"$ref": "#/$defs/sha256"},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/capability"}
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["total_capabilities", "authorized_capabilities", "fully_covered_capabilities", "coverage_status"],
      "properties": {
        "total_capabilities": {"type": "integer", "minimum": 1},
        "authorized_capabilities": {"type": "integer", "minimum": 0},
        "fully_covered_capabilities": {"type": "integer", "minimum": 0},
        "coverage_status": {"enum": ["通过", "不通过"]}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "policy_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "path", "sha256"],
      "properties": {
        "id": {"const": "slot-alignment-runtime-capability-coverage-v6"},
        "version": {"const": "6.0.0"},
        "path": {"const": "assets/policies/runtime_capability_policy.json"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["supported", "unsupported", "not_applicable"]},
        "min_cardinality": {"type": "integer", "minimum": 0},
        "max_cardinality": {"type": "integer", "minimum": 0},
        "selection_scope": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "operations", "evidence"],
      "properties": {
        "status": {"enum": ["authorized", "locked", "not_applicable"]},
        "min_cardinality": {"type": "integer", "minimum": 0},
        "max_cardinality": {"type": "integer", "minimum": 0},
        "operations": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "exemption": {"enum": ["explicit_user_lock", "server_runtime_not_deliverable", "pre_candidate_mathematical_irrelevance_proof", "game_profile_not_applicable"]},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "optimizer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "exposed_parameters", "sensitivity_plan_ids", "evidence"],
      "properties": {
        "status": {"enum": ["supported", "unsupported", "not_applicable"]},
        "min_cardinality": {"type": "integer", "minimum": 0},
        "max_cardinality": {"type": "integer", "minimum": 0},
        "exposed_parameters": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sensitivity_plan_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "equivalence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["passed", "pending", "failed", "not_applicable"]},
        "evidence_sha256": {"$ref": "#/$defs/sha256"},
        "evidence": {"$ref": "#/$defs/evidence"}
      }
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability_id",
        "name_zh",
        "category",
        "certified_script",
        "server_runtime",
        "authorization",
        "candidate_generator",
        "calibration_simulator",
        "formal_simulator",
        "optimizer",
        "equivalence"
      ],
      "properties": {
        "capability_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name_zh": {"type": "string", "minLength": 1},
        "category": {"enum": ["routing", "reel_generation", "refill", "height", "feature_weight", "other"]},
        "certified_script": {"$ref": "#/$defs/layer"},
        "server_runtime": {"$ref": "#/$defs/layer"},
        "authorization": {"$ref": "#/$defs/authorization"},
        "candidate_generator": {"$ref": "#/$defs/layer"},
        "calibration_simulator": {"$ref": "#/$defs/layer"},
        "formal_simulator": {"$ref": "#/$defs/layer"},
        "optimizer": {"$ref": "#/$defs/optimizer"},
        "equivalence": {"$ref": "#/$defs/equivalence"}
      }
    }
  }
}
