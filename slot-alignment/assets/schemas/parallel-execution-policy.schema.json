{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Deterministic Parallel Execution Policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "source_path",
    "worker_count_mode",
    "cpu_count_source",
    "cpu_fraction",
    "rounding",
    "minimum_workers",
    "backend",
    "parallelism_scope",
    "candidate_parallelism_enabled",
    "nested_process_pools_enabled",
    "total_sample_budget_unchanged",
    "shard_plan_sealed_before_execution",
    "shard_assignment",
    "rng_partition_key",
    "worker_id_affects_rng",
    "merge_order",
    "merge_level",
    "derived_metrics_after_merge",
    "failed_worker_action",
    "single_worker_equivalence_required",
    "same_shard_plan_for_equivalence_check",
    "formal_independence_source",
    "worker_count_affects_formal_independence"
  ],
  "properties": {
    "schema_version": {"const": "slot-alignment.parallel-execution-policy.v1"},
    "policy_id": {"const": "deterministic-single-candidate-sample-sharding-v1"},
    "version": {"const": "1.0.0"},
    "source_path": {"const": "assets/policies/parallel_execution_policy.v1.json"},
    "worker_count_mode": {"const": "auto"},
    "cpu_count_source": {"const": "process_available_logical_cpu"},
    "cpu_fraction": {"const": 0.7},
    "rounding": {"const": "floor"},
    "minimum_workers": {"const": 1},
    "backend": {"const": "process"},
    "parallelism_scope": {"const": "single_candidate_sample_shards"},
    "candidate_parallelism_enabled": {"const": false},
    "nested_process_pools_enabled": {"const": false},
    "total_sample_budget_unchanged": {"const": true},
    "shard_plan_sealed_before_execution": {"const": true},
    "shard_assignment": {"const": "contiguous_global_entry_ranges"},
    "rng_partition_key": {"const": "sealed_seed_and_global_entry_index"},
    "worker_id_affects_rng": {"const": false},
    "merge_order": {"const": "shard_index_ascending"},
    "merge_level": {"const": "raw_accumulators"},
    "derived_metrics_after_merge": {"const": true},
    "failed_worker_action": {"const": "rerun_original_shard_only"},
    "single_worker_equivalence_required": {"const": true},
    "same_shard_plan_for_equivalence_check": {"const": true},
    "formal_independence_source": {"const": "sealed_seed_and_sample_plan"},
    "worker_count_affects_formal_independence": {"const": false}
  }
}
