{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Parameter Authority v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "frozen_before_candidate", "status", "default_rules", "parameters", "placeholders", "authorized_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.parameter-authority.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "frozen_before_candidate": {"const": true},
    "status": {"enum": ["READY", "PENDING_USER_INPUT"]},
    "default_rules": {
      "const": {
        "reel_strip_weight_changes_authorized": true,
        "reel_axis_geometry_symbol_domain_and_game_semantics_locked": true,
        "structure_change_requires_explicit_user_authorization": true
      }
    },
    "parameters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/parameter"}},
    "placeholders": {"type": "array", "items": {"$ref": "#/$defs/placeholder"}},
    "authorized_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "READY"}}}, "then": {"properties": {"placeholders": {"maxItems": 0}}}}
  ],
  "$defs": {
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "name_zh", "runtime_path", "value_type", "authorization", "operations", "structure_change", "evidence_refs"],
      "properties": {
        "parameter_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]*$"},
        "name_zh": {"type": "string", "minLength": 1},
        "runtime_path": {"type": "string", "minLength": 1},
        "value_type": {"enum": ["number", "integer", "category", "integer_weights", "float_weights", "reel_strip"]},
        "authorization": {"enum": ["authorized", "locked"]},
        "operations": {"type": "array", "uniqueItems": true, "items": {"enum": ["set", "scale", "reorder", "repeat_symbols", "change_stop_weights", "select_existing"]}},
        "minimum": {"type": "number"},
        "maximum": {"type": "number"},
        "allowed_values": {"type": "array", "minItems": 1},
        "structure_change": {"type": "boolean"},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "reason_zh", "owner", "blocks"],
      "properties": {
        "parameter_id": {"type": "string", "minLength": 1},
        "reason_zh": {"type": "string", "minLength": 1},
        "owner": {"const": "用户"},
        "blocks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
