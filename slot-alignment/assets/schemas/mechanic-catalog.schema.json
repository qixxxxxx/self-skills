{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Mechanic Catalog",
  "type": "object",
  "required": ["schema_version", "catalog_type", "package_id", "category", "version", "mechanics"],
  "properties": {
    "schema_version": {"$ref": "#/$defs/non_empty_string"},
    "catalog_type": {"const": "mechanic_package"},
    "package_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "category": {"enum": ["settlement", "board", "evolution", "feature", "trigger", "modifier", "award", "state"]},
    "version": {"$ref": "#/$defs/non_empty_string"},
    "mechanics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mechanic"}}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "string_array": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/non_empty_string"}},
    "conditional_package": {
      "type": "object",
      "required": ["package_id", "when"],
      "properties": {
        "package_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "when": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "metric_requirements": {
      "type": "object",
      "required": ["required_packages", "conditional_packages"],
      "properties": {
        "required_packages": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}},
        "conditional_packages": {"type": "array", "items": {"$ref": "#/$defs/conditional_package"}}
      }
    },
    "mechanic": {
      "type": "object",
      "required": ["mechanic_id", "name_zh", "display_order", "definition", "required_attributes", "optional_attributes", "evidence_signatures", "exclusions", "metric_requirements"],
      "properties": {
        "mechanic_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "name_zh": {"$ref": "#/$defs/non_empty_string"},
        "display_order": {"type": "integer", "minimum": 0},
        "definition": {"$ref": "#/$defs/non_empty_string"},
        "required_attributes": {"$ref": "#/$defs/string_array"},
        "optional_attributes": {"$ref": "#/$defs/string_array"},
        "evidence_signatures": {"$ref": "#/$defs/string_array"},
        "exclusions": {"$ref": "#/$defs/string_array"},
        "metric_requirements": {"$ref": "#/$defs/metric_requirements"}
      }
    }
  }
}
