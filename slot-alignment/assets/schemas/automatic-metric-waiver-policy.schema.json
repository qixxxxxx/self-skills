{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Automatic Metric Waiver Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "source_path", "legacy_contracts_unchanged", "authorization_source", "allowed_reason_codes", "allowed_metric_kinds", "rules"],
  "properties": {
    "schema_version": {"const": "slot-alignment.automatic-metric-waiver-policy.v1"},
    "policy_id": {"const": "automatic-metric-waiver-v1"},
    "version": {"const": "1.0.0"},
    "status": {"type": "string"},
    "source_path": {"const": "assets/policies/automatic_metric_waiver_policy.v1.json"},
    "legacy_contracts_unchanged": {"const": true},
    "authorization_source": {"const": "user_pre_authorized_skill_policy"},
    "allowed_reason_codes": {
      "const": ["AUTO_WAIVED_INSUFFICIENT_DATA", "AUTO_WAIVED_STRUCTURALLY_UNATTAINABLE"]
    },
    "allowed_metric_kinds": {"const": ["hard", "score", "audit"]},
    "rules": {"type": "object", "minProperties": 10, "additionalProperties": {"const": true}}
  }
}
