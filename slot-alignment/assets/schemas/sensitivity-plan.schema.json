{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Sensitivity Plan v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "metric_contract_sha256", "parameter_authority_sha256", "runtime_bundle_sha256", "fixed_seed", "parameters", "created_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.sensitivity-plan.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "metric_contract_sha256": {"$ref": "#/$defs/sha256"},
    "parameter_authority_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "fixed_seed": {"type": "integer", "minimum": 0},
    "parameters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "runtime_path", "parameter_type", "perturbation", "expected_metric_ids", "search_layer"],
      "properties": {
        "parameter_id": {"type": "string", "minLength": 1},
        "runtime_path": {"type": "string", "minLength": 1},
        "parameter_type": {"enum": ["continuous", "integer", "category", "structured_weight", "reel_strip"]},
        "perturbation": {"type": "object", "minProperties": 1},
        "expected_metric_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "search_layer": {"type": "string", "minLength": 1}
      }
    }
  }
}
