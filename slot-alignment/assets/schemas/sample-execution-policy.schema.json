{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v7 Sample Execution Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "status", "authority", "authorized_at", "source_path", "sample_unit", "user_confirmation_required", "rng_protocol", "calibration_defaults", "formal_defaults", "execution"],
  "properties": {
    "schema_version": {"const": "slot-alignment.sample-execution-policy.v7"},
    "policy_id": {"const": "slot-alignment-light-sample-execution-v7"},
    "version": {"const": "7.0.0"},
    "status": {"const": "已授权"},
    "authority": {"const": "用户"},
    "authorized_at": {"type": "string", "format": "date"},
    "source_path": {"const": "assets/policies/sample_execution_policy.json"},
    "sample_unit": {"const": "complete_paid_entry"},
    "user_confirmation_required": {"const": true},
    "rng_protocol": {"type": "object", "minProperties": 1},
    "calibration_defaults": {"type": "object", "minProperties": 1},
    "formal_defaults": {"type": "object", "minProperties": 1},
    "execution": {"type": "object", "minProperties": 1}
  }
}
