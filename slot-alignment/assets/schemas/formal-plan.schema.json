{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Formal Plan v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "batch_id", "candidate_id", "freeze_manifest_sha256", "metric_contract_sha256", "sample_execution_plan_sha256", "runtime_bundle_sha256", "script_bundle_sha256", "selected_paid_entry_count", "base_seed", "independent_from_calibration", "shards", "created_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.formal-plan.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "pattern": "^fv[0-9]{4}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "freeze_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "metric_contract_sha256": {"$ref": "#/$defs/sha256"},
    "sample_execution_plan_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "script_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "selected_paid_entry_count": {"enum": [10000000, 20000000, 50000000]},
    "base_seed": {"type": "integer", "minimum": 0},
    "independent_from_calibration": {"const": true},
    "shards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/shard"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "shard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shard_index", "entry_start", "entry_count", "shard_seed", "path"],
      "properties": {
        "shard_index": {"type": "integer", "minimum": 0},
        "entry_start": {"type": "integer", "minimum": 0},
        "entry_count": {"type": "integer", "minimum": 1, "maximum": 250000},
        "shard_seed": {"type": "integer", "minimum": 0},
        "path": {"type": "string", "pattern": "^work/formal/fv[0-9]{4}/shards/shard-[0-9]{6}\\.json$"}
      }
    }
  }
}
