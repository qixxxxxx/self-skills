{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v5 Joint Self Comparison",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "quantile", "joint", "replicates", "seed", "evidence_sha256", "joint_factor", "tolerances"],
  "properties": {
    "schema_version": {"const": "slot-alignment.joint-self-comparison.v5"},
    "quantile": {"const": 0.99},
    "joint": {"const": true},
    "replicates": {"type": "integer", "minimum": 1},
    "seed": {"type": "integer", "minimum": 0},
    "evidence_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "joint_factor": {"type": "number", "minimum": 1.0},
    "tolerances": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "number", "minimum": 0}
    }
  }
}
