{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Calibration Batch Manifest v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "batch_id", "search_layer_id", "stage", "cumulative_paid_entries", "metric_contract_sha256", "sample_execution_plan_sha256", "runtime_capability_matrix_sha256", "status", "candidates", "completed_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.calibration-batch-manifest.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "pattern": "^cv[0-9]{4}$"},
    "search_layer_id": {"type": "string", "minLength": 1},
    "stage": {"enum": ["SCREEN", "REFINE", "FINAL"]},
    "cumulative_paid_entries": {"enum": [100000, 500000, 2000000]},
    "metric_contract_sha256": {"$ref": "#/$defs/sha256"},
    "sample_execution_plan_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_capability_matrix_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["completed", "invalidated"]},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}},
    "completed_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"stage": {"const": "SCREEN"}}}, "then": {"properties": {"cumulative_paid_entries": {"const": 100000}}}},
    {"if": {"properties": {"stage": {"const": "REFINE"}}}, "then": {"properties": {"cumulative_paid_entries": {"const": 500000}}}},
    {"if": {"properties": {"stage": {"const": "FINAL"}}}, "then": {"properties": {"cumulative_paid_entries": {"const": 2000000}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "rank": {
      "type": "object",
      "additionalProperties": false,
      "required": ["n_failures", "alignment_failures", "unknown_instances", "maximum_deviation_ratio", "deviation_ratio_sum", "candidate_id"],
      "properties": {
        "n_failures": {"type": "integer", "minimum": 0},
        "alignment_failures": {"type": "integer", "minimum": 0},
        "unknown_instances": {"type": "integer", "minimum": 0},
        "maximum_deviation_ratio": {"type": ["number", "null"], "minimum": 0},
        "deviation_ratio_sum": {"type": "number", "minimum": 0},
        "candidate_id": {"type": "string", "minLength": 1}
      }
    },
    "candidate": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_id", "parameter_record", "measurements", "alignment_result", "rank", "status"],
          "properties": {
            "candidate_id": {"type": "string", "minLength": 1},
            "parameter_record": {"$ref": "#/$defs/record"},
            "measurements": {"$ref": "#/$defs/record"},
            "alignment_result": {"$ref": "#/$defs/record"},
            "rank": {"$ref": "#/$defs/rank"},
            "status": {"const": "ranked"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["candidate_id", "status", "reason_zh", "proposed_changes"],
          "properties": {
            "candidate_id": {"type": "string", "minLength": 1},
            "status": {"enum": ["rejected_invalid_config", "invalidated"]},
            "reason_zh": {"type": "string", "minLength": 1},
            "proposed_changes": {"type": "array", "items": {"$ref": "#/$defs/parameter"}}
          }
        }
      ]
    },
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "runtime_path", "value"],
      "properties": {
        "parameter_id": {"type": "string", "minLength": 1},
        "runtime_path": {"type": "string", "minLength": 1},
        "value": {}
      }
    }
  }
}
