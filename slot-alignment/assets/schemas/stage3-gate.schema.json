{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v6 Stage3 Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "alignment_result_sha256", "status", "stage4_allowed", "baseline_final_status", "baseline_conclusion", "coverage_status", "reason_zh"],
  "properties": {
    "schema_version": {"const": "slot-alignment.stage3-gate.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "alignment_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"const": "通过"},
    "stage4_allowed": {"const": true},
    "baseline_final_status": {"enum": ["通过", "不通过", "无法完整判定"]},
    "baseline_conclusion": {"enum": ["完整范围通过", "有限范围通过", "不通过", "无法完整判定"]},
    "coverage_status": {"enum": ["完整", "有限"]},
    "reason_zh": {"type": "string", "minLength": 1}
  }
}
