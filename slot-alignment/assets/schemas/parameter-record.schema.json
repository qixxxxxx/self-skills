{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Candidate Parameter Record v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "batch_id", "candidate_id", "parameter_authority_sha256", "parent_candidate_id", "changes", "complete_parameters", "parameter_sha256", "runtime_bundle_sha256", "runtime_files", "created_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.parameter-record.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "batch_id": {"type": "string", "pattern": "^cv[0-9]{4}$"},
    "candidate_id": {"type": "string", "minLength": 1},
    "parameter_authority_sha256": {"$ref": "#/$defs/sha256"},
    "parent_candidate_id": {"type": ["string", "null"]},
    "changes": {"type": "array", "items": {"$ref": "#/$defs/parameter"}},
    "complete_parameters": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/parameter"}},
    "parameter_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "runtime_files": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/runtime_file"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_id", "runtime_path", "value"],
      "properties": {"parameter_id": {"type": "string", "minLength": 1}, "runtime_path": {"type": "string", "minLength": 1}, "value": {}}
    },
    "runtime_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "path", "sha256"],
      "properties": {
        "name": {"enum": ["game_core.json", "payout_config.json", "reel_config.json", "symbol_catalog.json"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
