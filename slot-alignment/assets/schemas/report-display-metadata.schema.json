{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Report Display Metadata",
  "type": "object",
  "required": ["schema_version", "metrics"],
  "properties": {
    "schema_version": {
      "const": "slot-alignment.report-display-metadata.v1"
    },
    "source": {
      "type": "string"
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["metric_id"],
        "properties": {
          "metric_id": {"type": "string", "minLength": 1},
          "scope": {"type": "string", "minLength": 1},
          "description_zh": {"type": "string", "minLength": 1},
          "usage_scene_zh": {"type": "string", "minLength": 1},
          "target_meaning_zh": {"type": "string", "minLength": 1},
          "display_unit": {"type": "string", "minLength": 1},
          "source_zh": {"type": "string", "minLength": 1},
          "item_labels": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "object_units": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          },
          "object_labels": {
            "type": "object",
            "additionalProperties": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
