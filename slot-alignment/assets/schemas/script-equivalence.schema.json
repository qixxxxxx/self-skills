{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Script Equivalence v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "runtime_bundle_sha256", "certified_script_sha256", "derived_script_bundle_sha256", "status", "checks", "evidence_files", "verified_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.script-equivalence.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "runtime_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "certified_script_sha256": {"$ref": "#/$defs/sha256"},
    "derived_script_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "status": {"enum": ["passed", "pending", "failed"]},
    "checks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "evidence_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}},
    "verified_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_id", "name_zh", "status", "evidence_refs"],
      "properties": {
        "check_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "name_zh": {"type": "string", "minLength": 1},
        "status": {"enum": ["passed", "pending", "failed"]},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "reason_zh": {"type": "string", "minLength": 1}
      }
    },
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    }
  }
}
