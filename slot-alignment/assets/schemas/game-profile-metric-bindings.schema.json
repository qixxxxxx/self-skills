{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v6 Game Profile Metric Bindings",
  "type": "object",
  "required": ["schema_version", "metric_bindings"],
  "properties": {
    "schema_version": {"const": "slot-alignment.game-profile.v6"},
    "metric_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "settlements", "win_groups", "continuous_settlements", "special_mechanics", "boards", "components", "sigma_scopes"],
      "properties": {
        "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
        "settlements": {"type": "array", "items": {"$ref": "#/$defs/settlement"}},
        "win_groups": {"type": "array", "items": {"$ref": "#/$defs/win_group"}},
        "continuous_settlements": {"type": "array", "items": {"$ref": "#/$defs/continuous"}},
        "special_mechanics": {"type": "array", "items": {"$ref": "#/$defs/mechanic"}},
        "boards": {"type": "array", "items": {"$ref": "#/$defs/board"}},
        "components": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/component"}},
        "sigma_scopes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "string_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "name_zh", "evidence_refs", "feature_type", "endogenous_entry", "entry_award_evaluation_mode", "duration_evaluation_mode", "duration_unit"],
      "properties": {
        "feature_id": {"$ref": "#/$defs/id"},
        "name_zh": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "feature_type": {"enum": ["free_spin", "respin", "hold_and_spin", "award_draw", "bonus_sequence", "other"]},
        "endogenous_entry": {"type": "boolean"},
        "entry_award_evaluation_mode": {"enum": ["not_applicable", "fixed_rule", "categorical_distribution"]},
        "entry_award_unit": {"$ref": "#/$defs/id"},
        "entry_award_bins": {"type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "duration_evaluation_mode": {"enum": ["fixed_rule", "summary_triplet"]},
        "duration_unit": {"enum": ["spin", "respin_step", "pick", "stage", "visible_action"]}
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settlement_id", "name_zh", "evidence_refs", "component_id", "settlement_type", "elements", "primary_size_axis", "variable_primary_size"],
      "properties": {
        "settlement_id": {"$ref": "#/$defs/id"},
        "name_zh": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "component_id": {"$ref": "#/$defs/id"},
        "settlement_type": {"enum": ["payline", "ways", "count_pay", "cluster", "full_screen", "other"]},
        "elements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "primary_size_axis": {"enum": ["matched_reels", "ways", "symbol_count", "cluster_cells", "cleared_cells", "custom"]},
        "variable_primary_size": {"type": "boolean"},
        "primary_size_evaluation_mode": {"enum": ["categorical_distribution", "summary_triplet"]},
        "primary_size_bins": {"type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "primary_size_unit": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "win_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "group_id", "name_zh", "evidence_refs", "role", "elements"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "group_id": {"$ref": "#/$defs/id"},
        "name_zh": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "role": {"enum": ["signature", "regular_high", "regular_low", "regular_other", "special"]},
        "elements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "continuous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continuous_id", "name_zh", "evidence_refs", "component_id", "variable_depth"],
      "properties": {
        "continuous_id": {"$ref": "#/$defs/id"},
        "name_zh": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "component_id": {"$ref": "#/$defs/id"},
        "variable_depth": {"type": "boolean"}
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "name_zh", "evidence_refs", "display_bet_basis", "variable_simultaneous_win_count", "variable_visible_step_reward"],
      "properties": {
        "component_id": {"$ref": "#/$defs/id"},
        "name_zh": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "display_bet_basis": {"$ref": "#/$defs/id"},
        "variable_simultaneous_win_count": {"type": "boolean"},
        "simultaneous_win_count_bins": {"type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "variable_visible_step_reward": {"type": "boolean"},
        "minimum_visible_reward_unit": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "mechanic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanic_id", "name_zh", "evidence_refs", "mechanic_family", "opportunity_unit", "result_evaluation_mode", "guaranteed_resolution", "result_states", "result_state_names_zh", "inactive_state_ids"],
      "properties": {
        "mechanic_id": {"$ref": "#/$defs/id"},
        "name_zh": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "mechanic_family": {"enum": ["multiplier_modifier", "collection_upgrade", "transform_replace", "expand_persist", "respin_special_result", "random_modifier_selection", "pick_wheel_path", "other"]},
        "opportunity_unit": {"enum": ["feature_spin", "positive_settlement_step", "feature_entry", "complete_feature", "pick", "respin_step", "visible_action", "other"]},
        "result_evaluation_mode": {"enum": ["fixed_rule", "categorical_distribution"]},
        "guaranteed_resolution": {"type": "boolean"},
        "result_states": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "result_state_names_zh": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {"type": "string", "minLength": 1}
        },
        "inactive_state_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board_scope_id", "name_zh", "evidence_refs", "component_id", "visual_phase", "rows", "columns", "shape_mode", "symbols", "symbol_groups", "key_symbol_profiles", "aggregation_profile", "reel_height_profiles"],
      "properties": {
        "board_scope_id": {"$ref": "#/$defs/id"},
        "name_zh": {"type": "string", "minLength": 1},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"},
        "component_id": {"$ref": "#/$defs/id"},
        "visual_phase": {"enum": ["initial", "cascade_visible"]},
        "rows": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "shape_mode": {"enum": ["fixed", "variable_reel_height"]},
        "symbols": {"$ref": "#/$defs/string_list"},
        "symbol_groups": {
          "type": "array",
          "minItems": 2,
          "maxItems": 4,
          "items": {"$ref": "#/$defs/symbol_group"}
        },
        "key_symbol_profiles": {
          "type": "array",
          "items": {"$ref": "#/$defs/key_symbol_profile"}
        },
        "aggregation_profile": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/aggregation_profile"}
          ]
        },
        "reel_height_profiles": {
          "type": "array",
          "items": {"$ref": "#/$defs/reel_height_profile"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"shape_mode": {"const": "fixed"}}},
          "then": {"properties": {"reel_height_profiles": {"maxItems": 0}}}
        },
        {
          "if": {"properties": {"shape_mode": {"const": "variable_reel_height"}}},
          "then": {"properties": {"reel_height_profiles": {"minItems": 1}}}
        }
      ]
    },
    "symbol_group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["group_id", "name_zh", "role", "symbols"],
      "properties": {
        "group_id": {"$ref": "#/$defs/id"},
        "name_zh": {"type": "string", "minLength": 1},
        "role": {"enum": ["signature", "regular_high", "regular_low", "regular_other"]},
        "symbols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "key_symbol_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["symbol_id", "count_bins", "sample_filter"],
      "properties": {
        "symbol_id": {"$ref": "#/$defs/id"},
        "count_bins": {"type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sample_filter": {"enum": ["all_stable_boards", "untriggered_only"]},
        "trigger_threshold": {"type": "integer", "minimum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"sample_filter": {"const": "untriggered_only"}}},
          "then": {"required": ["trigger_threshold"]}
        }
      ]
    },
    "aggregation_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aggregation_type", "symbol_ids", "bins", "sample_filter"],
      "properties": {
        "aggregation_type": {"enum": ["vertical_run", "max_connected_cluster", "max_concentrated_symbol_count", "custom"]},
        "symbol_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "bins": {"type": "array", "minItems": 2, "maxItems": 6, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sample_filter": {"enum": ["all_stable_boards", "non_winning_only"]}
      }
    },
    "reel_height_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reel_id", "bins"],
      "properties": {
        "reel_id": {"$ref": "#/$defs/id"},
        "bins": {"type": "array", "minItems": 2, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
