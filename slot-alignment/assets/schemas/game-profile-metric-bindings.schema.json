{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v5 Game Profile Metric Bindings",
  "type": "object",
  "required": ["schema_version", "metric_bindings"],
  "properties": {
    "schema_version": {"const": "slot-alignment.game-profile.v5"},
    "metric_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["features", "settlements", "continuous_settlements", "special_mechanics", "boards", "components", "sigma_scopes"],
      "properties": {
        "features": {"type": "array", "items": {"$ref": "#/$defs/feature"}},
        "settlements": {"type": "array", "items": {"$ref": "#/$defs/settlement"}},
        "continuous_settlements": {"type": "array", "items": {"$ref": "#/$defs/continuous"}},
        "special_mechanics": {"type": "array", "items": {"$ref": "#/$defs/mechanic"}},
        "boards": {"type": "array", "items": {"$ref": "#/$defs/board"}},
        "components": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "sigma_scopes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "string_list": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_id", "feature_type", "endogenous_entry"],
      "properties": {
        "feature_id": {"$ref": "#/$defs/id"},
        "feature_type": {"enum": ["free_spin", "respin", "hold_and_spin", "award_draw", "bonus_sequence", "other"]},
        "endogenous_entry": {"type": "boolean"}
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["settlement_id", "settlement_type", "elements", "paylines", "size_axes", "payout_mapping"],
      "properties": {
        "settlement_id": {"$ref": "#/$defs/id"},
        "settlement_type": {"enum": ["payline", "ways", "count_pay", "cluster", "full_screen", "other"]},
        "elements": {"$ref": "#/$defs/string_list"},
        "paylines": {"$ref": "#/$defs/string_list"},
        "size_axes": {"$ref": "#/$defs/string_list"},
        "payout_mapping": {"enum": ["deterministic", "variable"]}
      }
    },
    "continuous": {
      "type": "object",
      "additionalProperties": false,
      "required": ["continuous_id", "reachable_depths", "size_axes"],
      "properties": {
        "continuous_id": {"$ref": "#/$defs/id"},
        "reachable_depths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "size_axes": {"$ref": "#/$defs/string_list"}
      }
    },
    "mechanic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mechanic_id", "result_states", "inactive_state_ids"],
      "properties": {
        "mechanic_id": {"$ref": "#/$defs/id"},
        "result_states": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "inactive_state_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "required": ["board_scope_id", "rows", "columns", "variable_shape", "symbols", "spatial_symbols"],
      "properties": {
        "board_scope_id": {"$ref": "#/$defs/id"},
        "rows": {"type": "integer", "minimum": 1},
        "columns": {"type": "integer", "minimum": 1},
        "variable_shape": {"type": "boolean"},
        "symbols": {"$ref": "#/$defs/string_list"},
        "spatial_symbols": {"$ref": "#/$defs/string_list"}
      }
    }
  }
}
