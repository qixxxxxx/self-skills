{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Metric Catalog",
  "type": "object",
  "required": ["schema_version", "catalog_type", "package_id", "type", "category", "version", "applies_when", "metrics"],
  "properties": {
    "schema_version": {"$ref": "#/$defs/non_empty_string"},
    "catalog_type": {"const": "metric_package"},
    "package_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "type": {"enum": ["core", "atomic", "composite", "interaction"]},
    "category": {"enum": ["core", "settlement", "board", "evolution", "feature", "trigger", "modifier", "award", "state", "interaction"]},
    "version": {"$ref": "#/$defs/non_empty_string"},
    "applies_when": {"$ref": "#/$defs/profile_condition"},
    "metrics": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/metric"}}
  },
  "$defs": {
    "non_empty_string": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "string_list": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/non_empty_string"}
    },
    "attribute_condition": {
      "type": "object",
      "required": ["mechanic_id", "attribute", "operator"],
      "properties": {
        "mechanic_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "attribute": {"$ref": "#/$defs/non_empty_string"},
        "operator": {"enum": ["exists", "not_exists", "equals", "not_equals", "in", "not_in", "contains", "gt", "gte", "lt", "lte", "truthy", "falsy"]},
        "value": {}
      }
    },
    "profile_condition": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "always": {"const": true},
        "mechanic_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "mechanic_id_any": {"$ref": "#/$defs/string_list"},
        "mechanic_id_all": {"$ref": "#/$defs/string_list"},
        "required_attributes": {"$ref": "#/$defs/string_list"},
        "attribute_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attribute_condition"}}
      },
      "anyOf": [
        {"required": ["always"]},
        {"required": ["mechanic_id"]},
        {"required": ["mechanic_id_any"]},
        {"required": ["mechanic_id_all"]},
        {"required": ["attribute_conditions"]}
      ],
      "allOf": [
        {
          "not": {
            "anyOf": [
              {"required": ["mechanic_id", "mechanic_id_any"]},
              {"required": ["mechanic_id", "mechanic_id_all"]},
              {"required": ["mechanic_id_any", "mechanic_id_all"]}
            ]
          }
        }
      ]
    },
    "display": {
      "type": "object",
      "required": ["description_zh", "usage_scene_zh", "target_meaning_zh", "display_unit"],
      "properties": {
        "description_zh": {"$ref": "#/$defs/non_empty_string"},
        "usage_scene_zh": {"$ref": "#/$defs/non_empty_string"},
        "target_meaning_zh": {"$ref": "#/$defs/non_empty_string"},
        "display_unit": {"$ref": "#/$defs/non_empty_string"},
        "source_zh": {"$ref": "#/$defs/non_empty_string"},
        "item_labels": {"$ref": "#/$defs/string_list"},
        "object_labels": {"type": "object"},
        "object_units": {"type": "object"}
      }
    },
    "relationships": {
      "type": "object",
      "minProperties": 1,
      "required": ["derived_from", "cross_checks_with", "overlap_reason_zh"],
      "properties": {
        "derived_from": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}},
        "conditional_derivation_sources": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}},
        "marginal_of": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}},
        "conditional_on_metric": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}},
        "cross_checks_with": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}},
        "fallback_for": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}},
        "exclusive_with": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9._-]+$"}},
        "overlap_reason_zh": {"$ref": "#/$defs/non_empty_string"}
      }
    },
    "conditional_derivation_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_metric_id", "profile_binding_attribute", "required_binding_fields", "required_primary_owner_metric_id"],
      "properties": {
        "source_metric_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "profile_binding_attribute": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "required_binding_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
        },
        "required_primary_owner_metric_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"}
      }
    },
    "anchor": {
      "oneOf": [
        {"type": "array", "prefixItems": [{"type": "number"}, {"type": "number"}], "minItems": 2, "maxItems": 2},
        {"type": "object", "required": ["distance", "score"], "properties": {"distance": {"type": "number"}, "score": {"type": "number", "minimum": 0, "maximum": 100}}}
      ]
    },
    "score_profile": {
      "type": "object",
      "required": ["method", "anchors"],
      "properties": {
        "method": {"enum": ["absolute_error", "relative_error", "range_error", "total_variation", "mean_absolute_error", "max_absolute_error", "grouped_mean_absolute_error", "grouped_total_variation", "wasserstein_1d", "grouped_wasserstein_1d"]},
        "anchors": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/anchor"}},
        "zero_floor": {"type": "number", "exclusiveMinimum": 0},
        "group_separator": {"$ref": "#/$defs/non_empty_string"},
        "bin_positions_source": {"const": "task_contract"},
        "axis_semantics_source": {"$ref": "#/$defs/non_empty_string"},
        "axis_semantics": {"enum": ["natural_linear", "nonnegative_multiplicative"]},
        "ordered_distance_policy_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "position_transform": {"enum": ["identity", "log10_1p"]},
        "distance_normalization": {"enum": ["sealed_support_span", "fixed_transform_unit"]},
        "distance_scale": {"const": 1.0},
        "distance_scale_source": {"const": "sealed_support_span"},
        "distance_unit": {"enum": ["normalized_linear_support", "log10_decade"]},
        "group_weight_source": {"const": "task_contract"},
        "normalization_tolerance": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "support": {"type": "array", "minItems": 1, "items": {"type": "number"}}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"enum": ["wasserstein_1d", "grouped_wasserstein_1d"]}}, "required": ["method"]},
          "then": {
            "required": ["bin_positions_source"],
            "oneOf": [
              {
                "required": ["axis_semantics_source"],
                "not": {
                  "anyOf": [
                    {"required": ["axis_semantics"]},
                    {"required": ["ordered_distance_policy_id"]},
                    {"required": ["position_transform"]},
                    {"required": ["distance_normalization"]},
                    {"required": ["distance_scale"]},
                    {"required": ["distance_scale_source"]},
                    {"required": ["distance_unit"]}
                  ]
                }
              },
              {
                "required": ["distance_normalization"],
                "not": {"required": ["axis_semantics_source"]}
              }
            ]
          }
        },
        {
          "if": {"properties": {"method": {"enum": ["grouped_mean_absolute_error", "grouped_total_variation", "grouped_wasserstein_1d"]}}, "required": ["method"]},
          "then": {
            "required": ["group_separator", "group_weight_source", "normalization_tolerance"],
            "not": {"required": ["group_weights"]}
          }
        },
        {
          "if": {"properties": {"distance_normalization": {"const": "fixed_transform_unit"}}, "required": ["distance_normalization"]},
          "then": {
            "required": ["position_transform", "distance_scale", "distance_unit"],
            "properties": {
              "position_transform": {"const": "log10_1p"},
              "distance_scale": {"const": 1.0},
              "distance_unit": {"const": "log10_decade"}
            },
            "not": {"required": ["distance_scale_source"]}
          }
        },
        {
          "if": {"properties": {"position_transform": {"const": "log10_1p"}}, "required": ["position_transform"]},
          "then": {
            "required": ["distance_scale"],
            "properties": {
              "distance_normalization": {"const": "fixed_transform_unit"},
              "distance_scale": {"const": 1.0}
            }
          }
        },
        {
          "if": {"properties": {"distance_normalization": {"const": "sealed_support_span"}}, "required": ["distance_normalization"]},
          "then": {
            "properties": {
              "position_transform": {"const": "identity"},
              "distance_scale_source": {"const": "sealed_support_span"},
              "distance_unit": {"const": "normalized_linear_support"}
            },
            "not": {"required": ["distance_scale"]}
          }
        }
      ]
    },
    "hard_gate_profile": {
      "type": "object",
      "minProperties": 1,
      "required": ["method", "tolerance_source", "confidence_required"],
      "properties": {
        "method": {"enum": ["absolute_error", "relative_error", "range_error", "total_variation", "mean_absolute_error", "max_absolute_error", "grouped_mean_absolute_error", "grouped_total_variation", "wasserstein_1d", "grouped_wasserstein_1d"]},
        "tolerance_source": {"$ref": "#/$defs/non_empty_string"},
        "confidence_required": {"type": "boolean"},
        "zero_floor": {"type": "number", "exclusiveMinimum": 0},
        "group_separator": {"$ref": "#/$defs/non_empty_string"},
        "bin_positions_source": {"const": "task_contract"},
        "axis_semantics_source": {"$ref": "#/$defs/non_empty_string"},
        "axis_semantics": {"enum": ["natural_linear", "nonnegative_multiplicative"]},
        "ordered_distance_policy_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "position_transform": {"enum": ["identity", "log10_1p"]},
        "distance_normalization": {"enum": ["sealed_support_span", "fixed_transform_unit"]},
        "distance_scale": {"const": 1.0},
        "distance_scale_source": {"const": "sealed_support_span"},
        "distance_unit": {"enum": ["normalized_linear_support", "log10_decade"]},
        "group_weight_source": {"const": "task_contract"},
        "normalization_tolerance": {"type": "number", "minimum": 0, "exclusiveMaximum": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"enum": ["wasserstein_1d", "grouped_wasserstein_1d"]}}, "required": ["method"]},
          "then": {
            "required": ["bin_positions_source"],
            "oneOf": [
              {
                "required": ["axis_semantics_source"],
                "not": {
                  "anyOf": [
                    {"required": ["axis_semantics"]},
                    {"required": ["ordered_distance_policy_id"]},
                    {"required": ["position_transform"]},
                    {"required": ["distance_normalization"]},
                    {"required": ["distance_scale"]},
                    {"required": ["distance_scale_source"]},
                    {"required": ["distance_unit"]}
                  ]
                }
              },
              {
                "required": ["distance_normalization"],
                "not": {"required": ["axis_semantics_source"]}
              }
            ]
          }
        },
        {
          "if": {"properties": {"method": {"enum": ["grouped_mean_absolute_error", "grouped_total_variation", "grouped_wasserstein_1d"]}}, "required": ["method"]},
          "then": {
            "required": ["group_separator", "group_weight_source", "normalization_tolerance"],
            "not": {"required": ["group_weights"]}
          }
        },
        {
          "if": {"properties": {"distance_normalization": {"const": "fixed_transform_unit"}}, "required": ["distance_normalization"]},
          "then": {
            "required": ["position_transform", "distance_scale", "distance_unit"],
            "properties": {
              "position_transform": {"const": "log10_1p"},
              "distance_scale": {"const": 1.0},
              "distance_unit": {"const": "log10_decade"}
            },
            "not": {"required": ["distance_scale_source"]}
          }
        },
        {
          "if": {"properties": {"position_transform": {"const": "log10_1p"}}, "required": ["position_transform"]},
          "then": {
            "required": ["distance_scale"],
            "properties": {
              "distance_normalization": {"const": "fixed_transform_unit"},
              "distance_scale": {"const": 1.0}
            }
          }
        },
        {
          "if": {"properties": {"distance_normalization": {"const": "sealed_support_span"}}, "required": ["distance_normalization"]},
          "then": {
            "properties": {
              "position_transform": {"const": "identity"},
              "distance_scale_source": {"const": "sealed_support_span"},
              "distance_unit": {"const": "normalized_linear_support"}
            },
            "not": {"required": ["distance_scale"]}
          }
        }
      ]
    },
    "audit_profile": {
      "type": "object",
      "minProperties": 1,
      "required": ["method", "blocking_on_missing"],
      "properties": {
        "method": {"$ref": "#/$defs/non_empty_string"},
        "blocking_on_missing": {"type": "boolean"},
        "blocking_on_mismatch": {"type": "boolean"},
        "required_result_status": {"$ref": "#/$defs/non_empty_string"},
        "exact_match_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/non_empty_string"}
        },
        "insufficient_sample_status": {"$ref": "#/$defs/non_empty_string"},
        "insufficient_sample_blocks_formal": {"type": "boolean"}
      },
      "allOf": [
        {
          "if": {"properties": {"blocking_on_mismatch": {"const": true}}, "required": ["blocking_on_mismatch"]},
          "then": {"required": ["required_result_status"]}
        },
        {
          "if": {
            "anyOf": [
              {"required": ["insufficient_sample_status"]},
              {"required": ["insufficient_sample_blocks_formal"]}
            ]
          },
          "then": {"required": ["insufficient_sample_status", "insufficient_sample_blocks_formal"]}
        }
      ]
    },
    "metric": {
      "type": "object",
      "required": ["metric_id", "name_zh", "owner", "category", "display_order", "kind", "unit", "scope_template", "measurement", "sample_unit", "condition_on", "normalization", "applicability_rule", "missing_policy", "capability_ids", "profile_match", "semantic_variable_id", "semantic_group", "semantic_role", "relationships", "display"],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "name_zh": {"$ref": "#/$defs/non_empty_string"},
        "owner": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "category": {"enum": ["core", "settlement", "board", "evolution", "feature", "trigger", "modifier", "award", "state", "interaction"]},
        "display_order": {"type": "integer", "minimum": 0},
        "kind": {"enum": ["hard", "score", "audit"]},
        "unit": {"$ref": "#/$defs/non_empty_string"},
        "scope_template": {"$ref": "#/$defs/non_empty_string"},
        "measurement": {"$ref": "#/$defs/non_empty_string"},
        "sample_unit": {"$ref": "#/$defs/non_empty_string"},
        "condition_on": {"oneOf": [{"$ref": "#/$defs/non_empty_string"}, {"$ref": "#/$defs/string_list"}]},
        "normalization": {"oneOf": [{"$ref": "#/$defs/non_empty_string"}, {"type": "object", "minProperties": 1}]},
        "applicability_rule": {"$ref": "#/$defs/non_empty_string"},
        "missing_policy": {"$ref": "#/$defs/non_empty_string"},
        "inapplicability_reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["degenerate_reachable_support", "deterministically_derived_from_primary", "semantic_owner_exclusive", "feature_buy_unavailable", "deterministic_rule_result", "below_materiality_resolution"]}
        },
        "capability_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9.-]+$"}},
        "profile_match": {"$ref": "#/$defs/profile_condition"},
        "semantic_variable_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "semantic_group": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "semantic_role": {"enum": ["primary", "guard_cross_check", "derived_diagnostic", "audit"]},
        "relationships": {"$ref": "#/$defs/relationships"},
        "conditional_derivation_requirements": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/conditional_derivation_requirement"}
        },
        "display": {"$ref": "#/$defs/display"},
        "score_group": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "score_budget_key": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
        "scope_aggregation": {"$ref": "#/$defs/non_empty_string"},
        "default_weight": {"type": "number", "exclusiveMinimum": 0},
        "score_profile": {"$ref": "#/$defs/score_profile"},
        "hard_gate_profile": {"$ref": "#/$defs/hard_gate_profile"},
        "score_weight": {"type": "number"},
        "audit_profile": {"$ref": "#/$defs/audit_profile"}
      },
      "allOf": [
        {"if": {"properties": {"kind": {"const": "score"}}}, "then": {"required": ["score_group", "score_budget_key", "scope_aggregation", "default_weight", "score_profile"]}},
        {"if": {"properties": {"kind": {"const": "hard"}}}, "then": {"required": ["hard_gate_profile"]}},
        {"if": {"properties": {"kind": {"const": "audit"}}}, "then": {"required": ["score_weight", "audit_profile"], "properties": {"score_weight": {"const": 0}}}}
      ]
    }
  }
}
