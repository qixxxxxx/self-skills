{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuous Alignment Execution Policy v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "version",
    "source_path",
    "retry_limit",
    "formal_candidate_limit_enabled",
    "auto_regenerate_reports",
    "auto_rebuild_invalid_samples",
    "auto_repair_script_equivalence_failures",
    "request_user_recertification_for_derived_script",
    "derived_script_boundary_failure_action",
    "auto_expand_formal_samples_until_qualified_or_structural_unattainability",
    "auto_expand_calibration_budget_until_pass_or_structural_unattainability",
    "auto_expand_formal_budget_until_pass_or_structural_unattainability",
    "budget_exhaustion_stops_execution",
    "candidate_exhaustion_stops_execution",
    "budget_extension_requires_user_approval",
    "auto_return_to_calibration_after_formal_failure",
    "auto_continue_after_candidate_failure",
    "auto_fix_task_runtime_metadata",
    "auto_waive_insufficient_data",
    "auto_waive_structurally_unattainable",
    "auto_waive_forbidden_boundary_unattainability",
    "request_user_for_forbidden_boundary_change",
    "finish_with_blocked_or_waived_report",
    "interrupt_user_during_execution",
    "business_decision_windows",
    "preflight_metric_extension_decision_required",
    "preflight_sample_count_confirmation_required",
    "full_recount_when_user_requested",
    "auto_adopt_valid_full_recount_result",
    "post_recount_user_confirmation_required",
    "preflight_python_script_identity_confirmation_required"
  ],
  "properties": {
    "schema_version": {"const": "slot-alignment.continuous-execution-policy.v2"},
    "policy_id": {"const": "continuous-alignment-execution-v2"},
    "version": {"const": "2.0.0"},
    "source_path": {"const": "assets/policies/continuous_execution_policy.v2.json"},
    "retry_limit": {"const": 2},
    "formal_candidate_limit_enabled": {"const": false},
    "auto_regenerate_reports": {"const": true},
    "auto_rebuild_invalid_samples": {"const": true},
    "auto_repair_script_equivalence_failures": {"const": true},
    "request_user_recertification_for_derived_script": {"const": false},
    "derived_script_boundary_failure_action": {"const": "restore_certified_script_and_auto_waive_affected_metrics"},
    "auto_expand_formal_samples_until_qualified_or_structural_unattainability": {"const": true},
    "auto_expand_calibration_budget_until_pass_or_structural_unattainability": {"const": true},
    "auto_expand_formal_budget_until_pass_or_structural_unattainability": {"const": true},
    "budget_exhaustion_stops_execution": {"const": false},
    "candidate_exhaustion_stops_execution": {"const": false},
    "budget_extension_requires_user_approval": {"const": false},
    "auto_return_to_calibration_after_formal_failure": {"const": true},
    "auto_continue_after_candidate_failure": {"const": true},
    "auto_fix_task_runtime_metadata": {"const": true},
    "auto_waive_insufficient_data": {"const": true},
    "auto_waive_structurally_unattainable": {"const": true},
    "auto_waive_forbidden_boundary_unattainability": {"const": true},
    "request_user_for_forbidden_boundary_change": {"const": false},
    "finish_with_blocked_or_waived_report": {"const": true},
    "interrupt_user_during_execution": {"const": false},
    "business_decision_windows": {"const": ["preflight", "final_report"]},
    "preflight_metric_extension_decision_required": {"const": true},
    "preflight_sample_count_confirmation_required": {"const": true},
    "full_recount_when_user_requested": {"const": true},
    "auto_adopt_valid_full_recount_result": {"const": true},
    "post_recount_user_confirmation_required": {"const": false},
    "preflight_python_script_identity_confirmation_required": {"const": true}
  }
}
