{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v7 Delivery Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_contract_version",
    "task_id",
    "runtime_version",
    "rtp_group",
    "metric_contract_sha256",
    "alignment_manifest_sha256",
    "formal_result_sha256",
    "certified_script_sha256",
    "source_runtime_bundle_sha256",
    "delivery_runtime_bundle_sha256",
    "runtime_files",
    "checks",
    "generated_at"
  ],
  "properties": {
    "schema_version": {"const": "slot-alignment.delivery-manifest.v7"},
    "report_contract_version": {"const": "slot-alignment.report.v7"},
    "task_id": {"type": "string", "minLength": 1},
    "runtime_version": {"type": "string", "minLength": 1},
    "rtp_group": {"const": 1},
    "metric_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "alignment_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "formal_result_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "certified_script_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_runtime_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "delivery_runtime_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runtime_files": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source_sha256", "delivery_sha256"],
        "properties": {
          "name": {"enum": ["game_core.json", "payout_config.json", "reel_config.json", "symbol_catalog.json"]},
          "source_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "delivery_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["same_certified_script", "same_metric_contract", "formal_independent_seed", "runtime_files_match", "runtime_version_matches_task_id", "rtp_group_is_one"],
      "properties": {
        "same_certified_script": {"const": true},
        "same_metric_contract": {"const": true},
        "formal_independent_seed": {"const": true},
        "runtime_files_match": {"const": true},
        "runtime_version_matches_task_id": {"const": true},
        "rtp_group_is_one": {"const": true}
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  }
}
