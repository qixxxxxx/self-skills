{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Input Manifest v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "game_code", "game_name_zh", "mode", "runtime_environment", "rtp_group", "status", "directories", "runtime_candidates", "original_sources", "placeholders", "created_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.input-manifest.v6"},
    "task_id": {"type": "string", "pattern": "^aln-[a-z0-9-]+-[0-9]{8}-[0-9]{3}$"},
    "game_code": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
    "game_name_zh": {"type": "string", "minLength": 1},
    "mode": {"type": "string", "minLength": 1},
    "runtime_environment": {"enum": ["test", "prod"]},
    "rtp_group": {"const": 1},
    "status": {"enum": ["READY", "PENDING_USER_INPUT", "PENDING_EVIDENCE", "INVALID_INPUT"]},
    "directories": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config-test", "config-prod", "slot-docs", "slot-math-workbench", "pragmatic-workbench", "server-dev", "server-prod"],
      "properties": {
        "config-test": {"$ref": "#/$defs/directory"},
        "config-prod": {"$ref": "#/$defs/directory"},
        "slot-docs": {"$ref": "#/$defs/directory"},
        "slot-math-workbench": {"$ref": "#/$defs/directory"},
        "pragmatic-workbench": {"$ref": "#/$defs/directory"},
        "server-dev": {"$ref": "#/$defs/directory"},
        "server-prod": {"$ref": "#/$defs/directory"}
      }
    },
    "runtime_candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/runtime_bundle"}},
    "selected_baseline": {"$ref": "#/$defs/selected_baseline"},
    "original_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "certified_script": {"$ref": "#/$defs/hash_file"},
    "target_rtp": {"$ref": "#/$defs/target_rtp"},
    "placeholders": {"type": "array", "items": {"$ref": "#/$defs/placeholder"}},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "READY"}}},
      "then": {"required": ["selected_baseline", "certified_script", "target_rtp"], "properties": {"placeholders": {"maxItems": 0}}}
    }
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "directory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "purpose"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "branch": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1}
      }
    },
    "runtime_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "source_path", "resolved_path", "sha256"],
      "properties": {
        "name": {"enum": ["game_core.json", "payout_config.json", "reel_config.json", "symbol_catalog.json"]},
        "source_path": {"type": "string", "minLength": 1},
        "resolved_path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "directory_id", "source_path", "bundle_sha256", "files"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "directory_id": {"enum": ["config-test", "config-prod", "server-dev", "server-prod", "slot-docs", "slot-math-workbench"]},
        "source_path": {"type": "string", "minLength": 1},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/runtime_file"}}
      }
    },
    "selected_baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "directory_id", "source_path", "bundle_sha256", "files", "sealed_path"],
      "properties": {
        "candidate_id": {"type": "string", "minLength": 1},
        "directory_id": {"enum": ["config-test", "config-prod", "server-dev", "server-prod", "slot-docs", "slot-math-workbench"]},
        "source_path": {"type": "string", "minLength": 1},
        "bundle_sha256": {"$ref": "#/$defs/sha256"},
        "files": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/runtime_file"}},
        "sealed_path": {"const": "work/baseline/runtime"}
      }
    },
    "hash_file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "type", "path", "sha256", "coverage_zh"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "type": {"enum": ["capture", "rules", "paytable", "runtime", "script", "user_confirmation", "other"]},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "coverage_zh": {"type": "string", "minLength": 1}
      }
    },
    "target_rtp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "confirmation_type", "confirmation_evidence_sha256"],
      "properties": {
        "value": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "confirmation_type": {"enum": ["provided_by_user", "confirmed_by_user"]},
        "confirmation_evidence_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "placeholder": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "status", "reason_zh", "owner", "blocks"],
      "properties": {
        "field": {"type": "string", "minLength": 1},
        "status": {"enum": ["PENDING_USER_INPUT", "PENDING_EVIDENCE"]},
        "reason_zh": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "blocks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
