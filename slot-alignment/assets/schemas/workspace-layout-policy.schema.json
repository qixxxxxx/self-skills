{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v7 Workspace Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "status", "authority", "authorized_at", "task_root", "runtime_files", "authoritative_artifacts", "work_records", "report_path", "baseline_runtime_path", "selected_runtime_path", "delivery_runtime_path"],
  "properties": {
    "schema_version": {"const": "slot-alignment.workspace-layout-policy.v7"},
    "policy_id": {"const": "slot-alignment-light-workspace-v7"},
    "version": {"const": "7.0.0"},
    "status": {"const": "已授权"},
    "authority": {"const": "用户"},
    "authorized_at": {"type": "string", "format": "date"},
    "task_root": {"type": "string", "minLength": 1},
    "runtime_files": {"const": ["game_core.json", "payout_config.json", "reel_config.json", "symbol_catalog.json"]},
    "authoritative_artifacts": {"type": "array", "minItems": 6, "maxItems": 6},
    "work_records": {"type": "array"},
    "report_path": {"const": "交付物/报告文档/对齐报告.md"},
    "baseline_runtime_path": {"const": "work/baseline/runtime"},
    "selected_runtime_path": {"const": "work/selected/runtime"},
    "delivery_runtime_path": {"const": "交付物/runtime"}
  }
}
