{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment Aligned Parameters v6",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "candidate_id", "freeze_manifest_sha256", "parameter_record", "runtime_bundle_sha256", "parameters", "generated_at"],
  "properties": {
    "schema_version": {"const": "slot-alignment.aligned-parameters.v6"},
    "task_id": {"type": "string", "minLength": 1},
    "candidate_id": {"type": "string", "minLength": 1},
    "freeze_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "parameter_record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^work/candidate-freeze/[^/]+/parameter_record\\.json$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "runtime_bundle_sha256": {"$ref": "#/$defs/sha256"},
    "parameters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["parameter_id", "runtime_path", "value"],
        "properties": {
          "parameter_id": {"type": "string", "minLength": 1},
          "runtime_path": {"type": "string", "minLength": 1},
          "value": {}
        }
      }
    },
    "generated_at": {"type": "string", "format": "date-time"}
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
