{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Continuous Alignment Execution Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "source_path", "retry_limit", "formal_candidate_limit", "auto_regenerate_reports", "auto_rebuild_invalid_samples", "auto_expand_formal_samples_within_sealed_budget", "auto_return_to_calibration_after_formal_failure", "auto_continue_after_candidate_failure", "auto_fix_task_runtime_metadata", "auto_waive_insufficient_data", "auto_waive_structurally_unattainable", "finish_with_blocked_or_waived_report", "interrupt_user_during_execution", "business_decision_windows", "preflight_metric_extension_decision_required", "preflight_sample_count_confirmation_required", "full_recount_when_user_requested", "preflight_python_script_identity_confirmation_required"],
  "properties": {
    "schema_version": {"const": "slot-alignment.continuous-execution-policy.v1"},
    "policy_id": {"const": "continuous-alignment-execution-v1"},
    "version": {"const": "1.0.0"},
    "source_path": {"const": "assets/policies/continuous_execution_policy.v1.json"},
    "retry_limit": {"const": 2},
    "formal_candidate_limit": {"const": 3},
    "auto_regenerate_reports": {"const": true},
    "auto_rebuild_invalid_samples": {"const": true},
    "auto_expand_formal_samples_within_sealed_budget": {"const": true},
    "auto_return_to_calibration_after_formal_failure": {"const": true},
    "auto_continue_after_candidate_failure": {"const": true},
    "auto_fix_task_runtime_metadata": {"const": true},
    "auto_waive_insufficient_data": {"const": true},
    "auto_waive_structurally_unattainable": {"const": true},
    "finish_with_blocked_or_waived_report": {"const": true},
    "interrupt_user_during_execution": {"const": false},
    "business_decision_windows": {"const": ["preflight", "final_report"]},
    "preflight_metric_extension_decision_required": {"const": true},
    "preflight_sample_count_confirmation_required": {"const": true},
    "full_recount_when_user_requested": {"const": true},
    "preflight_python_script_identity_confirmation_required": {"const": true}
  }
}
