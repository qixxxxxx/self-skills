{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Slot Alignment v6 Hard Gate Budget Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "version", "status", "authority", "authorized_at", "source_path", "applies_to", "c_budget_rules", "locked_metrics", "audit_only_metrics", "calculation"],
  "properties": {
    "schema_version": {"const": "slot-alignment.hard-gate-budget-policy.v6"},
    "policy_id": {"const": "player-experience-hard-gate-budgets-v6"},
    "version": {"const": "6.0.0"},
    "status": {"const": "已授权"},
    "authority": {"const": "用户"},
    "authorized_at": {"type": "string", "format": "date"},
    "source_path": {"const": "assets/policies/hard_gate_budget_policy.json"},
    "applies_to": {"type": "string", "minLength": 1},
    "c_budget_rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["N1", "N2", "N3", "N4", "N5", "N6"],
      "properties": {
        "N1": {"const": {"method": "fixed_absolute", "value": 0.003}},
        "N2": {"const": {"method": "target_relative_clamped", "relative": 0.06, "minimum": 0.008, "maximum": 0.02}},
        "N3": {"const": {"method": "target_relative_by_rarity", "rare_target_below": 0.0005, "regular_relative": 0.12, "rare_relative": 0.2}},
        "N4": {"const": {"method": "target_relative_clamped", "relative": 0.08, "minimum": 0.005, "maximum": 0.015}},
        "N5": {"const": {"method": "scope_relative", "overall": 0.08, "non_feature": 0.08, "feature": 0.12, "feature_scope_source": "profile.metric_bindings.features[].feature_id"}},
        "N6": {"const": {"method": "target_relative_clamped", "relative": 0.08, "minimum": 0.003, "maximum": 0.015}}
      }
    },
    "locked_metrics": {"const": ["N1"]},
    "audit_only_metrics": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_role", "formula", "candidate_result_may_change_budget", "original_self_comparison_may_expand_budget", "insufficient_precision_action", "N1_target", "N1_distance", "N1_interval_forbidden", "target_mutation_forbidden", "N4_boundary", "N4_feature_buy_cost"],
      "properties": {
        "policy_role": {"const": "calculate_and_freeze_N_c_budget_before_candidate_only"},
        "formula": {"const": "c_budget = frozen_player_perception_C_budget"},
        "candidate_result_may_change_budget": {"const": false},
        "original_self_comparison_may_expand_budget": {"const": false},
        "insufficient_precision_action": {"const": "increase_sample_or_mark_U"},
        "N1_target": {"const": "single user-confirmed RTP scalar in (0,1]"},
        "N1_distance": {"const": "abs(candidate-target)"},
        "N1_interval_forbidden": {"const": true},
        "target_mutation_forbidden": {"const": true},
        "N4_boundary": {"const": "return >= actual_entry_cost"},
        "N4_feature_buy_cost": {"const": "actual_purchase_cost"}
      }
    }
  }
}
