{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formal Result",
  "type": "object",
  "required": ["schema_version", "task_id", "candidate_id", "plan_id", "status", "execution_valid", "independent_from_calibration", "sample", "scorecard", "audits", "attempt"],
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.1"}}},
      "then": {"required": ["execution_path", "stage1_server_flow_certification_sha256", "server_flow_call_count"]}
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.2"}}},
      "then": {
        "required": ["execution_path", "stage1_server_flow_certification_sha256", "server_flow_call_count"],
        "properties": {
          "sample": {"required": ["paid_entry_count", "seed_set_hash", "metric_sample_counts"]},
          "scorecard": {"required": ["sample_capability_policy"]}
        }
      }
    },
    {
      "if": {"properties": {"schema_version": {"const": "1.3"}}},
      "then": {
        "required": ["execution_path", "user_script_certification_sha256"],
        "properties": {
          "sample": {"required": ["paid_entry_count", "seed_set_hash", "metric_sample_counts"]},
          "scorecard": {"required": ["sample_capability_policy"]}
        }
      }
    }
  ],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1", "1.2", "1.3"]},
    "execution_valid": {"type": "boolean"},
    "independent_from_calibration": {"type": "boolean"},
    "execution_path": {"const": "python"},
    "stage1_server_flow_certification_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "server_flow_call_count": {"const": 0},
    "user_script_certification_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "execution_script_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "script_equivalence_evidence_sha256": {"type": "string", "minLength": 64, "maxLength": 64},
    "sample": {
      "type": "object",
      "properties": {
        "paid_entry_count": {"type": "integer", "minimum": 0},
        "seed_set_hash": {"type": "string"},
        "metric_sample_counts": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["metric_id", "scope", "sample_count", "group_sample_counts"],
            "properties": {
              "metric_id": {"type": "string", "pattern": "^[a-z0-9._-]+$"},
              "scope": {"type": "string", "minLength": 1},
              "sample_count": {"type": "integer", "minimum": 0},
              "group_sample_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}}
            }
          }
        }
      }
    },
    "scorecard": {
      "type": "object",
      "required": ["hard_gates", "scores", "budget_scores", "groups", "overall_score", "overall_band", "alignment_status", "blocking_reasons"],
      "properties": {
        "hard_gates": {"type": "array"},
        "scores": {"type": "array"},
        "audits": {"type": "array"},
        "budget_scores": {"type": "array"},
        "groups": {"type": "array"},
        "overall_score": {"type": ["number", "null"]},
        "overall_band": {"type": "string"},
        "alignment_status": {"enum": ["通过", "豁免后通过", "不通过", "无法判定"]},
        "blocking_reasons": {"type": "array"},
        "sample_capability_policy": {
          "type": "object",
          "required": ["policy_id", "version", "source_path", "source_sha256", "active_metric_instances_sha256", "status"],
          "properties": {
            "policy_id": {"const": "distribution-sample-capability-v1"},
            "version": {"const": "1.0.0"},
            "source_path": {"const": "assets/policies/sample_capability_policy.v1.json"},
            "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "active_metric_instances_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "status": {"enum": ["通过", "阻塞"]}
          }
        },
        "automatic_waiver_policy": {"type": "object"}
      }
    },
    "audits": {
      "type": "object",
      "required": ["long_tail", "max_win"],
      "properties": {
        "long_tail": {"type": "array"},
        "max_win": {
          "type": "object",
          "required": ["status", "observed_max", "theoretical_max", "cap", "cap_hit_count", "overflow_event_count", "overflow_rule_status"],
          "properties": {
            "status": {"type": "string", "minLength": 1},
            "observed_max": {"type": ["number", "null"], "minimum": 0},
            "theoretical_max": {"type": ["number", "null"], "minimum": 0},
            "cap": {"type": ["number", "null"], "minimum": 0},
            "cap_hit_count": {"type": "integer", "minimum": 0},
            "overflow_event_count": {"type": "integer", "minimum": 0},
            "overflow_rule_status": {"enum": ["符合", "不符合", "无法证明"]}
          }
        }
      }
    },
    "attempt": {"type": "integer", "minimum": 0}
  }
}
