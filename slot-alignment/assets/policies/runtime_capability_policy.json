{
  "schema_version": "slot-alignment.runtime-capability-policy.v7",
  "policy_id": "slot-alignment-script-runtime-capability-v7",
  "version": "7.0.0",
  "status": "已授权",
  "authority": "用户",
  "authorized_at": "2026-09-03",
  "source_path": "assets/policies/runtime_capability_policy.json",
  "implementation_sources": [
    "sealed_runtime",
    "user_certified_python_script"
  ],
  "rules": {
    "candidate_and_formal_use_same_certified_core": true,
    "optimizer_only_changes_authorized_runtime_parameters": true,
    "runtime_parameter_must_be_readable_by_certified_script": true,
    "current_nonzero_or_singleton_configuration_is_not_a_parameter_limit": true,
    "rspr_is_reel_set_profile_routing": true,
    "rspr_is_identified_by_profiles_by_rtp": true,
    "rspr_uses_complete_parameter_packages": true,
    "rspr_package_fields_are_discovered_dynamically": true,
    "rspr_package_pool_composition_is_open": true,
    "rspr_selected_package_is_atomic_for_declared_scope": true,
    "rspr_baseline_shape_is_not_a_parameter_limit": true,
    "optimizer_search_strategy_is_agent_decided": true,
    "adapter_must_not_implement_rng_board_state_feature_or_settlement": true,
    "fixed_seed_smoke_check_required": true,
    "smoke_check_reusable_when_hashes_unchanged": true,
    "service_implementation_is_out_of_scope": true,
    "unsupported_runtime_field_requires_new_user_certification": true
  },
  "required_bindings": [
    "runtime_bundle_sha256",
    "certified_script_sha256",
    "parameter_authority_sha256"
  ]
}
