{
  "schema_version": "slot-alignment.score-group-weight-policy.v1",
  "policy_id": "mainstream-slot-experience-group-weights-v1",
  "version": "1.0.0",
  "status": "默认政策",
  "authority": "Skill内置确定性等权政策；不代表用户批准差异权重",
  "created_at": "2026-08-26",
  "source_path": "assets/policies/score_group_weight_policy.v1.json",
  "applies_to": "采用本政策后新建并在候选结果出现前密封的对齐任务",
  "legacy_contracts_unchanged": true,
  "method": "normalize_active_base_weights",
  "base_weights": {
    "award": 1.0,
    "board_diversity": 1.0,
    "board_evolution": 1.0,
    "feature_experience": 1.0,
    "feature_process": 1.0,
    "interaction": 1.0,
    "modifier": 1.0,
    "settlement_diversity": 1.0,
    "state": 1.0,
    "trigger_structure": 1.0,
    "variable_grid": 1.0
  },
  "group_names_zh": {
    "award": "动态奖值",
    "board_diversity": "盘面与符号多样性",
    "board_evolution": "连续盘面演化",
    "feature_experience": "完整特色玩法体验",
    "feature_process": "特色玩法过程",
    "interaction": "跨机制依赖关系",
    "modifier": "Wild、倍率与转换修饰",
    "settlement_diversity": "中奖结算与构成",
    "state": "持久状态",
    "trigger_structure": "触发结构与自然入口",
    "variable_grid": "可变网格与容量"
  },
  "calculation": {
    "active_group_rule": "只保留至少一个适用且未获批准豁免的评分指标所在组",
    "formula": "group_weight[g] = base_weight[g] / sum(base_weight[active_group])",
    "metric_count_changes_group_budget": false,
    "scope_count_changes_group_budget": false,
    "candidate_result_changes_group_budget": false,
    "candidate_frequency_as_weight": false,
    "unknown_group_blocks": true,
    "manual_override_requires_user_approved_policy": true,
    "differential_weight_requires_user_approval_or_calibration_evidence": true
  }
}
