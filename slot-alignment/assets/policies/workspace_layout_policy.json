{
  "schema_version": "slot-alignment.workspace-layout-policy.v7",
  "policy_id": "slot-alignment-light-workspace-v7",
  "version": "7.0.0",
  "status": "已授权",
  "authority": "用户",
  "authorized_at": "2026-09-03",
  "task_root": "slot-math-workbench:<game_code>/alignments/<mode>/<task_id>/",
  "runtime_files": [
    "game_core.json",
    "payout_config.json",
    "reel_config.json",
    "symbol_catalog.json"
  ],
  "authoritative_artifacts": [
    {
      "stage": 1,
      "path": "artifacts/preflight.json",
      "schema": "assets/schemas/preflight.schema.json",
      "template": "assets/templates/artifacts/preflight.json"
    },
    {
      "stage": 2,
      "path": "artifacts/source_summary.json",
      "schema": "assets/schemas/source-summary.schema.json",
      "template": "assets/templates/artifacts/source_summary.json"
    },
    {
      "stage": 3,
      "path": "artifacts/metric_contract.json",
      "schema": "assets/schemas/metric-contract.schema.json",
      "template": "assets/templates/artifacts/metric_contract.json"
    },
    {
      "stage": 4,
      "path": "artifacts/alignment_manifest.json",
      "schema": "assets/schemas/alignment-manifest.schema.json",
      "template": "assets/templates/artifacts/alignment_manifest.json"
    },
    {
      "stage": 4,
      "path": "artifacts/formal_result.json",
      "schema": "assets/schemas/alignment-result.schema.json",
      "template": "assets/templates/artifacts/formal_result.json"
    },
    {
      "stage": 4,
      "path": "artifacts/delivery_manifest.json",
      "schema": "assets/schemas/delivery-manifest.schema.json",
      "template": "assets/templates/artifacts/delivery_manifest.json"
    }
  ],
  "work_records": [
    {
      "path": "work/candidate_ledger.jsonl",
      "required": false,
      "description": "候选参数差量与评价摘要"
    },
    {
      "path_pattern": "work/checkpoints/*.json",
      "required": false,
      "description": "长任务可选续跑记录"
    }
  ],
  "report_path": "交付物/报告文档/对齐报告.md",
  "baseline_runtime_path": "work/baseline/runtime",
  "selected_runtime_path": "work/selected/runtime",
  "delivery_runtime_path": "交付物/runtime"
}
