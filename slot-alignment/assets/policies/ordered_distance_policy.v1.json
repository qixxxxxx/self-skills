{
  "schema_version": "slot-alignment.ordered-distance-policy.v1",
  "policy_id": "mainstream-ordered-axis-distance-v1",
  "version": "1.0.0",
  "status": "默认政策",
  "source_path": "assets/policies/ordered_distance_policy.v1.json",
  "applies_to": "采用本政策后新建并在候选结果出现前密封的对齐任务",
  "legacy_contracts_unchanged": true,
  "default_axis_semantics": "natural_linear",
  "axis_profiles": {
    "natural_linear": {
      "position_transform": "identity",
      "distance_normalization": "sealed_support_span",
      "distance_scale_source": "sealed_support_span",
      "distance_unit": "normalized_linear_support"
    },
    "nonnegative_multiplicative": {
      "position_transform": "log10_1p",
      "distance_normalization": "fixed_transform_unit",
      "distance_scale": 1.0,
      "distance_unit": "log10_decade"
    }
  },
  "fixed_nonnegative_multiplicative_metrics": [
    "cascade.step_return_distribution_by_depth",
    "core.return_distribution.lt200",
    "effective_ways.capacity_distribution",
    "effective_ways.return_distribution_by_capacity",
    "feature_cycle.return_distribution_by_stage_path",
    "multiplier.effective_value_distribution",
    "settlement.step_return_distribution",
    "value_symbol.assignment_value_distribution",
    "variable_grid.return_distribution_by_capacity",
    "wild.incremental_return_given_assistance_distribution"
  ],
  "dynamic_axis_metrics": {
    "cascade.effective_capacity_distribution_by_depth": {
      "allowed_axis_semantics": ["natural_linear", "nonnegative_multiplicative"],
      "resolution_source": "evolution.cascade.effective_capacity_axis_semantics"
    },
    "collect.output_value_given_input_count_distribution": {
      "allowed_axis_semantics": ["natural_linear", "nonnegative_multiplicative"],
      "resolution_source": "modifier.collect.output_axis_semantics_by_output"
    },
    "persistent_state.ordered_transition_distribution": {
      "allowed_axis_semantics": ["natural_linear", "nonnegative_multiplicative"],
      "resolution_source": "state.persistent-state.ordered_axis_semantics"
    },
    "persistent_state.ordered_value_distribution": {
      "allowed_axis_semantics": ["natural_linear", "nonnegative_multiplicative"],
      "resolution_source": "state.persistent-state.ordered_axis_semantics"
    },
    "settlement.scale_given_symbol_distribution": {
      "allowed_axis_semantics": ["natural_linear", "nonnegative_multiplicative"],
      "resolution_source": "settlement mechanic winning_scale_axis_semantics"
    }
  },
  "rules": {
    "raw_positions_must_be_finite": true,
    "log_positions_must_be_nonnegative": true,
    "economic_values_must_be_normalized_to_denominator_multiple": true,
    "candidate_may_not_choose_transform_or_scale": true,
    "candidate_may_not_add_support_bins": true,
    "mixed_axis_semantics_in_one_instance_blocks": true
  }
}
