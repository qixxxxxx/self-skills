{
  "schema_version": "slot-alignment.automatic-metric-waiver-policy.v1",
  "policy_id": "automatic-metric-waiver-v1",
  "version": "1.0.0",
  "status": "用户预授权默认政策",
  "source_path": "assets/policies/automatic_metric_waiver_policy.v1.json",
  "legacy_contracts_unchanged": true,
  "authorization_source": "user_pre_authorized_skill_policy",
  "allowed_reason_codes": [
    "AUTO_WAIVED_INSUFFICIENT_DATA",
    "AUTO_WAIVED_STRUCTURALLY_UNATTAINABLE"
  ],
  "allowed_metric_kinds": ["hard", "score", "audit"],
  "rules": {
    "bind_exact_metric_instance": true,
    "retain_target_gap_and_evidence": true,
    "hard_metric_must_show_waived": true,
    "score_metric_removed_and_weights_renormalized": true,
    "ordinary_pass_forbidden_when_any_required_waiver_exists": true,
    "missing_definition_is_not_insufficient_data": true,
    "implementation_error_is_not_insufficient_data": true,
    "configuration_error_is_not_insufficient_data": true,
    "budget_exhaustion_is_not_structural_unattainability": true,
    "structural_unattainability_requires_sealed_proof": true
  }
}
