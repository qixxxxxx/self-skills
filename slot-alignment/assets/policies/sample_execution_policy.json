{
  "schema_version": "slot-alignment.sample-execution-policy.v7",
  "policy_id": "slot-alignment-light-sample-execution-v7",
  "version": "7.0.0",
  "status": "已授权",
  "authority": "用户",
  "authorized_at": "2026-09-03",
  "source_path": "assets/policies/sample_execution_policy.json",
  "sample_unit": "complete_paid_entry",
  "user_confirmation_required": true,
  "rng_protocol": {
    "candidate_default": "chunk_seeded",
    "formal_default": "chunk_seeded",
    "formal_seed_must_be_independent": true
  },
  "calibration_defaults": {
    "probe": 20000,
    "screen": 100000,
    "refine": 500000,
    "final": 2000000,
    "candidate_batch_size": 100,
    "candidate_total_limit": null,
    "continue_until_formal_pass": true,
    "formal_failure_resumes_search": true,
    "duplicate_parameter_sets_forbidden": true,
    "authorized_space_exhaustion_requires_evidence": true,
    "probe_optional": true,
    "tiers_are_cumulative": true,
    "frozen_early_stop_rules_allowed": true,
    "every_search_layer_must_run_every_tier": false
  },
  "formal_defaults": {
    "paid_entry_tiers": [
      10000000,
      20000000,
      50000000
    ],
    "minimum_conditional_sample": 2000,
    "attempt_seed_rule": "pre_frozen_sequence_by_formal_attempt",
    "same_candidate_retry_allowed": false,
    "selection_rule": "smallest_confirmed_tier_covering_all_active_conditional_instances_else_confirmed_maximum",
    "state_frequency_must_not_drive_tier": true
  },
  "execution": {
    "checkpoint_optional_for_short_runs": true,
    "checkpoint_fingerprint_required": true,
    "worker_and_micro_batch_are_not_contract_inputs": true,
    "seed_mapping_must_be_stable": true,
    "bounded_streaming_accumulators_required": true,
    "full_parallel_equivalence_report_required": false,
    "fallback_to_single_worker_on_instability": true,
    "hot_path_forbidden": [
      "per_entry_json_or_ndjson",
      "rng_object_per_random_draw",
      "per_entry_hash",
      "duplicate_settlement_calculation",
      "unbounded_exact_value_counts"
    ]
  }
}
