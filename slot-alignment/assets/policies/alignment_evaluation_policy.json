{
  "schema_version": "slot-alignment.alignment-evaluation-policy.v5",
  "policy_id": "player-visible-alignment-evaluation-v5",
  "version": "5.8.0",
  "status": "已授权",
  "authority": "用户",
  "authorized_at": "2026-09-03",
  "applies_to_metric_library": "5.5.0",
  "decision_model": {
    "score_scale_enabled": true,
    "weights_enabled": true,
    "composite_score_enabled": true,
    "metric_compensation_enabled": false,
    "formal_metric_waiver_enabled": false,
    "all_hard_gates_must_pass": true,
    "all_active_alignment_subitems_must_pass": true,
    "card_aggregation": "category_specific_hierarchy_after_all_pass",
    "conditional_group_aggregation": "worst_group"
  },
  "composite_scoring": {
    "scale": [0.0, 100.0],
    "gate_before_grade": true,
    "instance_formula": "max(0, 100 * (1 - deviation_ratio))",
    "card_aggregation": "mean_active_instance_scores",
    "category_aggregation": "mean_active_card_scores_equal_card_weight",
    "available_category_scores": ["N", "J", "P", "B"],
    "score_scope": ["N"],
    "planned_score_scope": ["N", "J", "P", "B"],
    "reserved_categories": [],
    "complete_composite_status": "NJPB_category_scores_ready_cross_category_weight_pending",
    "future_total_aggregation": "pending_user_authorization_for_NJPB_cross_category_weights",
    "score_status": "NJPB_READY_TOTAL_N_ONLY",
    "unscored_categories_must_still_pass": true,
    "grade_thresholds": {"S": 90.0, "A": 80.0, "B": 70.0, "C": 0.0}
  },
  "distance_methods": {
    "absolute_probability_error": {
      "formula": "abs(candidate-target)",
      "range": [0.0, 1.0]
    },
    "absolute_error": {
      "formula": "abs(candidate-target)",
      "range": [0.0, null]
    },
    "total_variation": {
      "formula": "0.5*sum(abs(candidate_i-target_i))",
      "requires_normalized_distribution": true,
      "range": [0.0, 1.0]
    },
    "half_l1": {
      "formula": "0.5*sum(abs(candidate_i-target_i))",
      "requires_normalized_distribution": false,
      "range": [0.0, 1.0]
    }
  },
  "j_player_budget_rules": {
    "minimum_original_sample": 500,
    "minimum_categorical_bin_count": 30,
    "instance_score_formula": "max(0, 100 * (1 - distance/C_budget))",
    "J1": {
      "base": {"relative": 0.1, "ordinary_floor": 0.008, "maximum": 0.025},
      "feature": {"relative": 0.12, "ordinary_floor": 0.008, "maximum": 0.03},
      "rare_group_floor_rule": "min(target, ordinary_floor)",
      "component_score": "mean_group_scores",
      "card_score": "mean_component_scores"
    },
    "J2": {
      "primary_structure_categorical": {
        "base_bin": {"relative": 0.2, "minimum": 0.005, "maximum": 0.02},
        "feature_bin": {"relative": 0.25, "minimum": 0.01, "maximum": 0.03},
        "base_overall": 0.03,
        "feature_overall": 0.05,
        "group_score": "overall_50_percent_plus_mean_bins_50_percent"
      },
      "primary_structure_summary": {
        "base": {"mean_relative": 0.1, "p50_relative": 0.12, "p90_relative": 0.12},
        "feature": {"mean_relative": 0.12, "p50_relative": 0.15, "p90_relative": 0.15},
        "minimum_budget": "one_frozen_natural_unit",
        "group_score": "mean_mean_p50_p90_scores"
      },
      "simultaneous_win_count": {
        "base_bin": {"relative": 0.1, "minimum": 0.002, "maximum": 0.015},
        "feature_bin": {"relative": 0.12, "minimum": 0.003, "maximum": 0.02},
        "base_overall": 0.03,
        "feature_overall": 0.04,
        "default_bins": ["1", "2", "3", "4+"],
        "group_score": "overall_50_percent_plus_mean_bins_50_percent"
      },
      "visible_step_reward": {
        "base": {"mean_relative": 0.08, "p50_relative": 0.12, "p90_relative": 0.12},
        "feature": {"mean_relative": 0.12, "p50_relative": 0.15, "p90_relative": 0.15},
        "minimum_budget": "one_frozen_minimum_visible_reward_unit",
        "group_score": "mean_mean_p50_p90_scores"
      },
      "card_score": "mean_active_dimension_scores_equal_dimension_weight"
    },
    "J3": {
      "depth_bins": ["0", "1", "2", "3", "4", "5", "6+"],
      "base_bin": {"relative": 0.1, "minimum": 0.002, "maximum": 0.015},
      "feature_bin": {"relative": 0.12, "minimum": 0.003, "maximum": 0.02},
      "base_overall": 0.03,
      "feature_overall": 0.04,
      "component_score": "overall_50_percent_plus_mean_bins_50_percent",
      "card_score": "mean_component_scores"
    },
    "category_score": "mean_active_J1_J2_J3_card_scores_equal_card_weight",
    "cross_category_weight": "pending_user_authorization"
  },
  "p_player_budget_rules": {
    "minimum_categorical_bin_count": 30,
    "instance_score_formula": "max(0, 100 * (1 - distance/C_budget))",
    "P1": {
      "minimum_original_feature_cycles": 500,
      "entry_award": {
        "bin": {"relative": 0.2, "ordinary_floor": 0.005, "maximum": 0.03},
        "rare_bin_floor_rule": "min(target, ordinary_floor)",
        "overall": 0.04,
        "feature_dimension_score": "overall_50_percent_plus_mean_bins_50_percent"
      },
      "duration": {
        "mean": {"relative": 0.12, "minimum_actions": 1.0},
        "p50": {"relative": 0.15, "minimum_actions": 1.0},
        "p90": {"relative": 0.2, "minimum_actions": 2.0},
        "feature_dimension_score": "mean_mean_p50_p90_scores"
      },
      "card_score": "mean_features_after_mean_active_dimensions_per_feature"
    },
    "P2": {
      "mechanic_families": ["multiplier_modifier", "collection_upgrade", "transform_replace", "expand_persist", "respin_special_result", "random_modifier_selection", "pick_wheel_path", "other"],
      "minimum_original_sample_by_opportunity_unit": {
        "feature_spin": 1000,
        "positive_settlement_step": 1000,
        "feature_entry": 500,
        "complete_feature": 500,
        "pick": 1000,
        "respin_step": 1000,
        "visible_action": 1000,
        "other": 1000
      },
      "result_bin": {"relative": 0.15, "ordinary_floor": 0.005, "maximum": 0.03},
      "rare_bin_floor_rule": "min(target, ordinary_floor)",
      "overall": 0.04,
      "mechanic_score": "overall_50_percent_plus_mean_bins_50_percent",
      "card_score": "mean_mechanic_scores"
    },
    "category_score": "mean_active_P1_P2_card_scores_equal_card_weight",
    "cross_category_weight": "pending_user_authorization"
  },
  "b_player_budget_rules": {
    "minimum_original_sample": 1000,
    "minimum_categorical_bin_count": 30,
    "instance_score_formula": "max(0, 100 * (1 - distance/C_budget))",
    "B1": {
      "symbol_group_composition": {
        "bin": {"relative": 0.15, "ordinary_floor": 0.01, "maximum": 0.04},
        "rare_bin_floor_rule": "min(target, ordinary_floor)",
        "overall": 0.05
      },
      "symbol_group_member_balance": {
        "bin": {"relative": 0.2, "ordinary_floor": 0.01, "maximum": 0.05},
        "rare_bin_floor_rule": "min(target, ordinary_floor)",
        "overall": 0.06
      },
      "key_symbol_count": {
        "bin": {"relative": 0.12, "ordinary_floor": 0.005, "maximum": 0.025},
        "rare_bin_floor_rule": "min(target, ordinary_floor)",
        "overall": 0.04
      },
      "aggregation": {
        "bin": {"relative": 0.15, "ordinary_floor": 0.005, "maximum": 0.03},
        "rare_bin_floor_rule": "min(target, ordinary_floor)",
        "overall": 0.04
      },
      "card_score": "mean_active_B1_dimensions_equal_dimension_weight"
    },
    "B2": {
      "reel_height": {
        "bin": {"relative": 0.15, "ordinary_floor": 0.008, "maximum": 0.04},
        "rare_bin_floor_rule": "min(target, ordinary_floor)",
        "overall": 0.05
      },
      "active_cell_count": {
        "mean": {"relative": 0.08, "minimum_cells": 1.0},
        "p50": {"relative": 0.1, "minimum_cells": 1.0},
        "p90": {"relative": 0.12, "minimum_cells": 2.0}
      },
      "unevenness": {
        "mean": {"relative": 0.15, "minimum_levels": 1.0},
        "p90": {"relative": 0.2, "minimum_levels": 1.0}
      },
      "card_score": "mean_active_B2_dimensions_equal_dimension_weight"
    },
    "category_score": "mean_active_B1_B2_card_scores_equal_card_weight",
    "cross_category_weight": "pending_user_authorization"
  },
  "tolerance": {
    "J_source": "frozen_player_visible_C_budget",
    "P_source": "frozen_player_visible_C_budget",
    "B_source": "frozen_player_visible_C_budget",
    "factor": 1.0,
    "deterministic_rule_tolerance": 0.0,
    "freeze_before_candidate": true,
    "candidate_result_may_change_tolerance": false
  },
  "formal_grading": {
    "grades": ["S", "A", "B", "C", "F", "U", "NA"],
    "pass_grades": ["S", "A", "B", "C"],
    "labels_zh": {
      "S": "高度一致",
      "A": "稳定一致",
      "B": "基本一致",
      "C": "最低通过",
      "F": "不通过",
      "U": "无法判定",
      "NA": "不适用"
    },
    "aggregation": "all_required_pass_then_scoped_composite_score",
    "hard_gate_pass_limit": 1.0,
    "deterministic_exact": {
      "pass_grade": "S",
      "fail_grade": "F"
    }
  },
  "statuses": ["通过", "不通过", "样本不足", "不适用", "计算异常"],
  "sample_insufficiency": {
    "stops_execution": false,
    "removes_metric_instance": false,
    "allows_waiver": false,
    "report_only_for_process_control": true,
    "final_status": "无法完整判定"
  },
  "final_status_precedence": [
    "无法完整判定",
    "不通过",
    "通过"
  ],
  "final_status_rules": {
    "无法完整判定": "任一正式实例为样本不足、计算异常或存在合同缺口",
    "不通过": "不存在未判定实例且任一必需正式实例未达C级最低通过线",
    "通过": "全部必需正式实例达到C级最低通过线，再按当前score_scope内阶段分评C/B/A/S"
  },
  "audit_policy": {
    "affects_formal_status": false,
    "must_be_reported": true,
    "rule_consistency_error_is_contract_error": true
  }
}
